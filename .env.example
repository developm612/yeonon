# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git에 올라가지 않는다.
# Vercel에는 Project Settings → Environment Variables에 같은 이름으로 등록한다.
# 발급 순서: yeonon-service-plan-v2.md 8장

# Supabase (Project Settings → API). 브라우저에 노출돼도 되는 값 — 데이터는 RLS가 보호한다.
# 둘 중 하나라도 비어 있으면 로그인 기능이 꺼지고 공개 페이지만 동작한다.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# 회원 기능 공개 스위치. 정확히 true일 때만 일반 방문자에게 회원 기능을 보여 준다.
# true가 아니면(비워 두면) — 실제 사이트에 배포하되 아직 숨겨 두는 단계:
#   - 헤더·모바일 메뉴의 Sign in / My page / Sign out을 숨긴다. /login 주소로 직접 들어가 로그인하는 건 된다.
#   - /routes, /routes/[id]는 로그인한 사람에게만 보이고, 비로그인 방문자는 홈으로 보낸다.
#   - /login, /routes, 회원 영역(/app·/partner·/admin 등)은 noindex (검색엔진 비노출).
#   - 홈·여행자·지기 페이지의 대기자·지기 신청 폼(Apps Script)은 그대로 동작한다.
# PUBLIC_ 값은 빌드할 때 페이지에 들어가므로, Vercel에서 값을 바꾸면 다시 배포(Redeploy)해야 반영된다.
PUBLIC_MEMBER_UI=

# AI 추천 (Phase 4) · 번역 (Phase 6) — 서버 전용. 절대 PUBLIC_ 을 붙이지 말 것.
# 서버가 실행 중에 읽으므로(astro.config.mjs env.schema) Vercel에서 바꾸면 다음 요청부터 반영된다(재배포 권장).
# 넷 다 비워도 추천은 동작한다: 태그 겹침 + 품질 점수 순서, "Matches 3 of your interests: …" 템플릿 이유.
# 가중치·후보 수·타임아웃·캐시 시간은 src/config/recommend.ts 에서 바꾼다.
#
# LLM: 상위 10개 후보를 최종 5개로 재정렬하고 영어 추천 이유를 쓴다. 6초 안에 답하지 않으면 점수 순서로 대체.
#   LLM_MODEL 이 claude- 로 시작하면 Anthropic API (console.anthropic.com 에서 키 발급)
#   예) claude-opus-5-5 (기본 권장) — 응답이 6초를 자주 넘기면 /admin/recommendations의 대체 비율을 보고
#       더 빠른 모델(예: claude-haiku-5-5)로 바꾸는 것을 검토한다.
#   다른 공급자는 src/lib/ai/llm.ts 의 PROVIDERS에 추가한다.
LLM_API_KEY=
LLM_MODEL=
# 임베딩: 루트 내용(제목·소개·태그·정류장)과 여행자 취향을 1024차원 벡터로 만들어 의미 유사도를 계산한다.
#   EMBEDDING_MODEL 이 voyage- 로 시작하면 Voyage AI (예: voyage-3.5),
#   text-embedding-3 으로 시작하면 OpenAI (예: text-embedding-3-small) — 둘 다 1024차원으로 요청한다.
#   벡터 차원(1024)은 supabase/migrations/20261110000008_route_embeddings.sql 상단 주석 참고.
#   모델을 바꾸면 /admin/recommendations에서 [임베딩 백필]을 다시 눌러야 한다 (모델이 다른 벡터는 비교하지 않는다).
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 알림 메일 (Phase 5) — 셋 다 서버 전용. 절대 PUBLIC_ 을 붙이지 말 것.
# 셋 중 하나라도 비어 있으면 메일만 건너뛰고, 사이트 알림(헤더 알림 종·/account/notifications)은 그대로 남는다.
# 서버가 실행 중에 읽으므로(astro.config.mjs env.schema) Vercel에서 바꾸면 다음 요청부터 반영된다(재배포 권장).
#
# SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API → service_role (secret).
#   RLS를 무시하는 관리자 키라서 꼭 필요한 곳에만 쓴다 — 지금은 알림 메일의 받는 사람(상대방) 이메일 조회와
#   알림에 '메일 보냄' 표시만 한다 (src/lib/mail.ts). 브라우저·PUBLIC_ 변수·로그에 절대 넣지 말 것.
SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY: resend.com → API Keys (Sending access). 보내는 도메인을 Resend에서 먼저 인증해야 한다.
RESEND_API_KEY=
# MAIL_FROM: 인증한 도메인의 보내는 주소. 예) YEONON <hello@yeonon.xyz>
MAIL_FROM=
# (아직 쓰지 않음) 운영팀 알림 받을 주소
ADMIN_NOTIFY_EMAIL=yeonon.official2026@gmail.com
