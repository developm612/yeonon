# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git에 올라가지 않는다.
# Vercel에는 Project Settings → Environment Variables에 같은 이름으로 등록한다.
# 발급 순서: yeonon-service-plan-v2.md 8장

# Supabase (Project Settings → API). 브라우저에 노출돼도 되는 값 — 데이터는 RLS가 보호한다.
# 둘 중 하나라도 비어 있으면 로그인 기능이 꺼지고 공개 페이지만 동작한다.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ↓ 서버 전용. 절대 PUBLIC_ 을 붙이지 말 것. (Phase 2 이후 사용)
SUPABASE_SERVICE_ROLE_KEY=

# AI 추천·번역 (Phase 4, 6)
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_MODEL=

# 알림 메일 (Phase 5)
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=yeonon.official2026@gmail.com
