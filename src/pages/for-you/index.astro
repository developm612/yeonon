---
/**
 * AI 추천 입력 (여행자, yeonon-traveler-ui-plan.md 5-2). 세 단계로 나눈다:
 *   ① 관심사 3~5개  ② 날짜·시간대·인원  ③ 언어·분위기·한 줄 요청 → Show my routes
 * 위쪽 진행 표시는 루트 라인 모양 (정말 순서가 있는 흐름이라 쓴다). 스크립트가 없으면 세 단계가 한 화면에 모두 보인다.
 * 관심사 칩: components/app/InterestChips.astro + scripts/chipPicker.ts (선 아이콘, 이모지 없음).
 * 제출하면 /for-you/results?… 로 가서 /api/recommend를 부른다. 입력 규칙: lib/recommend/input.ts
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Notice from '../../components/account/Notice.astro';
import InterestChips from '../../components/app/InterestChips.astro';
import UiButton from '../../components/ui/UiButton.astro';
import { DISCOVER, DISCOVER_VIBES, TIMES_OF_DAY } from '../../config/recommend';
import { INTEREST_MAX, INTEREST_MIN } from '../../data/interests';
import { ROUTE_LANGUAGES } from '../../data/routeOptions';
import { kstToday } from '../../lib/availability';
import { defaultInput, readInput, validateInput } from '../../lib/recommend/input';

export const prerender = false;

const { profile } = Astro.locals;
const q = Astro.url.searchParams;
// 결과 화면에서 "조건 바꾸기"로 돌아오면 주소의 조건을 그대로 채운다
const fromQuery = q.has('interests') || q.has('from');
const values = fromQuery ? { ...defaultInput(profile), ...stripEmpty(readInput((k) => q.get(k))) } : defaultInput(profile);
const errors = q.get('invalid') ? validateInput(values).errors : {};
const errorList = Object.values(errors);

function stripEmpty<T extends object>(o: T): Partial<T> {
  return Object.fromEntries(Object.entries(o).filter(([, v]) => (Array.isArray(v) ? v.length : v !== '' && v !== 0))) as Partial<T>;
}

const today = kstToday();
const last = kstToday(DISCOVER.maxDaysAhead);
const STEPS = ['Interests', 'When', 'Details'];
const input = 'mt-2 block h-[52px] w-full rounded-control border border-hairline bg-paper px-4 text-[1.0625rem] focus:border-on-blue focus:outline-none focus:ring-3 focus:ring-on-blue/20 aria-invalid:border-status-error';
const pill = 'flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-hairline bg-paper px-4 text-[0.9375rem] font-semibold transition-colors hover:border-ink has-checked:border-on-blue has-checked:bg-on-blue has-checked:text-white has-disabled:cursor-not-allowed has-disabled:opacity-45 has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-on-blue';
const legend = 't-title';
---
<BaseLayout title="Find my route | YEONON" description="Tell us what you love and we'll recommend routes in Seongsu." noindex>
  <div class="container-page max-w-3xl! pt-8 pb-16 md:pt-12 md:pb-24">
    <h1 class="t-display">Find my route</h1>
    <p class="t-body measure mt-2 text-stone">Tell us what you love. We'll match you with routes local friends (jigi) made in Seongsu.</p>

    <!-- 진행 표시 (스크립트가 있을 때만) -->
    <ol class="steps mt-8 hidden grid-cols-3" aria-label="Steps" data-steps>
      {STEPS.map((name, i) => (
        <li class="step relative" data-step-dot={i} data-state={i === 0 ? 'current' : 'next'}>
          {i > 0 && <span class="step-line absolute top-[9px] right-1/2 left-[-50%] h-1 rounded-full" aria-hidden="true"></span>}
          <span class="step-dot relative mx-auto block size-[22px] rounded-full border-[3.5px]" aria-hidden="true"></span>
          <span class="step-name mt-1.5 block text-center text-[0.8125rem] leading-[1.125rem] font-semibold">
            {name}<span class="sr-only" data-step-sr></span>
          </span>
        </li>
      ))}
    </ol>

    <form method="get" action="/for-you/results" class="mt-8" novalidate data-discover>
      {errorList.length > 0 && <Notice tone="error" class="mb-6">{errorList.join(' ')}</Notice>}
      <p class="hidden" role="alert" data-form-error></p>

      <!-- ① 관심사 -->
      <section class="discover-step space-y-4" data-step="0" aria-labelledby="st-0">
        <fieldset data-app data-min={INTEREST_MIN} data-max={INTEREST_MAX}>
          <legend id="st-0" class={legend}>What sounds like you?</legend>
          <p class="t-small mt-1 font-normal text-stone">Pick {INTEREST_MIN} to {INTEREST_MAX}.</p>
          <InterestChips class="mt-5" />
          <p class="t-small mt-4 text-stone">
            <span data-count>0 / {INTEREST_MAX} selected</span>
            <span class="ml-2 font-semibold text-on-blue" data-limit-msg aria-live="polite"></span>
          </p>
          <input type="hidden" name="interests" value={values.interests.join(',')} data-interests />
        </fieldset>
        <div class="step-nav hidden border-t border-hairline pt-6">
          <UiButton class="sm:w-auto w-full" data-pick-next data-go="1">Next</UiButton>
        </div>
      </section>

      <!-- ② 날짜·시간대·인원 -->
      <section class="discover-step mt-12 space-y-8" data-step="1" aria-labelledby="st-1">
        <fieldset>
          <legend id="st-1" class={legend}>When are you in Seoul?</legend>
          <p class="t-small mt-1 font-normal text-stone">Korea time (KST). You can search up to 4 weeks ahead.</p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div>
              <label for="dc-from" class="t-small font-semibold">From</label>
              <input id="dc-from" name="from" type="date" min={today} max={last} value={values.date_from} required aria-invalid={errors.date_from ? 'true' : undefined} class={input} />
            </div>
            <div>
              <label for="dc-to" class="t-small font-semibold">To</label>
              <input id="dc-to" name="to" type="date" min={today} max={last} value={values.date_to} required aria-invalid={errors.date_to ? 'true' : undefined} class={input} />
            </div>
          </div>
        </fieldset>
        <div>
          <p class="t-heading" id="dc-time-label">Time of day</p>
          <div class="mt-3 flex flex-wrap gap-2" role="radiogroup" aria-labelledby="dc-time-label">
            {TIMES_OF_DAY.map((t) => (
              <label class={pill}>
                <input type="radio" name="time" value={t.id} checked={values.time_of_day === t.id || undefined} class="sr-only" />
                {t.label}{'hint' in t && <span class="text-[0.875rem] font-normal opacity-80">{t.hint}</span>}
              </label>
            ))}
          </div>
        </div>
        <div class="max-w-[240px]">
          <label for="dc-party" class="t-heading">Group size</label>
          <select id="dc-party" name="party" class={input}>
            {Array.from({ length: DISCOVER.partyMax }, (_, i) => i + 1).map((n) => (
              <option value={n} selected={values.party_size === n || undefined}>{n === 1 ? 'Just me' : `${n} people`}</option>
            ))}
          </select>
        </div>
        <div class="step-nav hidden flex-wrap gap-3 border-t border-hairline pt-6">
          <UiButton class="w-full sm:w-auto" data-go="2">Next</UiButton>
          <UiButton variant="secondary" class="w-full sm:w-auto" data-go="0">Back</UiButton>
        </div>
      </section>

      <!-- ③ 언어·분위기·한 줄 요청 -->
      <section class="discover-step mt-12 space-y-8" data-step="2" aria-labelledby="st-2">
        <div data-max-langs={DISCOVER.languagesMax}>
          <p id="st-2" class={legend}>Which languages work for you?</p>
          <p class="t-small mt-1 font-normal text-stone">Up to {DISCOVER.languagesMax}.</p>
          <div class="mt-4 flex flex-wrap gap-2" role="group" aria-labelledby="st-2">
            {ROUTE_LANGUAGES.map((l) => (
              <label class={pill}>
                <input type="checkbox" name="lang" value={l.id} checked={values.languages.includes(l.id) || undefined} class="sr-only" />
                {l.id}
              </label>
            ))}
          </div>
          <input type="hidden" name="lang" value="" data-lang-joined disabled />
        </div>

        <fieldset>
          <legend class="t-heading">What pace do you want?</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {DISCOVER_VIBES.map((v) => (
              <label class={pill}>
                <input type="radio" name="vibe" value={v.id} checked={values.vibe === v.id || undefined} class="sr-only" />
                {v.label}
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="dc-note" class="t-heading">Anything else? <span class="t-small font-normal text-stone">(optional)</span></label>
          <textarea id="dc-note" name="note" rows="3" maxlength={DISCOVER.noteMax} placeholder="e.g. Quiet cafés and vintage shops, not too much walking"
            class="mt-3 block w-full rounded-control border border-hairline bg-paper p-4 text-[1.0625rem] focus:border-on-blue focus:outline-none focus:ring-3 focus:ring-on-blue/20" data-note>{values.note}</textarea>
          <p class="t-caption mt-1.5 flex justify-between gap-3 font-normal text-stone">
            <span>Please don't include names or contact details.</span>
            <span class="tabular-nums" data-note-count>{values.note.length} / {DISCOVER.noteMax}</span>
          </p>
        </div>

        <div class="border-t border-hairline pt-6">
          <div class="flex flex-wrap gap-3">
            <UiButton type="submit" class="w-full sm:w-auto">Show my routes</UiButton>
            <UiButton variant="secondary" class="step-nav hidden w-full sm:w-auto" data-go="1">Back</UiButton>
          </div>
          <p class="t-caption mt-3 font-normal text-stone">We use AI to rank routes and explain why they fit. We only send your preferences, never your name or contact details.</p>
        </div>
      </section>
    </form>
  </div>
</BaseLayout>

<style>
  /* 진행 표시: 지나간 단계 Ink, 지금 단계 초록, 앞으로는 Hairline (RouteLine 예약 상태형과 같은 규칙) */
  .step-line { background: var(--color-hairline); }
  .step-dot { background: var(--color-paper); border-color: var(--color-hairline); }
  .step-name { color: var(--color-stone); }
  .step[data-state='done'] .step-dot { background: var(--color-ink); border-color: var(--color-ink); }
  .step[data-state='done'] .step-name { color: var(--color-ink); }
  .step[data-state='done'] .step-line,
  .step[data-state='current'] .step-line { background: var(--color-ink); }
  .step[data-state='current'] .step-dot { background: var(--color-line2); border-color: var(--color-line2); box-shadow: 0 0 0 5px rgb(0 168 77 / 0.18); }
  .step[data-state='current'] .step-name { color: var(--color-line2-text); }

  /* 스크립트가 있으면 한 단계씩 (버튼은 UiButton 컴포넌트라 :global) */
  :global(.is-stepped .steps) { display: grid; }
  :global(.is-stepped .step-nav) { display: flex; }
  :global(.is-stepped .discover-step) { margin-top: 0; }
  :global(.is-stepped .discover-step:not(.is-current)) { display: none; }
</style>

<script>
  import { createPicker } from '../../scripts/chipPicker';

  const form = document.querySelector<HTMLFormElement>('[data-discover]')!;
  const chipsBox = form.querySelector<HTMLElement>('fieldset[data-app]')!;
  const min = Number(chipsBox.dataset.min);
  const max = Number(chipsBox.dataset.max);
  const hiddenInterests = form.querySelector<HTMLInputElement>('[data-interests]')!;
  const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
  const steps = [...form.querySelectorAll<HTMLElement>('[data-step]')];
  const dots = [...document.querySelectorAll<HTMLElement>('[data-step-dot]')];

  // 앱 미리보기와 같은 칩 선택 (최대 개수 넘기면 흔들림 + 안내)
  const picker = createPicker(form, {
    min,
    max,
    countText: (n) => (n < min ? `${n} / ${max} selected · pick at least ${min}` : `${n} / ${max} selected`),
    limitText: `You can pick up to ${max}.`,
  });
  // 이전 선택(프로필 관심사나 주소의 조건)을 눌러 둔다
  for (const id of hiddenInterests.value.split(',').filter(Boolean)) {
    form.querySelector<HTMLButtonElement>(`[data-chip="${id}"]`)?.click();
  }

  // 언어: 최대 개수가 차면 나머지를 잠근다
  const langMax = Number(form.querySelector<HTMLElement>('[data-max-langs]')!.dataset.maxLangs);
  const langs = [...form.querySelectorAll<HTMLInputElement>('input[type="checkbox"][name="lang"]')];
  const syncLangs = () => {
    const full = langs.filter((b) => b.checked).length >= langMax;
    langs.forEach((b) => (b.disabled = full && !b.checked));
  };
  langs.forEach((b) => b.addEventListener('change', syncLangs));
  syncLangs();

  // 날짜: 끝 날짜는 시작 날짜보다 앞설 수 없다
  const from = form.querySelector<HTMLInputElement>('#dc-from')!;
  const to = form.querySelector<HTMLInputElement>('#dc-to')!;
  const syncDates = () => {
    to.min = from.value || from.min;
    if (to.value && from.value && to.value < from.value) to.value = from.value;
  };
  from.addEventListener('change', syncDates);
  syncDates();

  const note = form.querySelector<HTMLTextAreaElement>('[data-note]')!;
  const noteCount = form.querySelector<HTMLElement>('[data-note-count]')!;
  note.addEventListener('input', () => (noteCount.textContent = `${note.value.length} / ${note.maxLength}`));

  const clearError = () => (errorBox.className = 'hidden');
  const fail = (message: string, focus: HTMLElement) => {
    errorBox.textContent = message;
    errorBox.className = 't-small mb-6 rounded-control bg-status-error/10 px-4 py-3 font-semibold text-status-error';
    focus.focus();
  };

  // 단계마다 확인할 것 (실패하면 안내 문구와 포커스할 칸)
  const checkStep = (i: number): [string, HTMLElement] | null => {
    if (i === 0 && picker.selected.length < min) return [`Pick at least ${min} interests.`, form.querySelector<HTMLElement>('[data-chip]')!];
    if (i === 1 && (!from.value || !to.value)) return ['Choose your dates.', from];
    if (i === 2 && !langs.some((b) => b.checked)) return ['Pick at least one language.', langs[0]];
    return null;
  };

  // ---- 한 단계씩 보여 주기
  let current = 0;
  const show = (i: number, focus = true) => {
    current = i;
    steps.forEach((s, k) => s.classList.toggle('is-current', k === i));
    dots.forEach((d, k) => {
      d.dataset.state = k < i ? 'done' : k === i ? 'current' : 'next';
      d.querySelector('[data-step-sr]')!.textContent = k < i ? ' (done)' : k === i ? ' (current step)' : '';
      if (k === i) d.setAttribute('aria-current', 'step');
      else d.removeAttribute('aria-current');
    });
    if (focus) {
      steps[i].querySelector<HTMLElement>('legend, [id^="st-"]')?.setAttribute('tabindex', '-1');
      steps[i].querySelector<HTMLElement>('legend, [id^="st-"]')?.focus({ preventScroll: true });
      document.querySelector('[data-steps]')?.scrollIntoView({ block: 'nearest' });
    }
  };
  document.querySelector('[data-steps]')!.parentElement!.classList.add('is-stepped');
  // 주소에 잘못된 조건이 있으면 문제가 있는 첫 단계부터
  const firstBad = [0, 1, 2].find((i) => checkStep(i) !== null);
  show(new URLSearchParams(location.search).get('invalid') && firstBad !== undefined ? firstBad : 0, false);

  form.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) =>
    b.addEventListener('click', () => {
      const to = Number(b.dataset.go);
      if (to > current) {
        const bad = checkStep(current);
        if (bad) return fail(...bad);
      }
      clearError();
      show(to);
    }),
  );

  form.addEventListener('submit', (e) => {
    clearError();
    for (const i of [0, 1, 2]) {
      const bad = checkStep(i);
      if (bad) {
        e.preventDefault();
        show(i, false);
        return fail(...bad);
      }
    }
    hiddenInterests.value = picker.selected.join(',');
    // 언어는 주소를 짧게 lang=English,Korean 한 칸으로 보낸다
    const joined = form.querySelector<HTMLInputElement>('[data-lang-joined]')!;
    joined.value = langs.filter((b) => b.checked).map((b) => b.value).join(',');
    joined.disabled = false;
    langs.forEach((b) => (b.disabled = true));
    if (!note.value.trim()) note.disabled = true;
    // 뒤로 가기로 돌아왔을 때 다시 쓸 수 있게
    window.addEventListener('pageshow', () => {
      langs.forEach((b) => (b.disabled = false));
      syncLangs();
      joined.disabled = true;
      note.disabled = false;
    }, { once: true });
  });
</script>
