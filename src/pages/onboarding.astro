---
/**
 * 첫 로그인 후 한 번: 역할 선택(여행자/지기) + 필수 동의 + 만 18세 확인 + 선택 동의(마케팅).
 * 저장은 DB 함수 complete_onboarding (역할은 한 번 정하면 직접 바꿀 수 없다).
 * 아직 역할을 모르므로 영어·한국어를 같이 쓴다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Notice from '../components/account/Notice.astro';
import { safeNext } from '../lib/supabase';
import { AREAS, homeFor, inArea, isOnboarded, type Role } from '../lib/profile';
import { dbError, field } from '../lib/forms';
import { clean } from '../scripts/formSafety';

export const prerender = false;

const { profile, supabase } = Astro.locals;
if (profile && isOnboarded(profile)) return Astro.redirect(homeFor(profile));

const nextParam = Astro.url.searchParams.get('next');
/** 온보딩 후 갈 곳: 원래 가려던 곳이 그 역할의 영역(또는 공개 루트 화면)이면 그곳, 아니면 역할의 첫 화면 */
const destination = (role: Role) => {
  const next = safeNext(nextParam, '');
  const area = AREAS.find((a) => next && inArea(next.split('?')[0], a.base));
  if (area?.roles.includes(role)) return next;
  if (role === 'traveler' && next && inArea(next.split('?')[0], '/routes')) return next;
  return role === 'jigi' ? '/partner/apply' : '/app';
};

let error: string | null = null;
let form = { role: '', display_name: profile?.display_name ?? '', marketing: false };

if (Astro.request.method === 'POST' && profile && supabase) {
  const fd = await Astro.request.formData();
  const role = field(fd, 'role');
  form = { role, display_name: clean(field(fd, 'display_name'), 40), marketing: field(fd, 'marketing') === 'yes' };
  const agreed = { terms: field(fd, 'terms') === 'yes', privacy: field(fd, 'privacy') === 'yes', adult: field(fd, 'adult') === 'yes' };

  if (role !== 'traveler' && role !== 'jigi') error = 'Please choose how you will use YEONON. · 이용 방법을 골라 주세요.';
  else if (!form.display_name) error = 'Please enter a display name. · 표시 이름을 입력해 주세요.';
  else if (!agreed.terms || !agreed.privacy || !agreed.adult) error = 'Please check all required items. · 필수 항목에 모두 동의해 주세요.';
  else {
    const { error: rpcError } = await supabase.rpc('complete_onboarding', {
      p_role: role,
      p_display_name: form.display_name,
      p_terms: agreed.terms,
      p_privacy: agreed.privacy,
      p_adult: agreed.adult,
      p_marketing: form.marketing,
    });
    if (!dbError(rpcError, 'complete_onboarding')) return Astro.redirect(destination(role));
    error = /already/.test(rpcError!.message) ? 'You have already completed this step. · 이미 완료했어요.' : 'Something went wrong. Please try again. · 저장하지 못했어요. 다시 시도해 주세요.';
  }
}

const box = 'flex cursor-pointer items-start gap-3 rounded-2xl border border-border bg-surface p-4 has-checked:border-brand has-checked:bg-brand-soft';
const checkbox = 'mt-1 size-[18px] shrink-0 cursor-pointer accent-brand';
---
<BaseLayout title="Welcome | YEONON" description="Set up your YEONON account. 연온 시작하기." sticky="none" noindex>
  <section class="section pt-10! md:pt-16!">
    <div class="container-page max-w-xl!">
      <p class="eyebrow">Welcome · 환영해요</p>
      <h1 class="mt-3 text-3xl font-extrabold md:text-4xl">Set up your account</h1>
      <p lang="ko" class="mt-1 text-muted">계정 설정 — 한 번만 하면 돼요.</p>

      {!profile ? (
        <Notice tone="error" class="mt-8">
          Your profile is not ready yet. Please try again in a moment.
          <span lang="ko" class="block">프로필이 아직 준비되지 않았어요. (운영자: supabase/migrations SQL을 실행했는지 확인)</span>
        </Notice>
      ) : (
        <form method="post" class="mt-8 space-y-8" novalidate>
          {error && <Notice tone="error">{error}</Notice>}

          <fieldset>
            <legend class="text-lg font-bold">How will you use YEONON? <span lang="ko" class="block text-sm font-normal text-muted">어떻게 이용하시나요? (나중에 바꿀 수 없어요)</span></legend>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <label class={box}>
                <input type="radio" name="role" value="traveler" class={checkbox} checked={form.role === 'traveler' || undefined} required />
                <span><span class="block font-semibold">I'm a traveler</span><span class="block text-sm text-muted">Find a local friend in Seongsu.</span></span>
              </label>
              <label class={box} lang="ko">
                <input type="radio" name="role" value="jigi" class={checkbox} checked={form.role === 'jigi' || undefined} />
                <span><span class="block font-semibold">지기로 활동할래요</span><span class="block text-sm text-muted">여행자에게 나의 성수를 소개해요.</span></span>
              </label>
            </div>
          </fieldset>

          <div>
            <label for="ob-name" class="text-lg font-bold">Display name <span lang="ko" class="text-sm font-normal text-muted">표시 이름</span></label>
            <p class="text-sm text-muted">Shown to the people you meet. · 만나는 상대에게 보이는 이름이에요.</p>
            <input id="ob-name" name="display_name" type="text" maxlength="40" required value={form.display_name} autocomplete="nickname"
              class="mt-2 block h-[52px] w-full rounded-[14px] border border-border bg-surface px-4 focus:border-brand focus:outline-none focus:ring-3 focus:ring-brand/20" />
          </div>

          <fieldset class="space-y-3">
            <legend class="text-lg font-bold">Agreements <span lang="ko" class="text-sm font-normal text-muted">동의</span></legend>
            <label class={box}>
              <input type="checkbox" name="terms" value="yes" class={checkbox} required />
              <span>(Required) I agree to the <a href="/terms" target="_blank" rel="noopener" class="font-semibold underline">Terms of Service</a>. <span lang="ko" class="block text-sm text-muted">(필수) 이용약관에 동의합니다.</span></span>
            </label>
            <label class={box}>
              <input type="checkbox" name="privacy" value="yes" class={checkbox} required />
              <span>(Required) I agree to the collection and use of my personal information as described in the <a href="/privacy" target="_blank" rel="noopener" class="font-semibold underline">Privacy notice</a>. <span lang="ko" class="block text-sm text-muted">(필수) 개인정보 수집·이용에 동의합니다.</span></span>
            </label>
            <label class={box}>
              <input type="checkbox" name="adult" value="yes" class={checkbox} required />
              <span>(Required) I am 18 or older. <span lang="ko" class="block text-sm text-muted">(필수) 만 18세 이상입니다.</span></span>
            </label>
            <label class={box}>
              <input type="checkbox" name="marketing" value="yes" class={checkbox} checked={form.marketing || undefined} />
              <span>(Optional) Send me news and event emails. <span lang="ko" class="block text-sm text-muted">(선택) 소식·이벤트 메일을 받을게요.</span></span>
            </label>
          </fieldset>

          <button type="submit" class="flex h-[56px] w-full items-center justify-center rounded-full bg-brand text-base font-semibold text-white transition-colors hover:bg-[#082D6B]">
            Continue · 시작하기
          </button>
        </form>
      )}
    </div>
  </section>
</BaseLayout>
