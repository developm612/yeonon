---
import BaseLayout from '../layouts/BaseLayout.astro';
import { isAuthConfigured, safeNext } from '../lib/supabase';

export const prerender = false;

const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.user) return Astro.redirect(next);

const error = Astro.url.searchParams.get('error');
const errors: Record<string, { en: string; ko: string }> = {
  auth: { en: "We couldn't sign you in. Please try again.", ko: '로그인하지 못했어요. 다시 시도해 주세요.' },
  config: { en: 'Sign-in is not available yet.', ko: '로그인 기능이 아직 준비되지 않았어요.' },
};
const message = error ? (errors[error] ?? errors.auth) : null;
const googleHref = `/auth/google?next=${encodeURIComponent(next)}`;
---
<BaseLayout
  title="Sign in | YEONON"
  description="Sign in to YEONON with Google. 연온에 Google 계정으로 로그인하세요."
  sticky="none"
  noindex
>
  <section class="section pt-12! md:pt-20!">
    <div class="container-page max-w-md!">
      <div class="card p-6 text-center md:p-10">
        <p class="eyebrow">YEONON 연온</p>
        <h1 class="mt-3 text-3xl font-extrabold">Sign in</h1>
        <p class="mt-2 text-muted">Travelers and Jigis use the same account.</p>
        <p lang="ko" class="text-sm text-muted">여행자와 지기 모두 같은 방법으로 로그인합니다.</p>

        {message && (
          <p role="alert" class="mt-6 rounded-xl bg-brand-soft px-4 py-3 text-sm">
            {message.en} <span lang="ko" class="block text-muted">{message.ko}</span>
          </p>
        )}

        {isAuthConfigured ? (
          <a
            href={googleHref}
            class="mt-8 flex min-h-13 w-full items-center justify-center gap-3 rounded-full border border-border bg-surface px-6 font-semibold transition-colors hover:border-text"
          >
            <svg aria-hidden="true" viewBox="0 0 48 48" class="size-5">
              <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
              <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
              <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
              <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
            </svg>
            Continue with Google
          </a>
        ) : (
          <p class="mt-8 rounded-xl border border-dashed border-border px-4 py-4 text-sm text-muted">
            Sign-in is not available yet.
            <span lang="ko" class="block">로그인 설정 전입니다 — .env에 Supabase 값을 넣으면 활성화됩니다.</span>
          </p>
        )}

        <p class="mt-6 text-xs text-muted">
          By continuing, you agree to our <a href="/privacy" class="underline underline-offset-2">Privacy notice</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
