---
/**
 * 여행자 내 정보 /me (yeonon-app-first-plan.md 2-1, 하단 탭 'My'). 옛 /app/profile은 301로 여기.
 * 여행자 프로필. 본인이 바꿀 수 있는 칸만 저장한다 (DB 권한도 같은 칸만 허용 — 20261110000001_profiles.sql).
 * 화면 (yeonon-traveler-ui-plan.md 5-7): 카드로 쪼개지 않은 한 장의 폼 + 여백 구분, 저장 버튼은 아래에 고정.
 * 로그아웃·계정 삭제는 맨 아래 글자 버튼.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import UiButton from '../components/ui/UiButton.astro';
import AppFootnote from '../components/ui/AppFootnote.astro';
import Notice from '../components/account/Notice.astro';
import { TRAVELER_LANGUAGES } from '../data/accountNav';
import { interestIcon } from '../data/stopKinds';
import { INTERESTS, INTEREST_MAX, isInterestId } from '../data/interests';
import { dbError, field, fields, notice } from '../lib/forms';
import { clean } from '../scripts/formSafety';

export const prerender = false;

const { profile, supabase } = Astro.locals;
if (!profile || !supabase) return Astro.redirect('/onboarding');

let values = {
  display_name: profile.display_name,
  nationality: profile.nationality ?? '',
  languages: profile.languages,
  interests: profile.interests,
  marketing_opt_in: profile.marketing_opt_in,
};
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  values = {
    display_name: clean(field(fd, 'display_name'), 40),
    nationality: clean(field(fd, 'nationality'), 60),
    languages: [...new Set(fields(fd, 'languages'))].filter((l) => TRAVELER_LANGUAGES.includes(l)),
    interests: [...new Set(fields(fd, 'interests'))].filter(isInterestId),
    marketing_opt_in: field(fd, 'marketing') === 'yes',
  };
  if (!values.display_name) error = 'Please enter a display name.';
  else if (values.interests.length > INTEREST_MAX) error = `Please pick up to ${INTEREST_MAX} interests.`;
  else {
    const { error: updateError } = await supabase
      .from('profiles')
      .update({ ...values, nationality: values.nationality || null })
      .eq('id', profile.id);
    if (!dbError(updateError, 'update traveler profile')) return Astro.redirect('/me?notice=saved');
    error = "We couldn't save your changes. Please try again.";
  }
}

const saved = notice(Astro.url, { saved: 'Your profile is saved.' });
const input = 'mt-2 block h-[52px] w-full rounded-control border border-hairline bg-paper px-4 text-[1.0625rem] focus:border-on-blue focus:outline-none focus:ring-3 focus:ring-on-blue/20';
const pill = 'flex min-h-12 cursor-pointer items-center gap-2.5 rounded-control border border-hairline bg-paper px-3.5 text-[0.9375rem] font-semibold transition-colors hover:border-ink has-checked:border-on-blue has-checked:bg-on-blue-soft has-disabled:cursor-not-allowed has-disabled:opacity-45';
const check = 'size-[18px] shrink-0 cursor-pointer accent-on-blue';
---
<BaseLayout title="My account · YEONON" description="Your YEONON profile." noindex>
  <div class="container-page max-w-2xl! pt-8 pb-16 md:pt-12 md:pb-24">
    <h1 class="t-display">My account</h1>
    <p class="t-body mt-1 text-stone">{profile.email}</p>

    <form method="post" class="mt-8" novalidate id="profile-form">
      {saved && <Notice class="mb-8">{saved}</Notice>}
      {error && <Notice tone="error" class="mb-8">{error}</Notice>}

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="pf-name" class="t-small font-semibold">Display name</label>
          <input id="pf-name" name="display_name" type="text" maxlength="40" required value={values.display_name} class={input} />
        </div>
        <div>
          <label for="pf-nat" class="t-small font-semibold">Nationality <span class="font-normal text-stone">(optional)</span></label>
          <input id="pf-nat" name="nationality" type="text" maxlength="60" value={values.nationality} autocomplete="country-name" class={input} />
        </div>
      </div>

      <fieldset class="mt-12 border-t border-hairline pt-10">
        <legend class="t-title float-left w-full">Languages you speak</legend>
        <div class="clear-both grid grid-cols-2 gap-2 pt-4 sm:grid-cols-4">
          {TRAVELER_LANGUAGES.map((l) => (
            <label class={pill}><input type="checkbox" name="languages" value={l} class={check} checked={values.languages.includes(l) || undefined} />{l}</label>
          ))}
        </div>
      </fieldset>

      <fieldset class="mt-12 border-t border-hairline pt-10" data-max={INTEREST_MAX}>
        <legend class="t-title float-left w-full">Your interests</legend>
        <p class="t-small clear-both pt-1 font-normal text-stone">Up to {INTEREST_MAX}. We use these to recommend routes.</p>
        <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {INTERESTS.map((it) => (
            <label class={pill}>
              <input type="checkbox" name="interests" value={it.id} class={check} checked={values.interests.includes(it.id) || undefined} />
              <Icon name={interestIcon(it.id)} class="size-[18px] shrink-0 text-stone" />{it.label}
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mt-12 border-t border-hairline pt-10">
        <label class="t-body flex cursor-pointer items-start gap-3">
          <input type="checkbox" name="marketing" value="yes" class={`mt-1 ${check}`} checked={values.marketing_opt_in || undefined} />
          <span>Send me news and event emails. <span class="text-stone">(optional)</span></span>
        </label>
      </div>

      <!-- 저장: 아래에 고정 (모바일은 탭바 위) -->
      <div class="sticky bottom-[calc(4rem+env(safe-area-inset-bottom))] z-20 -mx-4 mt-10 border-t border-hairline bg-concrete/95 px-4 py-3 backdrop-blur md:mx-0 md:px-0 lg:bottom-0">
        <UiButton type="submit" class="w-full sm:w-auto sm:px-10">Save changes</UiButton>
      </div>
    </form>

    <ul class="mt-12 divide-y divide-hairline overflow-hidden rounded-card border border-hairline bg-paper">
      <li>
        <a href="/account/notifications" class="flex min-h-14 items-center justify-between gap-3 px-4 font-semibold transition-colors hover:bg-concrete">
          Notifications <Icon name="chevron-right" class="size-5 text-stone" />
        </a>
      </li>
      <li>
        <a href="/bookings" class="flex min-h-14 items-center justify-between gap-3 px-4 font-semibold transition-colors hover:bg-concrete">
          Bookings <Icon name="chevron-right" class="size-5 text-stone" />
        </a>
      </li>
    </ul>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
      <form method="post" action="/auth/signout">
        <UiButton type="submit" variant="text" class="text-ink!">Sign out</UiButton>
      </form>
      <UiButton variant="text" href="/account/delete" class="text-status-error!">Delete account</UiButton>
    </div>
    <AppFootnote class="mt-12 border-t border-hairline pt-6" />
  </div>
</BaseLayout>

<script>
  // 관심사 최대 개수가 차면 나머지 칸을 잠근다 (서버도 다시 확인)
  const max = Number(document.querySelector<HTMLElement>('[data-max]')?.dataset.max ?? 5);
  const boxes = [...document.querySelectorAll<HTMLInputElement>('input[name="interests"]')];
  const sync = () => {
    const full = boxes.filter((b) => b.checked).length >= max;
    boxes.forEach((b) => (b.disabled = full && !b.checked));
  };
  boxes.forEach((b) => b.addEventListener('change', sync));
  sync();
</script>
