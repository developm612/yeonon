---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MEMBER_OPEN, TRAVELER_CTA } from '../config/cta';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import StepTimeline from '../components/StepTimeline.astro';
import MatchDiagram from '../components/MatchDiagram.astro';

const travelerSteps = [
  { title: 'Tell us your taste', body: 'Interests, dates, language, and travel style. Takes about 3 minutes.' },
  MEMBER_OPEN
    ? { title: 'Pick a route that fits you', body: 'YEONON AI suggests routes made by jigis who share your taste. Choose one and a time — your jigi confirms it.' }
    : { title: 'We match you with a Jigi', body: 'During pre-launch, our team recommends a Jigi based on your answers.' },
  { title: 'Plan together', body: "Share what you'd like to try. Your Jigi suggests places only locals know." },
  { title: 'Meet & explore', body: '3–4 hours in Seongsu, at your pace.' },
  { title: 'Share your experience', body: 'Your feedback helps us match better next time.' },
];
const jigiSteps = [
  { title: 'Apply online' },
  { title: 'ID check & interview' },
  { title: 'Onboarding & guidelines' },
  { title: 'Get matched with travelers who share your taste' },
  { title: 'Meet, explore, and get feedback' },
];
const safety = [
  { label: 'ID-checked Jigis', icon: 'id' },
  { label: 'Interviewed before joining', icon: 'chat' },
  { label: 'Activity guidelines', icon: 'book' },
  { label: 'Public meeting places', icon: 'pin' },
  { label: 'Feedback after every meetup', icon: 'feedback' },
] as const;
const compare = [
  ['A local friend matched to your taste', 'A group tour with a fixed route'],
  ['Flexible, 3–4 hours', 'An all-day package'],
  ['Hidden local places', 'Only the famous spots'],
];
---
<BaseLayout
  title="YEONON — Meet a local friend in Seoul"
  description="Tell us what you love. We'll match you with a Jigi — a local friend in Seongsu, Seoul, who shares your taste — for 3–4 hours of hidden cafés, neighborhood eats, and places you'd never find on a map."
>
  <!-- 1. Hero -->
  <Hero
    eyebrow={MEMBER_OPEN ? 'Seongsu, Seoul' : 'Seongsu, Seoul · Pre-launch'}
    title="Don't just visit Seoul. Meet someone who lives it."
    sub="Tell us what you love. We'll match you with a Jigi — a local friend in Seongsu who shares your taste — for 3–4 hours of hidden cafés, neighborhood eats, and places you'd never find on a map."
    slider="en"
  >
    <Fragment slot="actions">
      <Button href={TRAVELER_CTA.href} size="lg">{TRAVELER_CTA.label}</Button>
      <Button href="#how-it-works" variant="secondary" size="lg">See how it works</Button>
    </Fragment>
    <p slot="after" class="mt-6">
      <a href="/jigi" lang="ko" class="inline-flex items-center gap-1.5 text-[0.9375rem] font-semibold text-jigi-strong underline-offset-4 hover:underline">
        한국인이신가요? 지기로 함께하기 <Icon name="arrow" class="size-4" />
      </a>
    </p>
  </Hero>

  <!-- 2. The problem -->
  <section class="section bg-surface" aria-labelledby="problem">
    <div class="container-page">
      <SectionHeading
        id="problem"
        eyebrow="The problem"
        title="Seoul is busy. Your experience shouldn't be the same as everyone else's."
      />
      <div class="mt-10 grid gap-4 md:mt-14 md:grid-cols-3 md:gap-6">
        <Card title="Same lines, same places" icon="queue" tone="traveler">
          Seongsu is packed, but most visitors queue at the same few famous shops and walk past the small places in the alleys.
        </Card>
        <Card title="Hard to get in" icon="lock" tone="traveler">
          Pop-ups need sign-ups, restaurants need reservations, and some local rules don't translate.
        </Card>
        <Card title="Tours don't fit" icon="bus" tone="traveler">
          Group tours are pricey, fixed, and stick to the famous spots.
        </Card>
      </div>
    </div>
  </section>

  <!-- 3. The idea -->
  <section class="section" aria-labelledby="idea">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading id="idea" eyebrow="The idea" title="Pick a person, not a package." />
        <p class="lead mt-5">
          With YEONON, you choose the person first. Your Jigi knows the neighborhood the way locals do — where to eat, which pop-up is worth it, how to order like a regular.
        </p>
      </div>

      <ol class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center" aria-label="How a match happens">
        <li class="card flex flex-1 items-center gap-4 p-5 sm:flex-col sm:text-center">
          <span class="inline-flex size-14 shrink-0 items-center justify-center rounded-2xl bg-traveler-soft text-traveler-strong">
            <Icon name="user" class="size-7" />
          </span>
          <span class="font-bold">You</span>
        </li>
        <li aria-hidden="true" class="flex justify-center text-muted">
          <Icon name="arrow" class="size-6 rotate-90 sm:rotate-0" />
        </li>
        <li class="card flex flex-1 items-center gap-4 border-brand! p-5 sm:flex-col sm:text-center">
          <span class="inline-flex size-14 shrink-0 items-center justify-center rounded-2xl bg-brand text-white">
            <Icon name="spark" class="size-7" />
          </span>
          <span class="font-bold">YEONON matches by taste</span>
        </li>
        <li aria-hidden="true" class="flex justify-center text-muted">
          <Icon name="arrow" class="size-6 rotate-90 sm:rotate-0" />
        </li>
        <li class="card flex flex-1 items-center gap-4 p-5 sm:flex-col sm:text-center">
          <span class="inline-flex size-14 shrink-0 items-center justify-center rounded-2xl bg-jigi-soft text-jigi-strong">
            <Icon name="heart" class="size-7" />
          </span>
          <span class="font-bold">Your Jigi</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- 4. Why YEONON -->
  <section class="section bg-surface" aria-labelledby="why">
    <div class="container-page">
      <SectionHeading id="why" eyebrow="Why YEONON" title="Travel that starts with people, not products." />
      <div class="mt-10 grid gap-4 md:mt-14 md:grid-cols-3 md:gap-6">
        <Card title="People first" icon="users">Good company makes a good trip.</Card>
        <Card title="Matched by taste" icon="spark">Interests, language, schedule, and travel style.</Card>
        <Card title="A real connection" icon="heart">Leave Seoul with a friend, not just photos.</Card>
      </div>
    </div>
  </section>

  <!-- 5. How it works (전 /how-it-works 페이지 내용: 진행 방식 탭 → 매칭 → 안전 → 비교 → 한국어 요약) -->
  <section id="how-it-works" class="section scroll-mt-16 md:scroll-mt-[72px]" aria-labelledby="flow">
    <div class="container-page">
      <SectionHeading
        id="flow"
        eyebrow="How it works"
        title="How YEONON works"
        lead="Simple for travelers. Fair for locals. Built on real connections."
      />
      <div role="tablist" aria-label="Choose a flow" class="mt-10 flex w-full max-w-md md:mt-14 rounded-full border border-border bg-bg p-1.5" data-tabs>
        <button
          role="tab"
          id="tab-travelers"
          aria-controls="panel-travelers"
          aria-selected="true"
          class="flex-1 rounded-full px-4 py-2.5 text-[0.9375rem] font-semibold transition-colors aria-selected:bg-traveler-strong aria-selected:text-white"
        >For Travelers</button>
        <button
          role="tab"
          id="tab-jigis"
          aria-controls="panel-jigis"
          aria-selected="false"
          tabindex="-1"
          class="flex-1 rounded-full px-4 py-2.5 text-[0.9375rem] font-semibold transition-colors aria-selected:bg-jigi-strong aria-selected:text-white"
        >For Jigis</button>
      </div>

      <div class="mt-12 max-w-2xl">
        <div role="tabpanel" id="panel-travelers" aria-labelledby="tab-travelers" tabindex="0">
          <StepTimeline steps={travelerSteps} tone="traveler" />
        </div>
        <div role="tabpanel" id="panel-jigis" aria-labelledby="tab-jigis" tabindex="0" hidden>
          <StepTimeline steps={jigiSteps} tone="jigi" />
          <p class="mt-10">
            <a href="/jigi" lang="ko" class="inline-flex items-center gap-1.5 font-semibold text-jigi-strong underline-offset-4 hover:underline">
              한국어로 보기 <Icon name="arrow" class="size-4" />
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. How we match -->
  <section class="section bg-surface" aria-labelledby="match">
    <div class="container-page">
      <SectionHeading
        id="match"
        eyebrow="How we match"
        title="Must-haves first. Then taste."
        lead="We first filter by what has to line up, then look for the Jigi whose taste fits yours best."
      />
      <div class="mt-10 md:mt-14">
        <MatchDiagram />
      </div>
    </div>
  </section>

  <!-- 7. Safety & trust -->
  <section class="section" aria-labelledby="safety">
    <div class="container-page">
      <SectionHeading id="safety" eyebrow="Safety & trust" title="Built to feel safe on both sides." />
      <ul class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 md:mt-14 lg:grid-cols-5 lg:gap-4">
        {safety.map((s) => (
          <li class="card flex items-center gap-4 p-5 lg:flex-col lg:items-start">
            <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-soft text-brand">
              <Icon name={s.icon} />
            </span>
            <span class="font-semibold leading-snug">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. Is / isn't -->
  <section class="section bg-surface" aria-labelledby="compare">
    <div class="container-page">
      <SectionHeading id="compare" eyebrow="Clear expectations" title="What YEONON is — and isn't" />
      <div class="mt-10 grid gap-4 md:mt-14 md:grid-cols-2 md:gap-6">
        <div class="card overflow-hidden">
          <h3 class="bg-brand px-6 py-4 text-lg font-bold text-white">YEONON is</h3>
          <ul class="divide-y divide-border">
            {compare.map(([is]) => (
              <li class="flex items-start gap-3 px-6 py-4">
                <Icon name="check" class="mt-0.5 size-5 shrink-0 text-brand" />
                <span class="font-medium">{is}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card overflow-hidden">
          <h3 class="border-b border-border bg-bg px-6 py-4 text-lg font-bold text-muted">YEONON isn't</h3>
          <ul class="divide-y divide-border">
            {compare.map(([, isnt]) => (
              <li class="flex items-start gap-3 px-6 py-4 text-muted">
                <Icon name="x" class="mt-0.5 size-5 shrink-0" />
                <span>{isnt}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. 한국어 요약 -->
  <section class="py-16 lg:py-24" aria-labelledby="ko-summary" lang="ko">
    <div class="container-page">
      <div class="rounded-[20px] border border-dashed border-border bg-surface p-6 md:p-8">
        <h2 id="ko-summary" class="text-lg font-bold">한국어로 보기</h2>
        <ol class="mt-4 space-y-2 text-[0.9375rem] text-muted">
          <li>1. 여행자가 취향을 알려 주면</li>
          <li>2. 연온이 맞는 지기를 직접 추천하고</li>
          <li>3. 성수동에서 서너 시간 함께 다닙니다.</li>
        </ol>
        <p class="mt-4 text-[0.9375rem]">
          지기 지원은 <a href="/jigi" class="font-semibold text-jigi-strong underline underline-offset-2">지기 페이지</a>에서 할 수 있어요.
        </p>
      </div>
    </div>
  </section>

  <!-- 10. Two doors -->
  <section class="section bg-surface" aria-label="Choose your path">
    <div class="container-page grid gap-4 md:grid-cols-2 md:gap-6">
      <a href="/travelers" class="group card relative flex min-h-[260px] flex-col overflow-hidden p-7 transition-shadow hover:shadow-lg md:p-10">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1.5 bg-traveler"></span>
        <span class="inline-flex size-12 items-center justify-center rounded-xl bg-traveler-soft text-traveler-strong"><Icon name="map" /></span>
        <h2 class="mt-6 text-2xl font-extrabold md:text-3xl">Traveling to Seoul?</h2>
        <p class="mt-2 text-muted">Meet a local friend who shares your taste.</p>
        <span class="mt-auto inline-flex items-center gap-2 pt-8 font-semibold text-traveler-strong">
          Find your Jigi <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-1" />
        </span>
      </a>
      <a href="/jigi" lang="ko" class="group card relative flex min-h-[260px] flex-col overflow-hidden p-7 transition-shadow hover:shadow-lg md:p-10">
        <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1.5 bg-jigi"></span>
        <span class="inline-flex size-12 items-center justify-center rounded-xl bg-jigi-soft text-jigi-strong"><Icon name="pin" /></span>
        <h2 class="mt-6 text-2xl font-extrabold md:text-3xl">성수동을 잘 아는 한국인이신가요?</h2>
        <p class="mt-2 text-muted">내 동네를 여행자에게 소개하는 현지 친구가 되어 주세요.</p>
        <span class="mt-auto inline-flex items-center gap-2 pt-8 font-semibold text-jigi-strong">
          지기로 지원하기 <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-1" />
        </span>
      </a>
    </div>
  </section>

  <!-- 11. Final CTA -->
  <CTASection title="Be one of our first travelers in Seongsu.">
    <Button href={TRAVELER_CTA.href} size="lg" class="bg-white! text-brand! hover:bg-bg!">{TRAVELER_CTA.label}</Button>
  </CTASection>
</BaseLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tabs] [role="tab"]'));
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      const next = tabs[(i + dir + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>
