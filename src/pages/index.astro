---
/**
 * 첫 화면 = Travelers 탭 루트 피드 (yeonon-app-first-plan.md 1-1). 설명 문단·히어로 없이 바로 루트 목록.
 *   검색(?q=) · 관심사 칩(?tag=) · For you 입구 한 줄 · 루트 목록(가장 가까운 열린 시간 순) · Load more(?page=)
 *   로그인한 여행자에게는 맨 위에 다가오는 만남 / 답을 기다리는 요청 한 줄 (components/feed/MyBookingRows.astro).
 * 공개 화면 캐시(lib/publicCache.ts): 비로그인 기준으로 그려 CDN에 잠깐 담고, 내 예약 줄은 브라우저가 /fragments/my-rows에서 가져온다.
 * 로그인 없이 보인다. For you·예약·채팅처럼 로그인이 필요한 곳은 누르면 로그인 → 이 화면으로 돌아온다.
 * 루트는 공개(published)만 — 읽기 권한은 DB RLS가 다시 거른다. 옛 /routes 목록 주소는 여기로 301.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import AppFootnote from '../components/ui/AppFootnote.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import RouteRow from '../components/ui/RouteRow.astro';
import MyBookingRows from '../components/feed/MyBookingRows.astro';
import { landingUrl } from '../config/site';
import { INTERESTS, isInterestId } from '../data/interests';
import { interestIcon } from '../data/stopKinds';
import { loadFeed, type RouteCardData } from '../lib/routeCards';
import { isAppOpen } from '../lib/supabase';

export const prerender = false;

const { supabase, shell } = Astro.locals;
const params = Astro.url.searchParams;
const tagParam = params.get('tag') ?? '';
const tag = isInterestId(tagParam) ? tagParam : null;
const q = (params.get('q') ?? '').trim().slice(0, 50);
const page = Math.min(20, Math.max(1, Number(params.get('page')) || 1));
const PER_PAGE = 20;

const feed: { items: RouteCardData[]; total: number } = supabase ? await loadFeed(supabase, { tag, q, page, perPage: PER_PAGE }) : { items: [], total: 0 };

const qs = (over: Record<string, string | null>) => {
  const u = new URLSearchParams();
  const v = { q: q || null, tag, page: null as string | null, ...over };
  for (const [k, val] of Object.entries(v)) if (val) u.set(k, val);
  const s = u.toString();
  return s ? `/?${s}` : '/';
};
const chip = 'inline-flex min-h-10 items-center gap-1.5 rounded-full border px-3.5 text-[0.875rem] font-semibold whitespace-nowrap transition-colors';
const filtered = Boolean(tag || q);
const news = landingUrl('empty_feed');
---
<BaseLayout title="Routes in Seongsu · YEONON" description="Small-group routes in Seongsu, made by local friends (jigi) who know the neighborhood." noindex={!isAppOpen || filtered || page > 1}>
  <div class="container-page max-w-[720px]! pt-4 pb-10 md:pt-6">
    <h1 class="sr-only">Routes in Seongsu</h1>

    <!-- 로그인한 여행자: 다가오는 만남·답을 기다리는 요청. 캐시된 공개 화면이면 브라우저가 따로 가져와 이 자리에 넣는다 -->
    {shell ? <div data-my-rows></div> : <MyBookingRows />}

    <!-- 검색 -->
    <form method="get" action="/" role="search" class="relative">
      <label for="feed-q" class="sr-only">Search routes in Seongsu</label>
      <Icon name="search" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-stone" />
      <input id="feed-q" name="q" type="search" value={q} maxlength="50" placeholder="Search routes in Seongsu" enterkeyhint="search"
        class="block h-12 w-full rounded-control border border-hairline bg-paper pr-4 pl-11 text-[1rem] placeholder:text-stone focus:border-on-blue focus:outline-none focus:ring-3 focus:ring-on-blue/20" />
      {tag && <input type="hidden" name="tag" value={tag} />}
    </form>

    <!-- 관심사 칩 (가로 스크롤) -->
    <nav aria-label="Filter by interest" class="-mx-4 mt-3 overflow-x-auto px-4 [scrollbar-width:none] md:mx-0 md:px-0">
      <ul class="flex gap-2 pb-1">
        <li><a href={qs({ tag: null })} aria-current={!tag ? 'page' : undefined} class:list={[chip, !tag ? 'border-on-blue bg-on-blue text-white' : 'border-hairline bg-paper hover:border-ink']}>All</a></li>
        {INTERESTS.map((it) => (
          <li>
            <a href={qs({ tag: it.id })} aria-current={tag === it.id ? 'page' : undefined}
              class:list={[chip, tag === it.id ? 'border-on-blue bg-on-blue text-white' : 'border-hairline bg-paper hover:border-ink']}>
              <Icon name={interestIcon(it.id)} class="size-4" />{it.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- For you 입구 한 줄 -->
    <a href="/for-you" class="mt-4 flex items-center gap-3 rounded-card border border-on-blue/25 bg-on-blue-soft px-4 py-3.5 transition-colors hover:border-on-blue">
      <Icon name="spark" class="size-6 shrink-0 text-on-blue" />
      <span class="min-w-0 flex-1">
        <span class="t-small block font-semibold text-ink">For you</span>
        <span class="t-small block font-normal text-stone">Tell us what you love, get routes matched to you.</span>
      </span>
      <Icon name="chevron-right" class="size-5 shrink-0 text-on-blue" />
    </a>

    <!-- 루트 목록 -->
    {feed.items.length === 0 ? (
      filtered ? (
        <EmptyState class="mt-6" title="No routes match yet" body="Try another word or interest. Local friends add new routes every week."
          action={{ href: '/', label: 'See all routes' }} />
      ) : (
        <EmptyState class="mt-6" title="New routes are on the way" body="Local friends in Seongsu are building their routes right now."
          action={news ? { href: news, label: 'Get updates' } : undefined} />
      )
    ) : (
      <>
        <h2 class="t-small mt-6 font-normal text-stone">
          {feed.total} {feed.total === 1 ? 'route' : 'routes'}{q ? ` for “${q}”` : ''}, soonest open time first
        </h2>
        <ul class="divide-y divide-hairline">
          {feed.items.map((r, i) => (
            <li id={i === (page - 1) * PER_PAGE ? 'more' : undefined} class="scroll-mt-20">
              <RouteRow route={r} href={`/routes/${r.id}`} eager={i < 4} priority={i === 0} />
            </li>
          ))}
        </ul>
        {feed.items.length < feed.total && (
          <div class="mt-4 text-center">
            <a href={`${qs({ page: String(page + 1) })}#more`}
              class="inline-flex min-h-12 items-center rounded-control border border-hairline bg-paper px-6 font-semibold hover:border-ink">
              Load more
            </a>
          </div>
        )}
      </>
    )}

    <AppFootnote class="mt-12 border-t border-hairline pt-6" />
  </div>
</BaseLayout>

<script>
  // 캐시된 공개 화면: 로그인한 여행자면 내 예약 줄을 가져와 넣는다
  import { getFragment, getSession } from '../scripts/session';

  const slot = document.querySelector<HTMLElement>('[data-my-rows]');
  if (slot) {
    getSession().then(async (s) => {
      if (s?.member?.role !== 'traveler') return;
      const frag = await getFragment('/fragments/my-rows');
      if (frag) slot.replaceWith(frag);
    });
  }
</script>
