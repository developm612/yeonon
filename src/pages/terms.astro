---
/**
 * 이용약관 — 자리만 잡아 둔 페이지.
 * TODO(Phase 7, 계획서 10장 2번): 실제 약관을 작성·법률 검토 후 교체. 공개 전에 반드시 채워야 한다 (온보딩에서 동의를 받는다).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout title="Terms of Service | YEONON" description="YEONON Terms of Service. 연온 이용약관." noindex>
  <section class="section pt-12! md:pt-16!">
    <div class="container-page max-w-3xl!">
      <p class="eyebrow">Terms · 이용약관</p>
      <h1 class="mt-3 text-4xl font-extrabold md:text-5xl">Terms of Service</h1>
      <div class="card mt-10 space-y-4 p-6 md:p-8">
        <p>Our Terms of Service are being prepared and will be published here before public launch.</p>
        <p lang="ko" class="text-muted">이용약관은 정식 공개 전에 이 페이지에 게시됩니다.</p>
        <p class="text-sm text-muted">Questions · 문의: <a class="font-semibold text-brand underline" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
