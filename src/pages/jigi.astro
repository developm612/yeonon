---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StepTimeline from '../components/StepTimeline.astro';
import StatCard from '../components/StatCard.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { STAT_SOURCES, isTodo } from '../config/site';

const faq = [
  { q: '가이드 자격증이 필요한가요?', a: '아니요. 지기는 여행 가이드가 아니라 동네를 함께 걷는 현지 친구예요. 활동 범위와 기준은 오픈 전 안내서로 자세히 알려 드려요.' },
  { q: '영어를 얼마나 잘해야 하나요?', a: '일상 대화가 가능하면 충분해요.' },
  { q: '얼마나 자주 활동해야 하나요?', a: '정해진 횟수는 없어요. 가능한 일정을 알려 주시면 그에 맞춰 연결해요.' },
  { q: '안전은 어떻게 관리하나요?', a: '여행자와 지기 모두 신원을 확인하고, 공개된 장소에서 만나는 것을 원칙으로 해요.' },
  { q: '지금 지원하면 바로 활동하나요?', a: '현재는 사전 모집 단계예요. 지원해 주시면 인터뷰 일정을 먼저 연락드려요.' },
];
---
<BaseLayout
  lang="ko"
  sticky="jigi"
  title="성수동 지기 1기 모집 | 연온"
  description="늘 다니던 동네가, 누군가에겐 최고의 여행이 됩니다. 성수동을 잘 아는 당신이 외국인 여행자와 서너 시간을 함께 걸으며 내 동네를 소개해 주세요."
>
  <!-- 1. Hero -->
  <Hero
    eyebrow="성수동 지기 1기 모집"
    accent="jigi"
    title="늘 다니던 동네가, 누군가에겐 최고의 여행이 됩니다."
    sub="성수동을 잘 아는 당신이 외국인 여행자와 서너 시간을 함께 걸으며 단골 카페, 골목 맛집, 팝업스토어를 소개해 주세요. 연온은 취향이 맞는 여행자를 연결해 드립니다."
    image={{
      src: 'jigi-hero.jpg', // TODO: 실제 지기 동의 후 교체 (현재는 일러스트/거리 풍경)
      alt: '성수동 골목을 함께 걷는 두 사람의 뒷모습 일러스트',
      tone: 'jigi',
      caption: '성수동',
    }}
  >
    <Fragment slot="actions">
      <Button href="/app-preview-jigi" variant="jigi" size="lg">지기 지원하기</Button>
      <Button href="#process" variant="secondary" size="lg">선발 과정 보기</Button>
    </Fragment>
  </Hero>

  <!-- 2. 지기란? -->
  <section class="section bg-surface" aria-labelledby="what">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow justify-center text-jigi-strong">지기란?</p>
        <h2 id="what" class="h-section mt-3">
          <span class="text-jigi-strong">지기(知己)</span>는<br class="sm:hidden" /> 나를 알아주는 친구라는 뜻이에요.
        </h2>
        <p class="lead mt-5">
          연온의 지기는 가이드가 아니라, 여행자와 취향이 맞는 현지 친구입니다.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. 왜 지금 성수동인가 -->
  <section class="section" aria-labelledby="why-now">
    <div class="container-page">
      <SectionHeading id="why-now" eyebrow="왜 지금 성수동인가" title="외국인 여행자는 이미 성수동으로 오고 있어요." />
      <div class="mt-10 grid gap-4 md:mt-14 md:grid-cols-3 md:gap-6">
        <StatCard label="2025년 방한 외국인" value="1,894" unit="만 명" note="역대 최다" footnote={1} />
        <StatCard label="성수역 외국인 승차 (2026년 상반기)" value="8만 4,373" unit="명" note="전년 대비 36.9% 증가" footnote={2} />
        <StatCard label="성동구 외국인 소비 (2026년 1~5월)" value="2,082" unit="억 원" note="1년 새 약 2배" footnote={3} />
      </div>
      <p class="mt-10 text-lg font-semibold md:text-xl">
        사람은 몰리지만, 경험은 몇 곳에만 쏠려 있어요.<br class="hidden sm:block" />
        그 사이를 이어 줄 사람이 필요합니다.
      </p>
      <ol class="mt-8 space-y-1 border-t border-border pt-5 text-xs text-muted" aria-label="출처">
        {STAT_SOURCES.map((s) => (
          <li id={`source-${s.id}`} class="scroll-mt-24">
            [{s.id}] {s.label} —{' '}
            {isTodo(s.url) ? <span>{s.url}</span> : <a href={s.url} target="_blank" rel="noopener" class="underline underline-offset-2">{s.url}</a>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. 이런 분을 찾아요 -->
  <section class="section bg-surface" aria-labelledby="who">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <SectionHeading id="who" eyebrow="이런 분을 찾아요" title="내 동네를 잘 아는 사람이면 충분해요." />
      <ul class="space-y-3">
        {[
          '성수동에 살거나, 일하거나, 자주 다니는 분',
          '대학생, 크리에이터, 직장인, 사진가 등 자기 동네를 잘 아는 분',
          '영어로 일상 대화가 가능한 분', // TODO: 필요 수준 확정
          '주말이나 평일 저녁에 3~4시간 낼 수 있는 분',
        ].map((t) => (
          <li class="card flex items-start gap-4 p-5">
            <span class="mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-jigi-strong text-white">
              <Icon name="check" class="size-4" />
            </span>
            <span class="font-medium">{t}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. 지기가 되면 -->
  <section class="section" aria-labelledby="benefits">
    <div class="container-page">
      <SectionHeading id="benefits" eyebrow="지기가 되면" title="부담 없이, 내 방식대로." />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 md:mt-14 lg:grid-cols-4 lg:gap-6">
        <Card title="내 시간에 맞춰" icon="clock" tone="jigi">가능한 날에만 활동해요.</Card>
        <Card title="익숙한 동네로" icon="map" tone="jigi">따로 공부할 코스가 필요 없어요. 늘 가던 곳이면 충분해요.</Card>
        <Card title="새로운 인연" icon="users" tone="jigi">세계 각국의 여행자와 친구가 돼요.</Card>
        <Card title="활동 보상" icon="spark" tone="jigi">정식 오픈 시 활동에 대한 보상이 있어요. 구체적인 금액과 정산 방식은 오픈 전에 안내해 드려요.</Card>
      </div>
    </div>
  </section>

  <!-- 6. 선발 과정 -->
  <section id="process" class="section scroll-mt-16 bg-surface" aria-labelledby="process-title">
    <div class="container-page">
      <SectionHeading id="process-title" eyebrow="선발 과정" title="네 단계로 함께하게 돼요." />
      <div class="mt-10 md:mt-14">
        <StepTimeline
          layout="horizontal"
          tone="jigi"
          steps={[
            { title: '온라인 지원서 작성' },
            { title: '신분 확인 및 짧은 인터뷰' },
            { title: '활동 안내서 전달 및 오리엔테이션' },
            { title: '취향이 맞는 여행자와 첫 만남' },
          ]}
        />
      </div>
      <p class="mt-10 rounded-2xl bg-jigi-soft px-5 py-4 text-[0.9375rem] font-medium text-[#074457]">
        1기는 소수(약 30명)로 시작해요. 숫자보다 경험의 질을 먼저 지키려고 합니다.
      </p>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section" aria-labelledby="faq">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <SectionHeading id="faq" eyebrow="자주 묻는 질문" title="궁금한 점이 있으신가요?" />
      <FAQ items={faq} />
    </div>
  </section>

  <!-- 8. 마지막 CTA -->
  <CTASection title="당신의 성수동을 소개해 주세요." tone="jigi">
    <Button href="/app-preview-jigi" size="lg" class="bg-white! text-[#0B4F78]! hover:bg-bg!">지기 지원하기</Button>
  </CTASection>
</BaseLayout>
