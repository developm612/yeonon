---
/**
 * 지기 홈: 신청 전 → 신청 안내, 신청 후 → 심사 상태,
 * 승인 후 → 새 요청(실시간 + 응답 기한 카운트다운, Preact 아일랜드) · 오늘·이번 주 만남 · 내 평점·후기 · 내 루트·가능 시간 요약
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaNav from '../../components/account/AreaNav.astro';
import Notice from '../../components/account/Notice.astro';
import { PARTNER_NAV } from '../../data/accountNav';
import { APPLICATION_STATUS, type ApplicationStatus } from '../../data/jigiStatus';
import PartnerRequests, { type RequestItem } from '../../components/islands/PartnerRequests';
import { kstWhen } from '../../data/bookingOptions';
import { kstToday } from '../../lib/availability';
import { BOOKING_COLUMNS, type BookingRow } from '../../lib/bookings';
import { dbError, notice } from '../../lib/forms';
import { kstDay } from '../../lib/routes';
import { loadPublicReviews, type PublicReview } from '../../lib/reviews';

export const prerender = false;

const { profile, supabase } = Astro.locals;
if (!profile || !supabase) return Astro.redirect('/onboarding');

const [{ data: application, error: appError }, { data: jigi }] = await Promise.all([
  supabase.from('jigi_applications').select('status, created_at, reviewed_at').eq('user_id', profile.id).maybeSingle(),
  supabase.from('jigi_profiles').select('is_active, languages, rating_avg, rating_count, accept_rate, avg_response_minutes, response_count').eq('user_id', profile.id).maybeSingle(),
]);
dbError(appError, 'load own application');
const status = application?.status as ApplicationStatus | undefined;
const approved = status === 'approved' && jigi?.is_active;
let routeCount = 0;
let publishedCount = 0;
let openSlotCount = 0;
let pending: RequestItem[] = [];
let week: BookingRow[] = [];
let reviews: PublicReview[] = [];
if (approved) {
  // 이번 주 = 오늘부터 7일
  const weekEnd = new Date(Date.now() + 7 * 864e5).toISOString();
  const [{ data: routes }, { count }, p, w, rv] = await Promise.all([
    supabase.from('routes').select('status').eq('jigi_id', profile.id),
    supabase.from('slots').select('id', { count: 'exact', head: true }).eq('jigi_id', profile.id).eq('status', 'open').gt('starts_at', new Date().toISOString()),
    supabase.from('bookings').select(BOOKING_COLUMNS).eq('jigi_id', profile.id).eq('status', 'pending').order('respond_by').limit(50),
    supabase.from('bookings').select(BOOKING_COLUMNS).eq('jigi_id', profile.id).eq('status', 'confirmed')
      .gt('ends_at', new Date().toISOString()).lt('starts_at', weekEnd).order('starts_at').limit(30),
    loadPublicReviews(supabase, profile.id, 3),
  ]);
  reviews = rv;
  routeCount = routes?.length ?? 0;
  publishedCount = routes?.filter((r) => r.status === 'published').length ?? 0;
  openSlotCount = count ?? 0;
  dbError(p.error ?? w.error, 'load jigi home bookings');
  pending = (p.data ?? []) as BookingRow[];
  week = (w.data ?? []) as BookingRow[];
}
const today = kstToday();
const todays = week.filter((b) => kstDay(b.starts_at) === today);
const later = week.filter((b) => kstDay(b.starts_at) !== today);
const applied = notice(Astro.url, { applied: '신청서를 보냈어요. 검토 후 연락드릴게요.' });
const date = (iso: string) => new Date(iso).toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul' });
// 품질 지표 (후기·요청 응답으로 자동 갱신 — 마이그레이션 17번). 여행자 추천 순서에도 반영된다
const m = jigi as { rating_avg: number | null; rating_count: number; accept_rate: number | null; avg_response_minutes: number | null; response_count: number } | null;
const responseText = m?.avg_response_minutes == null ? '-' : m.avg_response_minutes < 60 ? `${m.avg_response_minutes}분` : `${Math.floor(m.avg_response_minutes / 60)}시간 ${m.avg_response_minutes % 60}분`;
---
<BaseLayout title="지기 홈 | YEONON" description="연온 지기 홈" lang="ko" sticky="none" noindex>
  <AreaNav items={PARTNER_NAV} label="지기 메뉴" />
  <section class="section pt-10! md:pt-14!">
    <div class="container-page max-w-2xl!">
      <p class="eyebrow">지기</p>
      <h1 class="mt-3 text-3xl font-extrabold">{profile.display_name}님, 안녕하세요</h1>

      {applied && <Notice class="mt-6">{applied}</Notice>}

      {approved && (
        <>
          <h2 class="mt-8 font-bold">새 요청 <span class="font-normal text-muted">· 실시간</span></h2>
          <div class="mt-3"><PartnerRequests client:load jigiId={profile.id} initial={pending} /></div>

          <h2 class="mt-8 font-bold">오늘 · 이번 주 만남</h2>
          {week.length === 0 ? (
            <p class="mt-2 text-sm text-muted">앞으로 7일 안에 확정된 만남이 없어요.</p>
          ) : (
            <ul class="mt-3 divide-y divide-border rounded-2xl bg-surface shadow-card">
              {[...todays, ...later].map((b) => (
                <li>
                  <a href={`/partner/bookings/${b.id}`} class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 hover:bg-text/5">
                    {kstDay(b.starts_at) === today && <span class="rounded-full bg-jigi-strong px-2.5 py-0.5 text-xs font-bold text-white">오늘</span>}
                    <span class="font-semibold tabular-nums">{kstWhen(b.starts_at, 'ko')}</span>
                    <span>{b.route_title}</span>
                    <span class="text-sm text-muted">{b.party_size}명 · {b.traveler_name || '여행자'}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          <h2 class="mt-8 font-bold">내 평점 · 후기</h2>
          <dl class="mt-3 grid grid-cols-3 gap-3">
            <div class="card p-4"><dt class="text-xs text-muted">평점</dt><dd class="mt-1 text-xl font-extrabold tabular-nums">{m?.rating_avg != null ? `★ ${Number(m.rating_avg).toFixed(1)}` : '-'}<span class="ml-1 text-xs font-normal text-muted">{m?.rating_count ?? 0}개</span></dd></div>
            <div class="card p-4"><dt class="text-xs text-muted">수락률</dt><dd class="mt-1 text-xl font-extrabold tabular-nums">{m?.accept_rate != null ? `${Math.round(Number(m.accept_rate))}%` : '-'}</dd></div>
            <div class="card p-4"><dt class="text-xs text-muted">평균 응답</dt><dd class="mt-1 text-xl font-extrabold tabular-nums">{responseText}</dd></div>
          </dl>
          <p class="mt-2 text-xs text-muted">최근 응답한 요청 {m?.response_count ?? 0}건 기준. 평점·수락률·응답 속도는 여행자 AI 추천 순서에 반영돼요.</p>
          {reviews.length > 0 && (
            <ul class="mt-3 space-y-2">
              {reviews.map((r) => (
                <li class="rounded-xl bg-surface px-4 py-3 text-sm shadow-card">
                  <span class="text-[#B7791F]" aria-label={`별점 ${r.rating}점`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span>
                  <span class="ml-2 text-muted">{r.author_initial}. · {r.route_title} · {date(r.created_at)}</span>
                  {r.comment && <p class="mt-1">{r.comment}</p>}
                </li>
              ))}
            </ul>
          )}
        </>
      )}

      <div class="card mt-8 p-6 md:p-8">
        {!status ? (
          <>
            <h2 class="text-lg font-bold">지기 신청서를 작성해 주세요</h2>
            <p class="mt-2 text-muted">신청서를 보내 주시면 짧은 인터뷰 후 지기로 활동할 수 있어요. 가이드 자격증은 필요 없어요.</p>
            <a href="/partner/apply" class="mt-6 inline-flex min-h-11 items-center rounded-full bg-jigi-strong px-5 font-semibold text-white hover:bg-[#08566F]">신청서 작성하기</a>
          </>
        ) : approved ? (
          <>
            <p class="inline-flex rounded-full bg-jigi-soft px-3 py-1 text-sm font-semibold text-jigi-strong">승인된 지기</p>
            <h2 class="mt-3 text-lg font-bold">연온 지기가 되신 걸 환영해요!</h2>
            <p class="mt-2 text-muted">나만의 성수 루트를 만들어 검수를 받고, 만날 수 있는 시간을 열어 두세요.</p>
            <p class="mt-4 text-sm text-muted">
              내 루트 {routeCount}개 · 공개 {publishedCount}개 · 앞으로 4주 열린 시간 {openSlotCount}개
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/partner/bookings" class="inline-flex min-h-11 items-center rounded-full bg-jigi-strong px-5 font-semibold text-white hover:bg-[#08566F]">예약</a>
              <a href="/partner/routes" class="inline-flex min-h-11 items-center rounded-full border border-border bg-surface px-5 font-semibold hover:border-text">내 루트</a>
              <a href="/partner/availability" class="inline-flex min-h-11 items-center rounded-full border border-border bg-surface px-5 font-semibold hover:border-text">가능 시간</a>
            </div>
          </>
        ) : (
          <>
            <p class="text-sm text-muted">신청 상태</p>
            <p class="mt-1 text-2xl font-extrabold text-jigi-strong">{APPLICATION_STATUS[status].label}</p>
            <p class="mt-2 text-muted">{APPLICATION_STATUS[status].desc}</p>
            <p class="mt-4 text-sm text-muted">신청일 {date(application!.created_at)}{application!.reviewed_at && ` · 최근 검토 ${date(application!.reviewed_at)}`}</p>
          </>
        )}
      </div>

      <div class="mt-14 border-t border-border pt-8">
        <h2 class="font-bold">계정</h2>
        <p class="mt-1 text-sm text-muted">{profile.email}</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <form method="post" action="/auth/signout">
            <button type="submit" class="min-h-11 rounded-full border border-border bg-surface px-5 font-semibold hover:border-text">로그아웃</button>
          </form>
          <a href="/account/delete" class="inline-flex min-h-11 items-center rounded-full px-5 font-semibold text-[#B42318] hover:bg-[#FDECEC]">회원 탈퇴</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
