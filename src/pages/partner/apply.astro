---
/**
 * 로그인 후 지기 신청서. 사전 신청과 같은 폼(JigiApplyForm mode="account")을 쓰고,
 * 서버에서 같은 규칙(lib/jigiApplication.ts)으로 다시 검증해 jigi_applications에 저장한다. 1인 1건.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaNav from '../../components/account/AreaNav.astro';
import JigiApplyForm from '../../components/app/JigiApplyForm.astro';
import { PARTNER_NAV } from '../../data/accountNav';
import { dbError, field, fields } from '../../lib/forms';
import { validateJigiApplication } from '../../lib/jigiApplication';

export const prerender = false;

const { profile, supabase } = Astro.locals;
if (!profile || !supabase) return Astro.redirect('/onboarding');

const { data: existing } = await supabase.from('jigi_applications').select('id').eq('user_id', profile.id).maybeSingle();
if (existing) return Astro.redirect('/partner');
// 관리자가 확인용으로 들어온 경우 화면만 보여 주고 저장은 막는다 (DB도 지기만 신청 가능)
const canApply = profile.role === 'jigi';

let values: Record<string, string | string[]> = {};
let error: { field: string; message: string } | undefined;

if (Astro.request.method === 'POST' && canApply) {
  const fd = await Astro.request.formData();
  const result = validateJigiApplication((k) => field(fd, k), (k) => fields(fd, k));
  if (result.ok) {
    const { error: insertError } = await supabase.from('jigi_applications').insert(result.data);
    if (!dbError(insertError, 'insert jigi application') || insertError?.code === '23505') {
      return Astro.redirect('/partner?notice=applied');
    }
    error = { field: '', message: '신청서를 저장하지 못했어요. 잠시 후 다시 시도해 주세요.' };
  } else {
    error = { field: result.field, message: result.message };
  }
  // 입력한 내용을 그대로 다시 채워 보여 준다
  for (const k of ['name', 'phone', 'age_group', 'seongsu_relation', 'intro', 'sample_course', 'instagram', 'heard_from', 'referred_by']) values[k] = field(fd, k);
  for (const k of ['languages', 'availability', 'taste']) values[k] = fields(fd, k);
}
---
<BaseLayout title="지기 신청서 | YEONON" description="연온 지기 신청서" lang="ko" sticky="none" noindex>
  <AreaNav items={PARTNER_NAV} label="지기 메뉴" />
  {!canApply && (
    <p class="container-page mt-6 rounded-xl bg-brand-soft px-4 py-3 text-sm font-medium text-brand">관리자 확인용 화면이에요. 신청은 지기 계정으로만 할 수 있어요.</p>
  )}
  <JigiApplyForm mode="account" account={{ email: profile.email ?? '', name: profile.display_name }} values={values} error={error} />
</BaseLayout>

<script>
  import '../../scripts/jigiApply.ts';
</script>
