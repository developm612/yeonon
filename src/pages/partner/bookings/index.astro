---
/**
 * 지기 예약 목록: 새 요청(응답 대기, 실시간 + 기한 카운트다운) / 다가오는 만남 / 지난·종료.
 * 읽기는 RLS(내 루트의 예약만). 수락·거절·취소는 상세 화면에서.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaNav from '../../../components/account/AreaNav.astro';
import JigiOnly from '../../../components/account/JigiOnly.astro';
import PartnerRequests, { type RequestItem } from '../../../components/islands/PartnerRequests';
import { PARTNER_NAV } from '../../../data/accountNav';
import { BOOKING_STATUS, STATUS_TONE_CLASS, kstWhen } from '../../../data/bookingOptions';
import { BOOKING_COLUMNS, type BookingRow } from '../../../lib/bookings';
import { dbError } from '../../../lib/forms';
import { loadApprovedJigi } from '../../../lib/routes';

export const prerender = false;

const { profile, supabase } = Astro.locals;
if (!profile || !supabase) return Astro.redirect('/onboarding');
const jigi = await loadApprovedJigi(supabase, profile);

let pending: RequestItem[] = [];
let upcoming: BookingRow[] = [];
let past: BookingRow[] = [];
if (jigi) {
  const [p, u, d] = await Promise.all([
    supabase.from('bookings').select(BOOKING_COLUMNS).eq('jigi_id', profile.id).eq('status', 'pending').order('respond_by').limit(50),
    supabase.from('bookings').select(BOOKING_COLUMNS).eq('jigi_id', profile.id).eq('status', 'confirmed').order('starts_at').limit(100),
    supabase.from('bookings').select(BOOKING_COLUMNS).eq('jigi_id', profile.id).not('status', 'in', '(pending,confirmed)').order('starts_at', { ascending: false }).limit(50),
  ]);
  dbError(p.error ?? u.error ?? d.error, 'load jigi bookings');
  pending = (p.data ?? []) as BookingRow[];
  upcoming = (u.data ?? []) as BookingRow[];
  past = (d.data ?? []) as BookingRow[];
}
const row = (b: BookingRow) => `${kstWhen(b.starts_at, 'ko')} · ${b.party_size}명 · ${b.traveler_name || '여행자'}`;
---
<BaseLayout title="예약 | YEONON" description="연온 지기 예약" lang="ko" sticky="none" noindex>
  <AreaNav items={PARTNER_NAV} label="지기 메뉴" />
  <section class="section pt-10! md:pt-14!">
    <div class="container-page max-w-2xl!">
      <p class="eyebrow">지기</p>
      <h1 class="mt-3 text-3xl font-extrabold">예약</h1>
      {!jigi ? (
        <JigiOnly isAdmin={profile.role === 'admin'} />
      ) : (
        <>
          <p class="mt-2 text-muted">확정 방식은 <a href="/partner/availability" class="font-semibold underline underline-offset-2">가능 시간</a>에서 바꿀 수 있어요. 지금: <b>{jigi.confirm_mode === 'instant' ? '즉시 확정' : '수락 후 확정'}</b></p>

          <h2 class="mt-10 font-bold">새 요청 <span class="font-normal text-muted">· 응답 대기</span></h2>
          <div class="mt-3"><PartnerRequests client:load jigiId={profile.id} initial={pending} /></div>

          <h2 class="mt-10 font-bold">다가오는 만남 <span class="font-normal text-muted tabular-nums">{upcoming.length}</span></h2>
          {upcoming.length === 0 ? (
            <p class="mt-2 text-sm text-muted">확정된 만남이 없어요.</p>
          ) : (
            <ul class="mt-3 space-y-3">
              {upcoming.map((b) => (
                <li>
                  <a href={`/partner/bookings/${b.id}`} class="card block p-4 transition-colors hover:border-text md:p-5">
                    <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-bold', STATUS_TONE_CLASS.ok]}>확정</span>
                    <p class="mt-2 font-bold">{b.route_title}</p>
                    <p class="mt-0.5 text-sm text-muted tabular-nums">{row(b)}</p>
                  </a>
                </li>
              ))}
            </ul>
          )}

          {past.length > 0 && (
            <>
              <h2 class="mt-10 font-bold">지난·종료 <span class="font-normal text-muted">최근 50건</span></h2>
              <ul class="mt-3 divide-y divide-border rounded-2xl bg-surface shadow-card">
                {past.map((b) => (
                  <li>
                    <a href={`/partner/bookings/${b.id}`} class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 hover:bg-text/5">
                      <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-bold', STATUS_TONE_CLASS[BOOKING_STATUS[b.status].tone]]}>{BOOKING_STATUS[b.status].ko}</span>
                      <span class="font-semibold">{b.route_title}</span>
                      <span class="text-sm text-muted tabular-nums">{row(b)}</span>
                      {b.late_cancel && <span class="text-xs font-semibold text-[#8A1C1C]">24시간 이내 취소</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </>
      )}
    </div>
  </section>
</BaseLayout>
