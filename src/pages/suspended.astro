---
/** 관리자가 이용을 정지한 계정이 회원 영역에 들어오면 보이는 화면 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { homeFor } from '../lib/profile';

export const prerender = false;

const { profile } = Astro.locals;
if (profile && profile.status === 'active') return Astro.redirect(homeFor(profile));
---
<BaseLayout title="Account paused | YEONON" description="Your YEONON account is paused." sticky="none" noindex>
  <section class="section pt-12! md:pt-20!">
    <div class="container-page max-w-md!">
      <div class="card p-6 text-center md:p-10">
        <h1 class="text-2xl font-extrabold">Your account is paused</h1>
        <p lang="ko" class="mt-1 text-muted">계정 이용이 일시 정지되었어요.</p>
        <p class="mt-6 text-sm text-muted">
          Please contact us · 문의:
          <a class="font-semibold text-brand underline" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        </p>
        <form method="post" action="/auth/signout" class="mt-8">
          <button type="submit" class="min-h-11 rounded-full border border-border bg-surface px-5 font-semibold hover:border-text">Sign out · 로그아웃</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
