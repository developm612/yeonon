---
/**
 * 예약 상세 (여행자). 상태·응답 기한·타임라인·취소·"See other routes"는 Preact 아일랜드(BookingPanel)가
 * Realtime으로 바로 갱신한다. 만남 안내(시간·만나는 곳·지기 이름)와 가격 스냅샷은 여기서 그린다.
 * 다른 사람의 예약 id를 넣으면 RLS 때문에 행이 없으므로 '찾을 수 없음'이 된다.
 * 만남이 끝나면(completed) 아래에 후기 칸(components/reviews/ReviewSection) — 폼은 이 페이지로 POST.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Notice from '../../components/account/Notice.astro';
import BookingPanel from '../../components/islands/BookingPanel';
import ReviewSection from '../../components/reviews/ReviewSection.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import RoutePhoto from '../../components/ui/RoutePhoto.astro';
import UiButton from '../../components/ui/UiButton.astro';
import { kstWhen, priceText } from '../../data/bookingOptions';
import { areaName } from '../../data/routeOptions';
import { BOOKING_COLUMNS, discoverHrefFor, loadBookingSettings, type BookingRow } from '../../lib/bookings';
import { conversationIdForBooking } from '../../lib/chat';
import { notice } from '../../lib/forms';
import { handleReviewPost, loadMyReview } from '../../lib/reviews';
import { UUID, type PublicJigi } from '../../lib/routes';

export const prerender = false;

const { supabase, profile } = Astro.locals;
if (!supabase || !profile) return Astro.redirect('/login');

const id = Astro.params.id ?? '';
const { data } = UUID.test(id) ? await supabase.from('bookings').select(BOOKING_COLUMNS).eq('id', id).maybeSingle() : { data: null };
const booking = data as BookingRow | null;
if (!booking) Astro.response.status = 404;

// 후기 쓰기·고치기·지우기 (만남이 끝난 예약의 여행자만 — DB 함수가 다시 확인한다)
let reviewError: string | null = null;
if (Astro.request.method === 'POST' && booking) {
  const result = await handleReviewPost(supabase, await Astro.request.formData(), booking.id, 'en');
  if (result && 'redirect' in result) return Astro.redirect(Astro.url.pathname + result.redirect);
  reviewError = result?.error ?? 'Something went wrong. Please try again.';
}
const myReview = booking?.status === 'completed' && booking.traveler_id === profile.id ? await loadMyReview(supabase, booking.id, profile.id) : null;

let host: PublicJigi | null = null;
let discoverHref = '/for-you';
let routeLive = false;
let cover: string | null = null;
let stopNames: string[] = [];
const settings = await loadBookingSettings(supabase);
const chatId = booking ? await conversationIdForBooking(supabase, booking.id) : null;
if (booking) {
  const [{ data: j }, { data: r }, rec, { data: st }] = await Promise.all([
    supabase.from('public_jigis').select('*').eq('user_id', booking.jigi_id).maybeSingle(),
    supabase.from('routes').select('id, tags, languages, status, cover_photo').eq('id', booking.route_id).maybeSingle(),
    booking.recommendation_id
      ? supabase.from('recommendation_requests').select('input').eq('id', booking.recommendation_id).maybeSingle()
      : Promise.resolve({ data: null }),
    supabase.from('route_stops').select('place_name, order_no').eq('route_id', booking.route_id).order('order_no'),
  ]);
  cover = (r?.cover_photo as string | null | undefined) ?? null;
  stopNames = (st ?? []).map((x) => x.place_name as string);
  host = (j as PublicJigi | null) ?? null;
  routeLive = r?.status === 'published';
  discoverHref = discoverHrefFor(booking, r ?? null, (rec.data?.input as Record<string, unknown> | undefined) ?? null);
}

const done = notice(Astro.url, {
  requested: "Request sent. We'll let you know as soon as your jigi replies.",
  cancelled: 'Your booking was cancelled.',
});
const reviewNotice = notice(Astro.url, { review_saved: 'Thanks! Your review is saved.', review_deleted: 'Your review was deleted.' });
const jigiName = booking?.jigi_name ?? host?.display_name ?? 'Your jigi';
---
<BaseLayout title="Booking | YEONON" description="Your YEONON booking." noindex>
  <div class="container-page max-w-3xl! pt-3 pb-16 md:pt-6 md:pb-24">
    <a href="/bookings" class="t-small -ml-1 inline-flex min-h-11 items-center gap-1 px-1 text-stone hover:text-ink"><Icon name="chevron-left" class="size-4" />Bookings</a>
    {!booking ? (
      <EmptyState class="mt-4" title="We couldn't find that booking" body="It may have been removed, or the link is wrong. See all your bookings."
        action={{ href: '/bookings', label: 'My bookings' }} />
    ) : (
      <>
        <div class="mt-2 flex items-start gap-4">
          <RoutePhoto path={cover} alt="" stops={stopNames} ratio="1 / 1" sizes="96px" class="w-20 shrink-0 rounded-control md:w-24" />
          <div class="min-w-0">
            <h1 class="t-title">{booking.route_title}</h1>
            <p class="t-num mt-1 text-[1.0625rem]">{kstWhen(booking.starts_at, 'en')} <span class="t-small font-normal text-stone">KST</span></p>
          </div>
        </div>
        {done && <Notice class="mt-6">{done}</Notice>}

        <div class="mt-6 rounded-card border border-hairline bg-paper p-5 md:p-7">
          <BookingPanel client:load booking={booking} viewer="traveler" discoverHref={discoverHref} lateCancelMinutes={settings.late_cancel_minutes} />
        </div>

        <section class="mt-10" aria-labelledby="h-details">
          <h2 id="h-details" class="t-title">Meetup details</h2>
          <dl class="mt-4 divide-y divide-hairline border-y border-hairline">
            {[
              { icon: 'clock', k: 'When (KST)', v: `${kstWhen(booking.starts_at, 'en')} – ${new Date(booking.ends_at).toLocaleTimeString('en-GB', { timeZone: 'Asia/Seoul', hour: '2-digit', minute: '2-digit' })}` },
              { icon: 'users', k: 'Group', v: `${booking.party_size} ${booking.party_size === 1 ? 'person' : 'people'}` },
              { icon: 'pin', k: "Where you'll meet", v: `${booking.meeting_area ? `${areaName(booking.meeting_area, 'en')}, ` : ''}${booking.meeting_point_note ?? 'Shared in chat'}` },
              { icon: 'user', k: 'Your local friend', v: jigiName },
              { icon: 'bag', k: 'Price', v: priceText(booking.list_price, booking.final_price, booking.promotion_name) },
            ].map((row) => (
              <div class="flex items-start gap-3 py-3.5">
                <dt class="t-small flex w-40 shrink-0 items-center gap-2 font-normal text-stone"><Icon name={row.icon as 'clock'} class="size-[18px]" />{row.k}</dt>
                <dd class="t-small min-w-0 font-semibold">{row.v}</dd>
              </div>
            ))}
            {booking.note && (
              <div class="py-3.5">
                <dt class="t-small font-normal text-stone">Your note</dt>
                <dd class="t-body mt-1">{booking.note}</dd>
              </div>
            )}
          </dl>
          <p class="t-small measure mt-4 font-normal text-stone">Always a public place. Your jigi shares the exact spot in chat once you're matched. Contact details stay private.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            {chatId && <UiButton href={`/chats/${chatId}`}>Open chat</UiButton>}
            {routeLive && <UiButton variant="secondary" href={`/routes/${booking.route_id}`}>View the route</UiButton>}
          </div>
        </section>
        {myReview && (
          <ReviewSection lang="en" targetName={jigiName} review={myReview.review} editable={myReview.editable} editableUntil={myReview.editableUntil} error={reviewError} notice={reviewNotice} />
        )}
      </>
    )}
  </div>
</BaseLayout>
