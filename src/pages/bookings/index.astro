---
/**
 * 내 예약 (여행자, yeonon-traveler-ui-plan.md 5-5): 다가오는 것(요청·확정) / 지난 것(완료·취소·만료·거절) 두 묶음.
 * 각 줄에 작은 사진(없으면 노선도 썸네일) + 날짜(제목 글꼴 숫자 크게) + 상태 배지. 읽기는 RLS(본인 예약만).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import RoutePhoto from '../../components/ui/RoutePhoto.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import { isActive, timeLeft } from '../../data/bookingOptions';
import { BOOKING_COLUMNS, type BookingRow } from '../../lib/bookings';
import { dbError } from '../../lib/forms';
import { kstDate, kstTime } from '../../lib/routes';

export const prerender = false;

const { profile, supabase } = Astro.locals;
if (!profile || !supabase) return Astro.redirect('/login');

const { data, error } = await supabase.from('bookings').select(BOOKING_COLUMNS).eq('traveler_id', profile.id)
  .order('starts_at', { ascending: false }).limit(100);
dbError(error, 'load traveler bookings');
const all = (data ?? []) as BookingRow[];
const upcoming = all.filter((b) => isActive(b.status)).reverse();
const past = all.filter((b) => !isActive(b.status));

// 작은 사진: 루트 대표 사진, 없으면 정류장 이름으로 노선도
const routeIds = [...new Set(all.map((b) => b.route_id))];
const covers = new Map<string, string | null>();
const stopNames = new Map<string, string[]>();
if (routeIds.length) {
  const [{ data: routes }, { data: stops }] = await Promise.all([
    supabase.from('routes').select('id, cover_photo').in('id', routeIds),
    supabase.from('route_stops').select('route_id, order_no, place_name').in('route_id', routeIds).order('order_no'),
  ]);
  for (const r of routes ?? []) covers.set(r.id, r.cover_photo);
  for (const s of stops ?? []) stopNames.set(s.route_id, [...(stopNames.get(s.route_id) ?? []), s.place_name]);
}
const now = Date.now();
const groups = [
  { id: 'upcoming', title: 'Upcoming', list: upcoming },
  { id: 'past', title: 'Past', list: past },
];
---
<BaseLayout title="My bookings | YEONON" description="Your YEONON bookings." noindex>
  <div class="container-page max-w-3xl! pt-8 pb-16 md:pt-12 md:pb-24">
    <h1 class="t-display">Bookings</h1>
    {all.length === 0 ? (
      <EmptyState class="mt-8" title="No meetups yet" body="Find a route for your days in Seoul. Pick a time, and your local friend replies."
        action={{ href: '/for-you', label: 'Find my route' }} />
    ) : (
      groups.map((g) => (
        <section class="mt-10" aria-labelledby={`g-${g.id}`}>
          <h2 id={`g-${g.id}`} class="t-title">{g.title} <span class="t-num text-stone">{g.list.length}</span></h2>
          {g.list.length === 0 ? (
            <p class="t-body mt-3 text-stone">{g.id === 'upcoming' ? 'Nothing coming up. ' : 'No past bookings yet.'}{g.id === 'upcoming' && <a href="/for-you" class="font-semibold text-on-blue hover:underline hover:underline-offset-4">Find a route</a>}</p>
          ) : (
            <ul class="mt-4 divide-y divide-hairline overflow-hidden rounded-card border border-hairline bg-paper">
              {g.list.map((b) => {
                const left = b.status === 'pending' && b.respond_by && new Date(b.respond_by).getTime() > now ? timeLeft(b.respond_by, now, 'en') : null;
                return (
                  <li>
                    <a href={`/bookings/${b.id}`} class="flex items-center gap-4 p-3 pr-4 transition-colors hover:bg-concrete md:p-4">
                      <RoutePhoto path={covers.get(b.route_id)} alt="" stops={stopNames.get(b.route_id) ?? []} ratio="1 / 1"
                        sizes="72px" class="w-16 shrink-0 rounded-control md:w-[72px]" />
                      <span class="w-12 shrink-0 text-center" aria-hidden="true">
                        <span class="t-caption block text-stone uppercase">{kstDate(b.starts_at, 'en-US', { month: 'short' })}</span>
                        <span class="t-num block text-[1.75rem] leading-8">{kstDate(b.starts_at, 'en-US', { day: 'numeric' })}</span>
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="t-heading block truncate">{b.route_title}</span>
                        <span class="t-small block font-normal text-stone">
                          <span class="sr-only">{kstDate(b.starts_at, 'en-US', { month: 'long', day: 'numeric' })}, </span>
                          {kstDate(b.starts_at, 'en-US', { weekday: 'short' })} {kstTime(b.starts_at)} KST · {b.party_size} {b.party_size === 1 ? 'person' : 'people'}
                        </span>
                        {left && <span class="t-caption mt-0.5 block font-normal text-status-wait">{left} left to reply</span>}
                        <span class="mt-1.5 block sm:hidden"><StatusBadge status={b.status} /></span>
                      </span>
                      <span class="hidden shrink-0 sm:block"><StatusBadge status={b.status} /></span>
                      <Icon name="chevron-right" class="size-5 shrink-0 text-stone" />
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      ))
    )}
  </div>
</BaseLayout>
