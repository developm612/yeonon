---
/**
 * 공개 루트 둘러보기 (누구나). 검수를 통과해 공개된 루트만 보인다 — DB RLS가 거른다.
 * 지기 이름은 일부만(public_jigis 뷰), 연락처는 보이지 않는다. 태그 필터는 ?tag=<취향 id>.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { INTERESTS, interestNames, isInterestId } from '../../data/interests';
import { areaName } from '../../data/routeOptions';
import { fmtDuration, stopEmoji } from '../../lib/course';
import { dbError } from '../../lib/forms';
import { ROUTE_COLUMNS, kstDate, won, type PublicJigi, type RouteRow } from '../../lib/routes';
import { createSupabaseServerClient, isAuthConfigured, isMemberUiPublic } from '../../lib/supabase';

export const prerender = false;

const supabase = Astro.locals.supabase ?? (isAuthConfigured ? createSupabaseServerClient(Astro.request, Astro.cookies) : null);
const tagParam = Astro.url.searchParams.get('tag') ?? '';
const tag = isInterestId(tagParam) ? tagParam : null;

let routes: RouteRow[] = [];
const emojis = new Map<string, string>();
const nextSlot = new Map<string, string>();
const hosts = new Map<string, PublicJigi>();
if (supabase) {
  let query = supabase.from('routes').select(ROUTE_COLUMNS).eq('status', 'published').order('published_at', { ascending: false }).limit(60);
  if (tag) query = query.contains('tags', [tag]);
  const { data, error } = await query;
  dbError(error, 'list public routes');
  routes = (data ?? []) as RouteRow[];
  const ids = routes.map((r) => r.id);
  if (ids.length) {
    const [{ data: stops }, { data: slots }, { data: jigis }] = await Promise.all([
      supabase.from('route_stops').select('route_id, order_no, tags').in('route_id', ids).order('order_no'),
      supabase.from('slots').select('route_id, starts_at').in('route_id', ids).eq('status', 'open').gt('starts_at', new Date().toISOString()).order('starts_at').limit(1000),
      supabase.from('public_jigis').select('*').in('user_id', [...new Set(routes.map((r) => r.jigi_id))]),
    ]);
    for (const s of stops ?? []) emojis.set(s.route_id, (emojis.get(s.route_id) ?? '') + stopEmoji(s.tags));
    for (const s of slots ?? []) if (!nextSlot.has(s.route_id)) nextSlot.set(s.route_id, s.starts_at);
    for (const j of (jigis ?? []) as PublicJigi[]) hosts.set(j.user_id, j);
  }
}
---
<BaseLayout title="Routes in Seongsu | YEONON" description="Browse small-group routes in Seongsu, made by local friends (jigi) who know the neighborhood." sticky="none" noindex={!isMemberUiPublic}>
  <section class="section pt-10! md:pt-14!">
    <div class="container-page">
      <p class="eyebrow">Routes</p>
      <h1 class="mt-3 text-3xl font-extrabold md:text-4xl">Seongsu, the way locals walk it</h1>
      <p class="mt-3 max-w-2xl text-muted">Every route is made by a local friend — a <i>jigi</i> — and reviewed by YEONON before it goes live. Times are in Korea time (KST).</p>

      <nav aria-label="Filter by interest" class="mt-8 -mx-5 overflow-x-auto px-5 md:mx-0 md:px-0">
        <ul class="flex gap-2 pb-1 md:flex-wrap">
          <li><a href="/routes" aria-current={!tag ? 'page' : undefined} class:list={['inline-flex min-h-10 items-center rounded-full border px-4 text-sm font-semibold whitespace-nowrap', !tag ? 'border-text bg-text text-white' : 'border-border bg-surface hover:border-text']}>All</a></li>
          {INTERESTS.map((it) => (
            <li>
              <a href={`/routes?tag=${it.id}`} aria-current={tag === it.id ? 'page' : undefined}
                class:list={['inline-flex min-h-10 items-center gap-1.5 rounded-full border px-4 text-sm font-semibold whitespace-nowrap', tag === it.id ? 'border-text bg-text text-white' : 'border-border bg-surface hover:border-text']}
              ><span aria-hidden="true">{it.emoji}</span>{it.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      {routes.length === 0 ? (
        <div class="card mt-8 p-8 text-center md:p-12">
          <p class="text-4xl" aria-hidden="true">🗺️</p>
          <h2 class="mt-3 text-lg font-bold">{tag ? 'No routes with this interest yet' : 'Our first routes are on the way'}</h2>
          <p class="mt-2 text-muted">Local friends in Seongsu are building their routes right now. Check back soon.</p>
          <a href={tag ? '/routes' : '/app-preview'} class="mt-6 inline-flex min-h-11 items-center rounded-full bg-traveler-strong px-5 font-semibold text-white hover:bg-[#134FB0]">{tag ? 'See all routes' : 'Try the app preview'}</a>
        </div>
      ) : (
        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {routes.map((r) => (
            <li>
              <a href={`/routes/${r.id}`} class="card group flex h-full flex-col overflow-hidden transition-shadow hover:shadow-lg">
                <div class="flex h-[96px] items-end bg-gradient-to-br from-jigi to-jigi-strong p-4 text-white">
                  <p class="text-[26px] tracking-[6px]" aria-hidden="true">{emojis.get(r.id)}</p>
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <h2 class="text-lg leading-snug font-extrabold group-hover:underline">{r.title}</h2>
                  <p class="mt-1 text-sm text-muted">{r.summary}</p>
                  <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Interests">
                    {interestNames(r.tags, 'en').map((name) => <li class="rounded-full bg-jigi-soft px-2.5 py-1 text-xs font-semibold text-jigi-strong">{name}</li>)}
                  </ul>
                  <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
                    <span class="inline-flex items-center gap-1"><Icon name="user" class="size-[14px]" /> {hosts.get(r.jigi_id)?.display_name ?? 'Jigi'}</span>
                    <span>{fmtDuration(r.duration_minutes, 'en')}</span>
                    <span>{areaName(r.area, 'en')}</span>
                    <span>Up to {r.max_party_size}</span>
                  </p>
                  <div class="mt-auto flex items-end justify-between gap-3 pt-4">
                    <p class="text-sm font-semibold text-jigi-strong">
                      {nextSlot.has(r.id) ? `Next: ${kstDate(nextSlot.get(r.id)!, 'en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false })}` : 'No open times yet'}
                    </p>
                    <p class="font-bold">{won(r.list_price)}</p>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
