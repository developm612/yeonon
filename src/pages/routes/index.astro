---
/**
 * 공개 루트 둘러보기 (누구나). 검수를 통과해 공개된 루트만 보인다 — DB RLS가 거른다.
 * 지기 이름은 일부만(public_jigis 뷰), 연락처는 보이지 않는다. 태그 필터는 ?tag=<취향 id>.
 * 카드는 성수 라인 RouteCard (가격은 카드에 두지 않고 상세에서).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import RouteCard from '../../components/ui/RouteCard.astro';
import { INTERESTS, isInterestId } from '../../data/interests';
import { interestIcon } from '../../data/stopKinds';
import { loadRouteCards, type RouteCardData } from '../../lib/routeCards';
import { createSupabaseServerClient, isAuthConfigured, isMemberUiPublic } from '../../lib/supabase';

export const prerender = false;

const supabase = Astro.locals.supabase ?? (isAuthConfigured ? createSupabaseServerClient(Astro.request, Astro.cookies) : null);
const tagParam = Astro.url.searchParams.get('tag') ?? '';
const tag = isInterestId(tagParam) ? tagParam : null;
const cards: RouteCardData[] = supabase ? await loadRouteCards(supabase, { tag }) : [];
const chip = 'inline-flex min-h-11 items-center gap-2 rounded-full border px-4 text-[0.9375rem] font-semibold whitespace-nowrap transition-colors';
---
<BaseLayout title="Routes in Seongsu | YEONON" description="Browse small-group routes in Seongsu, made by local friends (jigi) who know the neighborhood." sticky="none" noindex={!isMemberUiPublic}>
  <section class="pt-8 pb-16 md:pt-12 md:pb-24">
    <div class="container-page">
      <h1 class="t-display">Seongsu, the way locals walk it</h1>
      <p class="t-body measure mt-3 text-stone">Every route is made by a local friend (jigi) and reviewed by YEONON before it goes live. Times are in Korea time (KST).</p>

      <nav aria-label="Filter by interest" class="-mx-4 mt-8 overflow-x-auto px-4 md:mx-0 md:px-0">
        <ul class="flex gap-2 pb-1 md:flex-wrap">
          <li><a href="/routes" aria-current={!tag ? 'page' : undefined} class:list={[chip, !tag ? 'border-on-blue bg-on-blue text-white' : 'border-hairline bg-paper hover:border-ink']}>All</a></li>
          {INTERESTS.map((it) => (
            <li>
              <a href={`/routes?tag=${it.id}`} aria-current={tag === it.id ? 'page' : undefined}
                class:list={[chip, tag === it.id ? 'border-on-blue bg-on-blue text-white' : 'border-hairline bg-paper hover:border-ink']}>
                <Icon name={interestIcon(it.id)} class="size-[18px]" />{it.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {cards.length === 0 ? (
        <EmptyState class="mt-8"
          title={tag ? 'No routes with this interest yet' : 'Our first routes are on the way'}
          body={tag ? 'Local friends add new routes every week. See every route in Seongsu for now.' : 'Local friends in Seongsu are building their routes right now. Try the app preview while you wait.'}
          action={tag ? { href: '/routes', label: 'See all routes' } : { href: '/app-preview', label: 'Try the app preview' }} />
      ) : (
        <>
        <h2 class="sr-only">{tag ? `${cards.length} routes` : 'All routes'}</h2>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {cards.map((c, i) => (
            <li>
              <RouteCard href={`/routes/${c.id}`} title={c.title} photo={c.photo} stops={c.stops} durationMinutes={c.durationMinutes}
                area={c.area} host={c.host} slots={c.slots} slotCount={c.slotCount} eager={i < 3} />
            </li>
          ))}
        </ul>
        </>
      )}
    </div>
  </section>
</BaseLayout>
