---
/**
 * 루트 상세 (누구나). 코스 타임라인, 지기(이름 일부만), 앞으로 4주 예약 가능한 시간 — 본문은 components/routes/RouteDetail.astro.
 * 공개 루트가 아니면 루트 주인(지기)과 관리자에게만 '미리보기'로 보인다 — 읽기 권한은 DB RLS가 정한다.
 * 매칭 요청(Request this route)은 여행자 영역 /app/routes/[id]에서 한다. 비회원은 로그인 후 같은 루트로 돌아온다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RouteDetail from '../../components/routes/RouteDetail.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import UiButton from '../../components/ui/UiButton.astro';
import { loadPublicReviews, type PublicReview } from '../../lib/reviews';
import { ROUTE_STATUS } from '../../data/routeOptions';
import { loadRoute, type PublicJigi, type SlotRow } from '../../lib/routes';
import { isOnboarded } from '../../lib/profile';
import { createSupabaseServerClient, isAuthConfigured, isMemberUiPublic } from '../../lib/supabase';

export const prerender = false;

const { user, profile } = Astro.locals;
const supabase = Astro.locals.supabase ?? (isAuthConfigured ? createSupabaseServerClient(Astro.request, Astro.cookies) : null);
const loaded = supabase ? await loadRoute(supabase, Astro.params.id ?? '') : null;
if (!loaded) Astro.response.status = 404;

let host: PublicJigi | null = null;
let slots: SlotRow[] = [];
let reviews: PublicReview[] = [];
if (loaded && supabase) {
  const [{ data: j }, { data: s }, rv] = await Promise.all([
    supabase.from('public_jigis').select('*').eq('user_id', loaded.route.jigi_id).maybeSingle(),
    supabase.from('slots').select('id, route_id, starts_at, ends_at, status').eq('route_id', loaded.route.id).eq('status', 'open')
      .gt('starts_at', new Date().toISOString()).order('starts_at').limit(200),
    loadPublicReviews(supabase, loaded.route.jigi_id),
  ]);
  reviews = rv;
  host = (j as PublicJigi | null) ?? null;
  slots = (s ?? []) as SlotRow[];
}

const route = loaded?.route;
const isPreview = route && route.status !== 'published';
const here = Astro.url.pathname;
const canRequest = profile?.role === 'traveler' && isOnboarded(profile) && profile.status === 'active';
---
<BaseLayout
  title={route ? `${route.title} | YEONON` : 'Route not found | YEONON'}
  description={route?.summary ?? 'This route is not available.'}
  sticky="none"
  noindex={!route || isPreview || !isMemberUiPublic}
  tabBar={!route}
  bottomBar={Boolean(route)}
>
  {!route ? (
    <section class="pt-10 pb-16 md:pt-16">
      <div class="container-page max-w-xl!">
        <EmptyState title="This route isn't available" body="It may have been taken down, or the link is wrong. Browse other routes in Seongsu."
          action={{ href: '/routes', label: 'Browse routes' }} />
      </div>
    </section>
  ) : (
    <>
      {isPreview && (
        <p lang="ko" class="bg-ink py-3 text-center text-sm font-semibold text-white">
          미리보기 · {ROUTE_STATUS[route.status].label} — 여행자에게는 아직 보이지 않아요.
          {profile?.id === route.jigi_id && <a href="/partner/routes" class="ml-2 underline underline-offset-4">내 루트로</a>}
          {profile?.role === 'admin' && <a href={`/admin/routes?status=${route.status}#route-${route.id}`} class="ml-2 underline underline-offset-4">검수 화면으로</a>}
        </p>
      )}
      <RouteDetail route={route} stops={loaded!.stops} host={host} slots={slots} reviews={reviews} backHref="/routes" backLabel="All routes"
        barLabel={isPreview ? 'Open times' : !user ? 'Sign in to request' : canRequest ? 'Request' : 'Open times'}>
        <Fragment slot="cta">
          {!isPreview && (
            !user ? (
              <UiButton href={`/login?next=${encodeURIComponent(here)}`} full class="mt-5">Sign in to request</UiButton>
            ) : !profile || !isOnboarded(profile) ? (
              <UiButton href={`/onboarding?next=${encodeURIComponent(here)}`} full class="mt-5">Finish signing up</UiButton>
            ) : canRequest ? (
              <UiButton href={`/app/routes/${route.id}`} full class="mt-5">Request this route</UiButton>
            ) : null
          )}
          {!isPreview && !user && <p class="t-caption mt-2 text-center font-normal text-stone">Sign in, pick a time, and your jigi replies. You'll come back to this route.</p>}
        </Fragment>
      </RouteDetail>
    </>
  )}
</BaseLayout>
