---
/**
 * 루트 상세 (여행자 영역). 코스 타임라인, 지기 공개 프로필, 가능 시간 칩 — 본문은 components/routes/RouteDetail.astro.
 * 추천 결과에서 왔으면(?rec=추천 id) 클릭을 기록하고(record_recommendation_click, 첫 클릭만), 결과로 돌아가는 링크를 둔다.
 * Request this route: 시간 칩 선택 → 인원·메모 → /api/bookings/request (슬롯 잠금·예약은 DB 함수 하나).
 *   가격은 booking_quote()로 이 여행자에게 적용될 할인을 보여 준다 (예: ₩45,000 → ₩0 · Early member).
 *   스크립트가 없어도 폼 전송으로 동작한다 (실패하면 ?error=코드 로 돌아온다).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaNav from '../../../components/account/AreaNav.astro';
import Notice from '../../../components/account/Notice.astro';
import RouteDetail from '../../../components/routes/RouteDetail.astro';
import { TRAVELER_NAV } from '../../../data/accountNav';
import { priceText } from '../../../data/bookingOptions';
import { BOOKING_ERRORS, BOOKING_NOTE_MAX, bookingMessage, fmtMinutes, loadBookingSettings, type BookingErrorCode } from '../../../lib/bookings';
import { dbError } from '../../../lib/forms';
import { readInput, toQuery } from '../../../lib/recommend/input';
import { loadRoute, UUID, type PublicJigi, type SlotRow } from '../../../lib/routes';

export const prerender = false;

const { supabase, profile } = Astro.locals;
if (!supabase) return Astro.redirect('/login');

const loaded = await loadRoute(supabase, Astro.params.id ?? '');
// 여행자 영역에서는 공개 루트만 (지기·관리자 미리보기는 /routes/[id])
const route = loaded?.route.status === 'published' ? loaded.route : null;
if (!route) Astro.response.status = 404;

const rec = Astro.url.searchParams.get('rec') ?? '';
let host: PublicJigi | null = null;
let slots: SlotRow[] = [];
let backHref = '/app/discover';
let backLabel = 'Discover';
interface Quote { list_price: number; discount_rate: number; final_price: number; promotion_name: string | null }
let quote: Quote | null = null as Quote | null;
let pendingCount = 0;
const settings = await loadBookingSettings(supabase);
if (route) {
  // 시작 N분(설정값) 전까지만 요청할 수 있으므로 그보다 이른 시간은 보여 주지 않는다
  const earliest = new Date(Date.now() + settings.min_lead_minutes * 60_000).toISOString();
  const [{ data: j }, { data: s }, recRow, q, pend] = await Promise.all([
    supabase.from('public_jigis').select('*').eq('user_id', route.jigi_id).maybeSingle(),
    supabase.from('slots').select('id, route_id, starts_at, ends_at, status').eq('route_id', route.id).eq('status', 'open')
      .gt('starts_at', earliest).order('starts_at').limit(200),
    UUID.test(rec)
      ? supabase.from('recommendation_requests').select('id, input').eq('id', rec).maybeSingle()
      : Promise.resolve({ data: null }),
    supabase.rpc('booking_quote', { p_route: route.id }),
    profile ? supabase.from('bookings').select('id', { count: 'exact', head: true }).eq('traveler_id', profile.id).eq('status', 'pending') : Promise.resolve({ count: 0 }),
  ]);
  host = (j as PublicJigi | null) ?? null;
  slots = (s ?? []) as SlotRow[];
  dbError(q.error, 'booking quote');
  quote = ((q.data as Quote[] | null) ?? [])[0] ?? null;
  pendingCount = pend.count ?? 0;
  if (recRow.data) {
    const { error } = await supabase.rpc('record_recommendation_click', { p_id: rec, p_route: route.id });
    dbError(error, 'record recommendation click');
    const input = recRow.data.input as Record<string, unknown>;
    backHref = `/app/discover/results?${toQuery(readInput((k) => input[k]))}`;
    backLabel = 'Back to my matches';
  }
}

const price = quote ? priceText(quote.list_price, quote.final_price, quote.promotion_name) : null;
const errCode = Astro.url.searchParams.get('error') ?? '';
const formError = errCode in BOOKING_ERRORS
  ? bookingMessage(errCode as BookingErrorCode, 'en', { max: settings.max_pending_per_traveler })
  : null;
const atLimit = pendingCount >= settings.max_pending_per_traveler;
const here = Astro.url.pathname + (UUID.test(rec) ? `?rec=${rec}` : '');
const partyMax = route?.max_party_size ?? 1;
---
<BaseLayout
  title={route ? `${route.title} | YEONON` : 'Route not found | YEONON'}
  description={route?.summary ?? 'This route is not available.'}
  sticky="none"
  noindex
>
  <AreaNav items={TRAVELER_NAV} label="Traveler menu" lang="en" />
  {!route ? (
    <section class="section">
      <div class="container-page max-w-xl! text-center">
        <p class="text-4xl" aria-hidden="true">🧭</p>
        <h1 class="mt-3 text-2xl font-extrabold">This route isn't available</h1>
        <p class="mt-2 text-muted">It may have been taken down, or the link is wrong.</p>
        <a href="/app/discover" class="mt-6 inline-flex min-h-11 items-center rounded-full bg-traveler-strong px-5 font-semibold text-white hover:bg-[#134FB0]">Find my route</a>
      </div>
    </section>
  ) : (
    <RouteDetail route={route} stops={loaded!.stops} host={host} slots={slots} backHref={backHref} backLabel={backLabel}
      pickForm={slots.length ? 'request-form' : undefined} priceLabel={price ?? undefined}>
      <Fragment slot="cta">
        {slots.length > 0 && (
          <form id="request-form" method="post" action="/api/bookings/request" class="mt-5 space-y-4 border-t border-border pt-5" novalidate data-request-form>
            <input type="hidden" name="route_id" value={route.id} />
            <input type="hidden" name="next" value={here} />
            {UUID.test(rec) && <input type="hidden" name="recommendation_id" value={rec} />}

            {price && (
              <p class="flex flex-wrap items-baseline justify-between gap-x-3">
                <span class="text-sm font-semibold text-muted">Price</span>
                <span class="font-bold">
                  {quote!.final_price < quote!.list_price && <span class="mr-1 font-normal text-muted line-through">₩{quote!.list_price.toLocaleString('en-US')}</span>}
                  {quote!.final_price < quote!.list_price ? `₩${quote!.final_price.toLocaleString('en-US')}` : price}
                  {quote!.promotion_name && quote!.final_price < quote!.list_price && <span class="ml-1.5 rounded-full bg-traveler-soft px-2 py-0.5 text-xs font-bold text-traveler-strong">{quote!.promotion_name}</span>}
                </span>
              </p>
            )}

            <p class="rounded-xl bg-bg px-3 py-2 text-sm" data-picked aria-live="polite">Pick a time above.</p>

            <label class="block text-sm font-semibold">Group size
              <select name="party_size" class="mt-1 block h-11 w-full rounded-xl border border-border bg-surface px-3 text-[0.9375rem] font-normal">
                {Array.from({ length: partyMax }, (_, i) => i + 1).map((n) => <option value={n} selected={n === Math.min(2, partyMax) || undefined}>{n} {n === 1 ? 'person' : 'people'}</option>)}
              </select>
            </label>

            <label class="block text-sm font-semibold">Note to your jigi <span class="font-normal text-muted">(optional)</span>
              <textarea name="note" rows="3" maxlength={BOOKING_NOTE_MAX} placeholder="What are you most excited about? Any dietary needs or mobility notes?"
                class="mt-1 block w-full rounded-xl border border-border bg-surface px-3 py-2 text-[0.9375rem] font-normal" data-note></textarea>
              <span class="mt-1 block text-xs font-normal text-muted">Contact details (email, phone, social handles, links) are removed. You'll chat in YEONON once matched.</span>
            </label>

            {atLimit && <Notice>You already have {pendingCount} requests waiting for a reply — the most you can have at once. Wait for an answer or cancel one in Bookings.</Notice>}
            <p role="alert" class:list={['rounded-xl bg-[#FDECEC] px-4 py-3 text-sm font-medium text-[#8A1C1C]', !formError && 'hidden']} data-error>{formError}</p>
            <div class="hidden rounded-xl border border-border p-3" data-alternatives>
              <p class="text-sm font-semibold">Other open times</p>
              <div class="mt-2 flex flex-wrap gap-1.5" data-alt-list></div>
            </div>

            <button type="submit" class="flex h-[52px] w-full items-center justify-center rounded-full bg-traveler-strong font-semibold text-white hover:bg-[#134FB0] disabled:opacity-60" data-submit>
              Request this route
            </button>
            <p class="text-center text-xs text-muted">
              Your jigi replies within {fmtMinutes(settings.respond_minutes, 'en')} ({fmtMinutes(settings.urgent_respond_minutes, 'en')} for meetups in the next {fmtMinutes(settings.urgent_window_minutes, 'en')}).
              {quote && quote.final_price === 0 ? ' No payment needed.' : ' No payment in the app yet.'}
            </p>
          </form>
        )}
      </Fragment>
    </RouteDetail>
  )}
</BaseLayout>

<script>
  import { kstWhen } from '../../../data/bookingOptions';

  const form = document.querySelector<HTMLFormElement>('[data-request-form]');
  if (form) {
    const picked = form.querySelector<HTMLElement>('[data-picked]')!;
    const errorBox = form.querySelector<HTMLElement>('[data-error]')!;
    const altBox = form.querySelector<HTMLElement>('[data-alternatives]')!;
    const altList = form.querySelector<HTMLElement>('[data-alt-list]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const radios = () => [...document.querySelectorAll<HTMLInputElement>('input[name="slot_id"]')];
    const showError = (msg: string | null) => {
      errorBox.textContent = msg ?? '';
      errorBox.classList.toggle('hidden', !msg);
    };
    const syncPicked = () => {
      const r = radios().find((x) => x.checked);
      picked.textContent = r ? `Selected: ${r.dataset.label} (KST)` : 'Pick a time above.';
    };
    document.addEventListener('change', (e) => {
      if ((e.target as HTMLElement).matches?.('input[name="slot_id"]')) {
        syncPicked();
        showError(null);
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const slot = String(fd.get('slot_id') ?? '');
      if (!slot) {
        showError('Pick a time first.');
        document.querySelector<HTMLElement>('[data-slot-picker]')?.scrollIntoView({ block: 'center' });
        return;
      }
      submit.disabled = true;
      showError(null);
      altBox.classList.add('hidden');
      try {
        const res = await fetch('/api/bookings/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(fd)),
        });
        const data = (await res.json().catch(() => ({}))) as {
          id?: string;
          message?: string;
          error?: string;
          alternatives?: { id: string; starts_at: string }[];
        };
        if (res.ok && data.id) {
          location.href = `/app/bookings/${data.id}?notice=requested`;
          return;
        }
        showError(data.message ?? 'Something went wrong. Please try again.');
        if (data.error === 'slot_taken' || data.error === 'slot_not_found' || data.error === 'too_soon') {
          // 방금 마감된 칩은 고를 수 없게 하고, 같은 루트의 다른 시간을 보여 준다
          const taken = radios().find((x) => x.value === slot);
          if (taken) {
            taken.checked = false;
            taken.disabled = true;
          }
          syncPicked();
          const alts = (data.alternatives ?? []).filter((a) => radios().some((x) => x.value === a.id && !x.disabled));
          altList.replaceChildren(
            ...alts.map((a) => {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'rounded-full border border-traveler-strong px-3 py-1.5 text-sm font-semibold text-traveler-strong tabular-nums hover:bg-traveler-soft';
              b.textContent = kstWhen(a.starts_at, 'en');
              b.addEventListener('click', () => {
                const r = radios().find((x) => x.value === a.id);
                if (r) {
                  r.checked = true;
                  r.dispatchEvent(new Event('change', { bubbles: true }));
                  r.closest('label')?.scrollIntoView({ block: 'nearest' });
                }
              });
              return b;
            }),
          );
          altBox.classList.toggle('hidden', alts.length === 0);
        }
      } catch {
        showError('Connection problem. Please try again.');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
