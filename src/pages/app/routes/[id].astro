---
/**
 * 루트 상세 (여행자 영역). 코스 타임라인, 지기 공개 프로필, 가능 시간 칩 — 본문은 components/routes/RouteDetail.astro.
 * 추천 결과에서 왔으면(?rec=추천 id) 클릭을 기록하고(record_recommendation_click, 첫 클릭만), 결과로 돌아가는 링크를 둔다.
 * "Request this route"는 Phase 5(예약) 전까지 비활성 + Coming soon.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AreaNav from '../../../components/account/AreaNav.astro';
import RouteDetail from '../../../components/routes/RouteDetail.astro';
import { TRAVELER_NAV } from '../../../data/accountNav';
import { dbError } from '../../../lib/forms';
import { readInput, toQuery } from '../../../lib/recommend/input';
import { loadRoute, UUID, type PublicJigi, type SlotRow } from '../../../lib/routes';

export const prerender = false;

const { supabase } = Astro.locals;
if (!supabase) return Astro.redirect('/login');

const loaded = await loadRoute(supabase, Astro.params.id ?? '');
// 여행자 영역에서는 공개 루트만 (지기·관리자 미리보기는 /routes/[id])
const route = loaded?.route.status === 'published' ? loaded.route : null;
if (!route) Astro.response.status = 404;

let host: PublicJigi | null = null;
let slots: SlotRow[] = [];
let backHref = '/app/discover';
let backLabel = 'Discover';
if (route) {
  const rec = Astro.url.searchParams.get('rec') ?? '';
  const [{ data: j }, { data: s }, recRow] = await Promise.all([
    supabase.from('public_jigis').select('*').eq('user_id', route.jigi_id).maybeSingle(),
    supabase.from('slots').select('id, route_id, starts_at, ends_at, status').eq('route_id', route.id).eq('status', 'open')
      .gt('starts_at', new Date().toISOString()).order('starts_at').limit(200),
    UUID.test(rec)
      ? supabase.from('recommendation_requests').select('id, input').eq('id', rec).maybeSingle()
      : Promise.resolve({ data: null }),
  ]);
  host = (j as PublicJigi | null) ?? null;
  slots = (s ?? []) as SlotRow[];
  if (recRow.data) {
    const { error } = await supabase.rpc('record_recommendation_click', { p_id: rec, p_route: route.id });
    dbError(error, 'record recommendation click');
    const input = recRow.data.input as Record<string, unknown>;
    backHref = `/app/discover/results?${toQuery(readInput((k) => input[k]))}`;
    backLabel = 'Back to my matches';
  }
}
---
<BaseLayout
  title={route ? `${route.title} | YEONON` : 'Route not found | YEONON'}
  description={route?.summary ?? 'This route is not available.'}
  sticky="none"
  noindex
>
  <AreaNav items={TRAVELER_NAV} label="Traveler menu" lang="en" />
  {!route ? (
    <section class="section">
      <div class="container-page max-w-xl! text-center">
        <p class="text-4xl" aria-hidden="true">🧭</p>
        <h1 class="mt-3 text-2xl font-extrabold">This route isn't available</h1>
        <p class="mt-2 text-muted">It may have been taken down, or the link is wrong.</p>
        <a href="/app/discover" class="mt-6 inline-flex min-h-11 items-center rounded-full bg-traveler-strong px-5 font-semibold text-white hover:bg-[#134FB0]">Find my route</a>
      </div>
    </section>
  ) : (
    <RouteDetail route={route} stops={loaded!.stops} host={host} slots={slots} backHref={backHref} backLabel={backLabel}>
      <Fragment slot="cta">
        <button type="button" disabled aria-describedby="request-soon"
          class="mt-5 flex h-[52px] w-full cursor-not-allowed items-center justify-center gap-2 rounded-full bg-traveler-strong font-semibold text-white opacity-60">
          Request this route
          <span class="rounded-full bg-white/25 px-2 py-0.5 text-xs font-bold">Coming soon</span>
        </button>
        <p id="request-soon" class="mt-2 text-center text-xs text-muted">Requests open soon — we're testing with our first local friends.</p>
      </Fragment>
    </RouteDetail>
  )}
</BaseLayout>
