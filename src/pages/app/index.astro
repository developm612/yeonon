---
/**
 * 여행자 홈 (yeonon-traveler-ui-plan.md 5-1). 할 일 순서대로 쌓는다:
 *   다가오는 만남(확정) → 답을 기다리는 요청 → 새 루트 찾기 → 둘러보기(Explore Seongsu)
 * 로그아웃은 프로필 화면 맨 아래로 옮겼다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import RouteCard from '../../components/ui/RouteCard.astro';
import RouteLine from '../../components/ui/RouteLine.astro';
import RoutePhoto from '../../components/ui/RoutePhoto.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import UiButton from '../../components/ui/UiButton.astro';
import { kstWhen, timeLeft } from '../../data/bookingOptions';
import { interestNames } from '../../data/interests';
import { interestIcon } from '../../data/stopKinds';
import { BOOKING_COLUMNS, type BookingRow } from '../../lib/bookings';
import { conversationIdForBooking } from '../../lib/chat';
import { dbError } from '../../lib/forms';
import { loadRouteCards, type RouteCardData } from '../../lib/routeCards';

export const prerender = false;
const { profile, supabase } = Astro.locals;

let active: BookingRow[] = [];
let explore: RouteCardData[] = [];
let next: BookingRow | null = null;
let nextPhoto: string | null = null;
let nextStops: string[] = [];
let nextChat: string | null = null;
if (profile && supabase) {
  const { data, error } = await supabase.from('bookings').select(BOOKING_COLUMNS).eq('traveler_id', profile.id)
    .in('status', ['pending', 'confirmed']).gt('ends_at', new Date().toISOString()).order('starts_at').limit(10);
  dbError(error, 'load traveler home bookings');
  active = (data ?? []) as BookingRow[];
  next = active.find((b) => b.status === 'confirmed') ?? null;
  const [cards, route, stops, chat] = await Promise.all([
    loadRouteCards(supabase, { limit: 5 }),
    next ? supabase.from('routes').select('cover_photo').eq('id', next.route_id).maybeSingle() : Promise.resolve({ data: null }),
    next ? supabase.from('route_stops').select('place_name, order_no').eq('route_id', next.route_id).order('order_no') : Promise.resolve({ data: null }),
    next ? conversationIdForBooking(supabase, next.id) : Promise.resolve(null),
  ]);
  explore = cards;
  nextPhoto = (route.data?.cover_photo as string | null | undefined) ?? null;
  nextStops = (stops.data ?? []).map((s) => s.place_name as string);
  nextChat = chat;
}
const waiting = active.filter((b) => b.status === 'pending');
const firstName = profile?.display_name?.split(' ')[0] ?? 'there';
const interests = profile?.interests ?? [];
const now = Date.now();
const people = (n: number) => `${n} ${n === 1 ? 'person' : 'people'}`;
---
<BaseLayout title="My YEONON" description="Your YEONON home." sticky="none" noindex>
  <div class="container-page max-w-3xl! pt-8 pb-16 md:pt-12 md:pb-24">
    <h1 class="t-display">Hi, {firstName}</h1>

    {next && (
      <section class="mt-8" aria-labelledby="h-next">
        <h2 id="h-next" class="t-title">Your next meetup</h2>
        <article class="mt-4 overflow-hidden rounded-card border border-hairline bg-paper">
          <RoutePhoto path={nextPhoto} alt="" stops={nextStops} ratio="16 / 9" sizes="(min-width: 768px) 720px, 100vw" eager />
          <div class="p-5 md:p-6">
            <p class="t-num text-[1.125rem] text-ink">{kstWhen(next.starts_at, 'en')} <span class="t-small font-normal text-stone">KST</span></p>
            <h3 class="t-heading mt-1">{next.route_title}</h3>
            <p class="t-small mt-0.5 font-normal text-stone">with {next.jigi_name ?? 'your jigi'} · {people(next.party_size)}</p>
            <div class="mt-5 flex items-center gap-4">
              <RouteLine variant="status" current={1} bare class="min-w-0 flex-1" label="Step 2 of 4: Confirmed" />
              <StatusBadge status="confirmed" />
            </div>
            <div class="mt-5 flex flex-wrap gap-3">
              {nextChat && <UiButton href={`/app/messages/${nextChat}`}>Open chat</UiButton>}
              <UiButton variant="secondary" href={`/app/bookings/${next.id}`}>Details</UiButton>
            </div>
          </div>
        </article>
      </section>
    )}

    {waiting.length > 0 && (
      <section class="mt-10" aria-labelledby="h-wait">
        <h2 id="h-wait" class="t-title">Waiting for a reply <span class="t-num text-stone">({waiting.length})</span></h2>
        <ul class="mt-4 divide-y divide-hairline overflow-hidden rounded-card border border-hairline bg-paper">
          {waiting.map((b) => {
            const left = b.respond_by && new Date(b.respond_by).getTime() > now ? timeLeft(b.respond_by, now, 'en') : null;
            return (
              <li>
                <a href={`/app/bookings/${b.id}`} class="flex items-center gap-4 px-4 py-4 transition-colors hover:bg-concrete md:px-5">
                  <span class="min-w-0 flex-1">
                    <span class="t-heading block truncate">{b.route_title}</span>
                    <span class="t-small block font-normal text-stone">{kstWhen(b.starts_at, 'en')} KST · {left ? `${left} left to reply` : 'Reply time is up'}</span>
                  </span>
                  <StatusBadge status="pending" />
                  <Icon name="chevron-right" class="size-5 shrink-0 text-stone" />
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="mt-10 rounded-card border border-hairline bg-paper p-5 md:p-7" aria-labelledby="h-find">
      <h2 id="h-find" class="t-title">Find a route for your days in Seoul</h2>
      <p class="t-body measure mt-2 text-stone">Pick what you love and when you're here. We'll match you with routes local friends made in Seongsu, and tell you why each one fits.</p>
      {interests.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Your interests">
          {interestNames(interests, 'en').map((name, i) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-hairline px-3 py-1.5 text-[0.875rem] leading-none font-semibold">
              <Icon name={interestIcon(interests[i])} class="size-4 text-stone" />{name}
            </li>
          ))}
        </ul>
      )}
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <UiButton href="/app/discover">Find my route</UiButton>
        {interests.length === 0 && <UiButton variant="text" href="/app/profile">Add your interests</UiButton>}
      </div>
    </section>

    {explore.length > 0 && (
      <section class="mt-12" aria-labelledby="h-explore">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="h-explore" class="t-title">Explore Seongsu</h2>
          <UiButton variant="text" href="/routes">All routes</UiButton>
        </div>
        <ul class="-mx-4 mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 md:mx-0 md:px-0">
          {explore.map((c) => (
            <li class="w-[78%] max-w-[300px] shrink-0 snap-start sm:w-[300px]">
              <RouteCard href={`/app/routes/${c.id}`} title={c.title} photo={c.photo} stops={c.stops} durationMinutes={c.durationMinutes}
                area={c.area} host={c.host} slots={c.slots} slotCount={c.slotCount} chips={1} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
