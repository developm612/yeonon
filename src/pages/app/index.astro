---
/** 여행자 홈: 다가오는 만남, 진행 중 요청, Find my route */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaNav from '../../components/account/AreaNav.astro';
import { TRAVELER_NAV } from '../../data/accountNav';
import { BOOKING_STATUS, STATUS_TONE_CLASS, kstWhen } from '../../data/bookingOptions';
import { BOOKING_COLUMNS, type BookingRow } from '../../lib/bookings';
import { dbError } from '../../lib/forms';

export const prerender = false;
const { profile, supabase } = Astro.locals;

let active: BookingRow[] = [];
if (profile && supabase) {
  const { data, error } = await supabase.from('bookings').select(BOOKING_COLUMNS).eq('traveler_id', profile.id)
    .in('status', ['pending', 'confirmed']).gt('ends_at', new Date().toISOString()).order('starts_at').limit(10);
  dbError(error, 'load traveler home bookings');
  active = (data ?? []) as BookingRow[];
}
---
<BaseLayout title="My YEONON" description="Your YEONON home." sticky="none" noindex>
  <AreaNav items={TRAVELER_NAV} label="Traveler menu" lang="en" />
  <section class="section pt-10! md:pt-14!">
    <div class="container-page max-w-2xl!">
      <p class="eyebrow">Traveler</p>
      <h1 class="mt-3 text-3xl font-extrabold">Hi, {profile?.display_name}</h1>

      {active.length > 0 && (
        <div class="mt-8">
          <h2 class="font-bold">Your meetups & requests</h2>
          <ul class="mt-3 space-y-3">
            {active.map((b) => (
              <li>
                <a href={`/app/bookings/${b.id}`} class="card block p-4 transition-colors hover:border-text md:p-5">
                  <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-bold', STATUS_TONE_CLASS[BOOKING_STATUS[b.status].tone]]}>{BOOKING_STATUS[b.status].en}</span>
                  <p class="mt-2 font-bold">{b.route_title}</p>
                  <p class="mt-0.5 text-sm text-muted tabular-nums">{kstWhen(b.starts_at, 'en')} KST · {b.party_size} {b.party_size === 1 ? 'person' : 'people'}</p>
                </a>
              </li>
            ))}
          </ul>
          <a href="/app/bookings" class="mt-3 inline-block text-sm font-semibold text-traveler-strong underline underline-offset-2">All bookings</a>
        </div>
      )}

      <div class="card mt-8 p-6 md:p-8">
        <h2 class="text-lg font-bold">Find a route that fits you</h2>
        <p class="mt-2 text-muted">
          Pick what you love and when you're in Seoul. We'll recommend routes made by local friends (jigi) in Seongsu — and tell you why each one fits.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/app/discover" class="inline-flex min-h-11 items-center rounded-full bg-traveler-strong px-5 font-semibold text-white hover:bg-[#134FB0]">Find my route</a>
          <a href="/routes" class="inline-flex min-h-11 items-center rounded-full border border-border bg-surface px-5 font-semibold hover:border-text">Browse routes</a>
          <a href="/app/profile" class="inline-flex min-h-11 items-center rounded-full px-5 font-semibold text-muted hover:bg-text/5">Edit my profile</a>
        </div>
      </div>
      <form method="post" action="/auth/signout" class="mt-8">
        <button type="submit" class="text-sm font-semibold text-muted underline underline-offset-2 hover:text-text">Sign out</button>
      </form>
    </div>
  </section>
</BaseLayout>
