---
/**
 * 지기 신청 심사: 상태별 목록, 신청서 전체 보기, 인터뷰/승인/보류/반려 + 신원 확인 체크 + 메모.
 * 변경은 DB 함수 review_jigi_application으로만 한다 (승인 시 지기 프로필 생성, audit_log 기록, 신원 확인 없이는 승인 불가).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaNav from '../../components/account/AreaNav.astro';
import ExportForm from '../../components/admin/ExportForm.astro';
import Notice from '../../components/account/Notice.astro';
import { ADMIN_NAV } from '../../data/accountNav';
import { interestNames } from '../../data/interests';
import { APPLICATION_STATUS, APPLICATION_STATUSES, type ApplicationStatus } from '../../data/jigiStatus';
import { dbError, field, notice } from '../../lib/forms';
import { clean } from '../../scripts/formSafety';

export const prerender = false;

const { supabase } = Astro.locals;
if (!supabase) return Astro.redirect('/login');

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
const isStatus = (v: string): v is ApplicationStatus => (APPLICATION_STATUSES as string[]).includes(v);

let error: string | null = null;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const id = field(fd, 'id');
  const next = field(fd, 'status');
  if (!UUID.test(id) || !isStatus(next)) error = '잘못된 요청이에요.';
  else {
    const { error: rpcError } = await supabase.rpc('review_jigi_application', {
      p_id: id,
      p_status: next,
      p_id_verified: field(fd, 'id_verified') === 'yes',
      p_memo: clean(field(fd, 'memo'), 1000),
    });
    if (!dbError(rpcError, 'review jigi application')) {
      const back = new URL(Astro.url);
      back.searchParams.set('notice', 'saved');
      return Astro.redirect(back.pathname + back.search + `#app-${id}`);
    }
    error = /verified/.test(rpcError!.message) ? '신원 확인을 체크해야 승인할 수 있어요.' : '저장하지 못했어요. 다시 시도해 주세요.';
  }
}

const tab = Astro.url.searchParams.get('status') ?? 'submitted';
const current = isStatus(tab) ? tab : 'submitted';

const [{ data, error: listError }, ...counts] = await Promise.all([
  supabase
    .from('jigi_applications')
    .select('*, profiles!jigi_applications_user_id_fkey(display_name, email)')
    .eq('status', current)
    .order('created_at', { ascending: true })
    .limit(100),
  ...APPLICATION_STATUSES.map((s) => supabase.from('jigi_applications').select('*', { count: 'exact', head: true }).eq('status', s)),
]);
dbError(listError, 'admin list jigi applications');
const apps = data ?? [];
// 심사 메모는 관리자 전용 테이블에 따로 있다 (신청자는 자기 신청서 행을 읽을 수 있으므로)
const { data: notes } = apps.length
  ? await supabase.from('jigi_application_notes').select('application_id, memo').in('application_id', apps.map((a) => a.id))
  : { data: [] };
const memoOf = new Map((notes ?? []).map((n) => [n.application_id as string, n.memo as string]));
const saved = notice(Astro.url, { saved: '심사 결과를 저장했어요.' });
const date = (iso: string) => new Date(iso).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', dateStyle: 'medium', timeStyle: 'short' });
---
<BaseLayout title="지기 신청 | 관리자 | YEONON" description="연온 관리자 지기 신청 심사" lang="ko" sticky="none" noindex>
  <AreaNav items={ADMIN_NAV} label="관리자 메뉴" />
  <section class="section pt-10! md:pt-14!">
    <div class="container-page">
      <h1 class="text-3xl font-extrabold">지기 신청 심사</h1>
      <ExportForm list="jigi_applications" filters={{ status: current }} class="mt-4" />

      <nav aria-label="신청 상태" class="mt-6 flex flex-wrap gap-2">
        {APPLICATION_STATUSES.map((s, i) => (
          <a
            href={`?status=${s}`}
            aria-current={s === current ? 'page' : undefined}
            class:list={['rounded-full border px-4 py-2 text-sm font-semibold', s === current ? 'border-text bg-text text-white' : 'border-border bg-surface hover:border-text']}
          >{APPLICATION_STATUS[s].label} <span class="tabular-nums opacity-70">{counts[i].count ?? 0}</span></a>
        ))}
      </nav>

      {saved && <Notice class="mt-6">{saved}</Notice>}
      {error && <Notice tone="error" class="mt-6">{error}</Notice>}

      <ul class="mt-6 space-y-4">
        {apps.length === 0 && <li class="card p-6 text-center text-muted">이 상태의 신청서가 없어요.</li>}
        {apps.map((a) => (
          <li id={`app-${a.id}`} class="card scroll-mt-24 p-5 md:p-6">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="text-lg font-bold">{a.name}</h2>
              <p class="text-sm text-muted">{a.profiles?.display_name} · {a.profiles?.email}</p>
              <p class="ml-auto text-sm text-muted">신청 {date(a.created_at)}</p>
            </div>
            <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm md:grid-cols-2">
              <div><dt class="inline text-muted">휴대폰 </dt><dd class="inline font-medium">{a.phone}</dd></div>
              <div><dt class="inline text-muted">나이대 </dt><dd class="inline">{a.age_group}</dd></div>
              <div><dt class="inline text-muted">성수동과의 관계 </dt><dd class="inline">{a.seongsu_relation}</dd></div>
              <div><dt class="inline text-muted">외국어 </dt><dd class="inline">{a.languages.join(', ')}</dd></div>
              <div><dt class="inline text-muted">활동 시간 </dt><dd class="inline">{a.availability_note}</dd></div>
              <div><dt class="inline text-muted">취향 </dt><dd class="inline">{interestNames(a.taste, 'ko').join(', ')}</dd></div>
              <div><dt class="inline text-muted">인스타그램 </dt><dd class="inline">{a.instagram || '-'}</dd></div>
              <div><dt class="inline text-muted">알게 된 경로 </dt><dd class="inline">{a.heard_from}{a.referred_by && ` (추천인: ${a.referred_by})`}</dd></div>
              <div class="md:col-span-2"><dt class="text-muted">자기소개</dt><dd class="mt-0.5 whitespace-pre-line">{a.intro}</dd></div>
              {a.sample_course && <div class="md:col-span-2"><dt class="text-muted">추천 코스</dt><dd class="mt-0.5 whitespace-pre-line">{a.sample_course}</dd></div>}
              {a.reviewed_at && <div class="md:col-span-2 text-muted">최근 검토 {date(a.reviewed_at)}</div>}
            </dl>

            <form method="post" class="mt-5 grid gap-3 border-t border-border pt-5 md:grid-cols-[auto_auto_1fr_auto] md:items-end">
              <input type="hidden" name="id" value={a.id} />
              <div>
                <label for={`st-${a.id}`} class="block text-sm font-semibold">상태</label>
                <select id={`st-${a.id}`} name="status" class="mt-1 h-11 rounded-xl border border-border bg-surface px-3 text-sm">
                  {APPLICATION_STATUSES.map((s) => <option value={s} selected={s === a.status || undefined}>{APPLICATION_STATUS[s].label}</option>)}
                </select>
              </div>
              <label class="flex h-11 cursor-pointer items-center gap-2 text-sm font-semibold">
                <input type="checkbox" name="id_verified" value="yes" class="size-[18px] accent-jigi-strong" checked={a.id_verified || undefined} />
                신원 확인 완료
              </label>
              <div>
                <label for={`memo-${a.id}`} class="block text-sm font-semibold">심사 메모 <span class="font-normal text-muted">(신청자에게 보이지 않음)</span></label>
                <input id={`memo-${a.id}`} name="memo" type="text" maxlength="1000" value={memoOf.get(a.id) ?? ''} class="mt-1 h-11 w-full rounded-xl border border-border bg-surface px-3 text-sm" />
              </div>
              <button type="submit" class="h-11 rounded-xl bg-text px-5 text-sm font-semibold text-white">저장</button>
            </form>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
