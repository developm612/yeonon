---
/**
 * 관리자 회원 목록: 검색·필터, 정지/해제(사유 기록), 메모.
 * 변경은 DB 함수(admin_set_user_status, admin_set_user_memo)로만 하고, 함수가 audit_log에 기록한다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaNav from '../../components/account/AreaNav.astro';
import ExportForm from '../../components/admin/ExportForm.astro';
import Notice from '../../components/account/Notice.astro';
import { ADMIN_NAV } from '../../data/accountNav';
import { interestNames } from '../../data/interests';
import { dbError, field, notice } from '../../lib/forms';
import type { Profile } from '../../lib/profile';
import { clean } from '../../scripts/formSafety';

export const prerender = false;

const { supabase, profile: me } = Astro.locals;
if (!supabase || !me) return Astro.redirect('/login');

const PAGE_SIZE = 30;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
const ROLE_LABEL: Record<string, string> = { traveler: '여행자', jigi: '지기', admin: '관리자', none: '온보딩 전' };
const STATUS_LABEL: Record<string, string> = { active: '활성', suspended: '정지', deleted: '삭제' };

let error: string | null = null;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const user = field(fd, 'user');
  const action = field(fd, 'action');
  if (!UUID.test(user)) error = '잘못된 요청이에요.';
  else {
    const { error: rpcError } =
      action === 'memo'
        ? await supabase.rpc('admin_set_user_memo', { p_user: user, p_memo: clean(field(fd, 'memo'), 1000) })
        : await supabase.rpc('admin_set_user_status', {
            p_user: user,
            p_status: action === 'suspend' ? 'suspended' : 'active',
            p_reason: clean(field(fd, 'reason'), 300),
          });
    if (!dbError(rpcError, `admin users ${action}`)) {
      // 같은 검색 조건으로 돌아간다
      const back = new URL(Astro.url);
      back.searchParams.set('notice', action === 'memo' ? 'memo' : 'status');
      return Astro.redirect(back.pathname + back.search);
    }
    error = /own status|another admin/.test(rpcError!.message) ? '본인이나 다른 관리자의 상태는 바꿀 수 없어요.' : '저장하지 못했어요. 다시 시도해 주세요.';
  }
}

// 검색어는 PostgREST 필터 문법 문자( , ( ) * % \ )를 빼고 쓴다
const q = clean(Astro.url.searchParams.get('q') ?? '', 50).replace(/[,()*%\\]/g, '');
const role = Astro.url.searchParams.get('role') ?? '';
const status = Astro.url.searchParams.get('status') ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

let query = supabase
  .from('profiles')
  .select('id, role, display_name, email, status, nationality, languages, interests, marketing_opt_in, terms_agreed_at, created_at', { count: 'exact' })
  .order('created_at', { ascending: false })
  .range((page - 1) * PAGE_SIZE, page * PAGE_SIZE - 1);
if (q) query = query.or(`email.ilike.%${q}%,display_name.ilike.%${q}%`);
if (role === 'none') query = query.is('role', null);
else if (role in ROLE_LABEL) query = query.eq('role', role);
if (status in STATUS_LABEL) query = query.eq('status', status);

const { data, count, error: listError } = await query;
dbError(listError, 'admin list users');
const users = (data ?? []) as Profile[];
const { data: notes } = users.length
  ? await supabase.from('admin_notes').select('user_id, memo').in('user_id', users.map((u) => u.id))
  : { data: [] };
const memoOf = new Map((notes ?? []).map((n) => [n.user_id as string, n.memo as string]));
const pages = Math.max(1, Math.ceil((count ?? 0) / PAGE_SIZE));
const pageHref = (p: number) => {
  const u = new URL(Astro.url);
  u.searchParams.set('page', String(p));
  u.searchParams.delete('notice');
  return u.pathname + u.search;
};
const saved = notice(Astro.url, { memo: '메모를 저장했어요.', status: '회원 상태를 바꿨어요.' });
const date = (iso: string) => new Date(iso).toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul' });
const input = 'h-11 rounded-xl border border-border bg-surface px-3 text-sm';
---
<BaseLayout title="회원 | 관리자 | YEONON" description="연온 관리자 회원 관리" lang="ko" sticky="none" noindex>
  <AreaNav items={ADMIN_NAV} label="관리자 메뉴" />
  <section class="section pt-10! md:pt-14!">
    <div class="container-page">
      <h1 class="text-3xl font-extrabold">회원 <span class="text-lg font-semibold text-muted tabular-nums">{count ?? 0}명</span></h1>
      <ExportForm list="users" filters={{ q, role, status }} class="mt-4" />

      <form method="get" class="mt-6 flex flex-wrap gap-2" role="search">
        <label class="sr-only" for="u-q">이름·이메일 검색</label>
        <input id="u-q" name="q" type="search" value={q} placeholder="이름·이메일" class={`${input} min-w-0 flex-1 basis-48`} />
        <label class="sr-only" for="u-role">역할</label>
        <select id="u-role" name="role" class={input}>
          <option value="">모든 역할</option>
          {Object.entries(ROLE_LABEL).map(([v, l]) => <option value={v} selected={role === v || undefined}>{l}</option>)}
        </select>
        <label class="sr-only" for="u-status">상태</label>
        <select id="u-status" name="status" class={input}>
          <option value="">모든 상태</option>
          {Object.entries(STATUS_LABEL).map(([v, l]) => <option value={v} selected={status === v || undefined}>{l}</option>)}
        </select>
        <button type="submit" class="h-11 rounded-xl bg-text px-4 text-sm font-semibold text-white">검색</button>
      </form>

      {saved && <Notice class="mt-6">{saved}</Notice>}
      {error && <Notice tone="error" class="mt-6">{error}</Notice>}

      <ul class="mt-6 space-y-3">
        {users.length === 0 && <li class="card p-6 text-center text-muted">조건에 맞는 회원이 없어요.</li>}
        {users.map((u) => (
          <li class="card p-5">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <p class="font-bold">{u.display_name || '(이름 없음)'}</p>
              <span class="rounded-full bg-bg px-2.5 py-0.5 text-xs font-semibold">{ROLE_LABEL[u.role ?? 'none']}</span>
              {u.status !== 'active' && <span class="rounded-full bg-[#FDECEC] px-2.5 py-0.5 text-xs font-semibold text-[#8A1C1C]">{STATUS_LABEL[u.status]}</span>}
              <p class="text-sm text-muted">{u.email}</p>
              <p class="ml-auto text-sm text-muted">가입 {date(u.created_at)}</p>
            </div>
            <details class="mt-3">
              <summary class="cursor-pointer text-sm font-semibold text-brand">자세히 · 관리</summary>
              <dl class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
                <div><dt class="inline text-muted">국적 </dt><dd class="inline">{u.nationality || '-'}</dd></div>
                <div><dt class="inline text-muted">언어 </dt><dd class="inline">{u.languages.join(', ') || '-'}</dd></div>
                <div><dt class="inline text-muted">관심사 </dt><dd class="inline">{interestNames(u.interests, 'ko').join(', ') || '-'}</dd></div>
                <div><dt class="inline text-muted">마케팅 수신 </dt><dd class="inline">{u.marketing_opt_in ? '동의' : '-'}</dd></div>
                <div><dt class="inline text-muted">약관 동의 </dt><dd class="inline">{u.terms_agreed_at ? date(u.terms_agreed_at) : '-'}</dd></div>
              </dl>
              <div class="mt-4 grid gap-4 md:grid-cols-2">
                <form method="post" class="space-y-2">
                  <input type="hidden" name="user" value={u.id} />
                  <input type="hidden" name="action" value="memo" />
                  <label class="text-sm font-semibold" for={`memo-${u.id}`}>관리자 메모 <span class="font-normal text-muted">(회원에게 보이지 않음)</span></label>
                  <textarea id={`memo-${u.id}`} name="memo" rows="2" maxlength="1000" class="block w-full rounded-xl border border-border p-3 text-sm">{memoOf.get(u.id) ?? ''}</textarea>
                  <button type="submit" class="h-10 rounded-xl border border-border px-4 text-sm font-semibold hover:border-text">메모 저장</button>
                </form>
                {u.role !== 'admin' && u.id !== me.id && (
                  <form method="post" class="space-y-2">
                    <input type="hidden" name="user" value={u.id} />
                    <input type="hidden" name="action" value={u.status === 'suspended' ? 'activate' : 'suspend'} />
                    <label class="text-sm font-semibold" for={`reason-${u.id}`}>{u.status === 'suspended' ? '정지 해제' : '이용 정지'} 사유</label>
                    <input id={`reason-${u.id}`} name="reason" type="text" maxlength="300" class={`${input} block w-full`} />
                    <button type="submit" class:list={['h-10 rounded-xl px-4 text-sm font-semibold text-white', u.status === 'suspended' ? 'bg-jigi-strong' : 'bg-[#B42318]']}>
                      {u.status === 'suspended' ? '정지 해제' : '이용 정지'}
                    </button>
                  </form>
                )}
              </div>
            </details>
          </li>
        ))}
      </ul>

      {pages > 1 && (
        <nav aria-label="페이지" class="mt-6 flex items-center justify-center gap-3 text-sm">
          {page > 1 && <a href={pageHref(page - 1)} class="rounded-full border border-border px-4 py-2 font-semibold">이전</a>}
          <span class="tabular-nums text-muted">{page} / {pages}</span>
          {page < pages && <a href={pageHref(page + 1)} class="rounded-full border border-border px-4 py-2 font-semibold">다음</a>}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>
