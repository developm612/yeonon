---
/**
 * 관리자 회원 목록: 검색·필터, 정지/해제(사유 기록), 메모.
 * 회원 한 명 = 한 줄. 줄을 누르면 세부 정보와 관리(메모·정지)가 펼쳐진다. 저장 후에는 그 회원 줄을 펼친 채로 돌아온다(?open=).
 * 변경은 DB 함수(admin_set_user_status, admin_set_user_memo, admin_set_admin)로만 하고, 함수가 audit_log에 기록한다.
 * 관리자 권한 주기: 활성 여행자·온보딩 전 회원에게만 (지기·진행 중 예약이 있는 회원은 DB 함수가 막는다).
 * 관리자 권한 거두기: 이 화면에서 권한을 준 관리자만 (SQL로 지정한 처음 관리자와 본인은 거둘 수 없다). — 마이그레이션 21번
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaNav from '../../components/account/AreaNav.astro';
import Icon from '../../components/Icon.astro';
import ExportForm from '../../components/admin/ExportForm.astro';
import Notice from '../../components/account/Notice.astro';
import { ADMIN_NAV } from '../../data/accountNav';
import { interestNames } from '../../data/interests';
import { dbError, field, notice } from '../../lib/forms';
import type { Profile } from '../../lib/profile';
import { clean } from '../../scripts/formSafety';

export const prerender = false;

const { supabase, profile: me } = Astro.locals;
if (!supabase || !me) return Astro.redirect('/login');

const PAGE_SIZE = 30;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
const ROLE_LABEL: Record<string, string> = { traveler: '여행자', jigi: '지기', admin: '관리자', none: '온보딩 전' };
const STATUS_LABEL: Record<string, string> = { active: '활성', suspended: '정지', deleted: '삭제' };

let error: string | null = null;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const user = field(fd, 'user');
  const action = field(fd, 'action');
  if (!UUID.test(user)) error = '잘못된 요청이에요.';
  else {
    const isAdminAction = action === 'grant_admin' || action === 'revoke_admin';
    const confirmed = field(fd, 'confirm') === 'yes';
    const { error: rpcError } = isAdminAction && !confirmed
      ? { error: { message: 'not confirmed' } }
      : action === 'memo'
        ? await supabase.rpc('admin_set_user_memo', { p_user: user, p_memo: clean(field(fd, 'memo'), 1000) })
        : isAdminAction
          ? await supabase.rpc('admin_set_admin', { p_user: user, p_grant: action === 'grant_admin', p_reason: clean(field(fd, 'admin_reason'), 300) })
          : await supabase.rpc('admin_set_user_status', {
              p_user: user,
              p_status: action === 'suspend' ? 'suspended' : 'active',
              p_reason: clean(field(fd, 'reason'), 300),
            });
    if (!rpcError || (rpcError.message !== 'not confirmed' && !dbError(rpcError, `admin users ${action}`))) {
      // 같은 검색 조건으로 돌아간다
      const back = new URL(Astro.url);
      back.searchParams.set('notice', action === 'memo' ? 'memo' : action === 'grant_admin' ? 'granted' : action === 'revoke_admin' ? 'revoked' : 'status');
      back.searchParams.set('open', user);
      return Astro.redirect(back.pathname + back.search);
    }
    const m = rpcError!.message;
    error = m === 'not confirmed' ? '확인 칸에 체크해 주세요.'
      : /own status|own role/.test(m) ? '본인의 상태·권한은 바꿀 수 없어요.'
      : /another admin/.test(m) ? '다른 관리자의 상태는 바꿀 수 없어요. 먼저 관리자 권한을 거둬 주세요.'
      : /jigi cannot be admin/.test(m) ? '지기 계정은 관리자로 바꿀 수 없어요. 지기 활동(루트·예약)이 끊기기 때문이에요. 관리자용 계정을 따로 만들어 주세요.'
      : /has active bookings/.test(m) ? '진행 중(대기·확정)인 예약이 있는 여행자는 관리자로 바꿀 수 없어요. 예약이 끝난 뒤에 다시 해 주세요.'
      : /user not active/.test(m) ? '정지되었거나 탈퇴한 회원에게는 관리자 권한을 줄 수 없어요.'
      : /already admin/.test(m) ? '이미 관리자예요.'
      : /original admin/.test(m) ? '처음부터 지정된 관리자(운영 계정)는 화면에서 권한을 거둘 수 없어요.'
      : /not admin/.test(m) ? '관리자가 아닌 회원이에요.'
      : /admin_set_admin/.test(m) ? '관리자 권한 기능을 쓰려면 Supabase에서 SQL 21번을 먼저 실행해 주세요.'
      : '저장하지 못했어요. 다시 시도해 주세요.';
  }
}

// 검색어는 PostgREST 필터 문법 문자( , ( ) * % \ )를 빼고 쓴다
const q = clean(Astro.url.searchParams.get('q') ?? '', 50).replace(/[,()*%\\]/g, '');
const role = Astro.url.searchParams.get('role') ?? '';
const status = Astro.url.searchParams.get('status') ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

let query = supabase
  .from('profiles')
  .select('id, role, display_name, email, status, nationality, languages, interests, marketing_opt_in, terms_agreed_at, created_at', { count: 'exact' })
  .order('created_at', { ascending: false })
  .range((page - 1) * PAGE_SIZE, page * PAGE_SIZE - 1);
if (q) query = query.or(`email.ilike.%${q}%,display_name.ilike.%${q}%`);
if (role === 'none') query = query.is('role', null);
else if (role in ROLE_LABEL) query = query.eq('role', role);
if (status in STATUS_LABEL) query = query.eq('status', status);

const { data, count, error: listError } = await query;
dbError(listError, 'admin list users');
const users = (data ?? []) as Profile[];
const { data: notes } = users.length
  ? await supabase.from('admin_notes').select('user_id, memo').in('user_id', users.map((u) => u.id))
  : { data: [] };
const memoOf = new Map((notes ?? []).map((n) => [n.user_id as string, n.memo as string]));
// 이 화면에서 권한을 받은 관리자 (거둘 수 있음) — 마지막 'user.set_admin' 기록이 '주기'인 관리자
const adminIds = users.filter((u) => u.role === 'admin').map((u) => u.id);
const grantedAdmins = new Set<string>();
if (adminIds.length) {
  const { data: logs } = await supabase.from('audit_log').select('target_id, detail, created_at')
    .eq('action', 'user.set_admin').in('target_id', adminIds).order('created_at', { ascending: false });
  const seen = new Set<string>();
  for (const l of logs ?? []) {
    if (seen.has(l.target_id)) continue;
    seen.add(l.target_id);
    if ((l.detail as { to?: string })?.to === 'admin') grantedAdmins.add(l.target_id);
  }
}
const pages = Math.max(1, Math.ceil((count ?? 0) / PAGE_SIZE));
const pageHref = (p: number) => {
  const u = new URL(Astro.url);
  u.searchParams.set('page', String(p));
  u.searchParams.delete('notice');
  u.searchParams.delete('open');
  return u.pathname + u.search;
};
const saved = notice(Astro.url, {
  memo: '메모를 저장했어요.',
  status: '회원 상태를 바꿨어요.',
  granted: '관리자 권한을 줬어요. 그 회원이 다시 로그인하거나 새로고침하면 관리자 화면(/admin)이 열려요.',
  revoked: '관리자 권한을 거뒀어요. 권한을 받기 전 역할로 돌아갔어요.',
});
const openId = Astro.url.searchParams.get('open');
const date = (iso: string) => new Date(iso).toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul' });
const input = 'h-11 rounded-xl border border-border bg-surface px-3 text-sm';
---
<BaseLayout title="회원 | 관리자 | YEONON" description="연온 관리자 회원 관리" lang="ko" noindex>
  <AreaNav items={ADMIN_NAV} label="관리자 메뉴" />
  <section class="section pt-10! md:pt-14!">
    <div class="container-page">
      <h1 class="text-3xl font-extrabold">회원 <span class="text-lg font-semibold text-muted tabular-nums">{count ?? 0}명</span></h1>
      <ExportForm list="users" filters={{ q, role, status }} class="mt-4" />

      <form method="get" class="mt-6 flex flex-wrap gap-2" role="search">
        <label class="sr-only" for="u-q">이름·이메일 검색</label>
        <input id="u-q" name="q" type="search" value={q} placeholder="이름·이메일" class={`${input} min-w-0 flex-1 basis-48`} />
        <label class="sr-only" for="u-role">역할</label>
        <select id="u-role" name="role" class={input}>
          <option value="">모든 역할</option>
          {Object.entries(ROLE_LABEL).map(([v, l]) => <option value={v} selected={role === v || undefined}>{l}</option>)}
        </select>
        <label class="sr-only" for="u-status">상태</label>
        <select id="u-status" name="status" class={input}>
          <option value="">모든 상태</option>
          {Object.entries(STATUS_LABEL).map(([v, l]) => <option value={v} selected={status === v || undefined}>{l}</option>)}
        </select>
        <button type="submit" class="h-11 rounded-xl bg-text px-4 text-sm font-semibold text-white">검색</button>
      </form>

      {saved && <Notice class="mt-6">{saved}</Notice>}
      {error && <Notice tone="error" class="mt-6">{error}</Notice>}

      {users.length === 0 ? (
        <p class="card mt-6 p-6 text-center text-muted">조건에 맞는 회원이 없어요.</p>
      ) : (
        <div class="card mt-6 overflow-hidden">
          <!-- 열 제목 (넓은 화면) -->
          <div class="hidden grid-cols-[minmax(0,1.3fr)_4.5rem_minmax(0,2fr)_minmax(0,1fr)_6.5rem_1.25rem] gap-3 border-b border-border bg-bg px-4 py-2 text-xs font-semibold text-muted md:grid" aria-hidden="true">
            <span>이름</span><span>역할</span><span>이메일</span><span>국적</span><span>가입일</span><span></span>
          </div>
          <ul class="divide-y divide-border">
            {users.map((u) => (
              <li>
                <details class="group" open={u.id === openId || undefined}>
                  <summary class="grid cursor-pointer list-none grid-cols-[minmax(0,1fr)_auto_auto_1.25rem] items-center gap-3 px-4 py-2.5 text-sm hover:bg-text/[0.03] md:grid-cols-[minmax(0,1.3fr)_4.5rem_minmax(0,2fr)_minmax(0,1fr)_6.5rem_1.25rem] [&::-webkit-details-marker]:hidden">
                    <span class="flex min-w-0 items-center gap-2">
                      <span class="truncate font-semibold">{u.display_name || '(이름 없음)'}</span>
                      {u.status !== 'active' && <span class="shrink-0 rounded-full bg-[#FDECEC] px-2 py-0.5 text-xs font-semibold text-[#8A1C1C]">{STATUS_LABEL[u.status]}</span>}
                    </span>
                    <span class="justify-self-start rounded-full bg-bg px-2 py-0.5 text-xs font-semibold whitespace-nowrap">{ROLE_LABEL[u.role ?? 'none']}</span>
                    <span class="hidden truncate text-muted md:block">{u.email}</span>
                    <span class="hidden truncate text-muted md:block">{u.nationality || '-'}</span>
                    <span class="text-muted tabular-nums whitespace-nowrap">{date(u.created_at)}</span>
                    <Icon name="chevron-right" class="size-4 text-muted transition-transform group-open:rotate-90" />
                  </summary>
                  <div class="border-t border-border bg-bg/60 px-4 py-4">
                    <dl class="grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2 lg:grid-cols-3">
                      <div class="md:hidden"><dt class="inline text-muted">이메일 </dt><dd class="inline break-all">{u.email}</dd></div>
                      <div class="md:hidden"><dt class="inline text-muted">국적 </dt><dd class="inline">{u.nationality || '-'}</dd></div>
                      <div><dt class="inline text-muted">언어 </dt><dd class="inline">{u.languages.join(', ') || '-'}</dd></div>
                      <div><dt class="inline text-muted">관심사 </dt><dd class="inline">{interestNames(u.interests, 'ko').join(', ') || '-'}</dd></div>
                      <div><dt class="inline text-muted">마케팅 수신 </dt><dd class="inline">{u.marketing_opt_in ? '동의' : '-'}</dd></div>
                      <div><dt class="inline text-muted">약관 동의 </dt><dd class="inline">{u.terms_agreed_at ? date(u.terms_agreed_at) : '-'}</dd></div>
                    </dl>
                    <div class="mt-4 grid gap-4 md:grid-cols-2">
                      <form method="post" class="space-y-2">
                        <input type="hidden" name="user" value={u.id} />
                        <input type="hidden" name="action" value="memo" />
                        <label class="text-sm font-semibold" for={`memo-${u.id}`}>관리자 메모 <span class="font-normal text-muted">(회원에게 보이지 않음)</span></label>
                        <textarea id={`memo-${u.id}`} name="memo" rows="2" maxlength="1000" class="block w-full rounded-xl border border-border bg-surface p-3 text-sm">{memoOf.get(u.id) ?? ''}</textarea>
                        <button type="submit" class="h-10 rounded-xl border border-border bg-surface px-4 text-sm font-semibold hover:border-text">메모 저장</button>
                      </form>
                      {u.role !== 'admin' && u.id !== me.id && (
                        <form method="post" class="space-y-2">
                          <input type="hidden" name="user" value={u.id} />
                          <input type="hidden" name="action" value={u.status === 'suspended' ? 'activate' : 'suspend'} />
                          <label class="text-sm font-semibold" for={`reason-${u.id}`}>{u.status === 'suspended' ? '정지 해제' : '이용 정지'} 사유</label>
                          <input id={`reason-${u.id}`} name="reason" type="text" maxlength="300" class={`${input} block w-full`} />
                          <button type="submit" class:list={['h-10 rounded-xl px-4 text-sm font-semibold text-white', u.status === 'suspended' ? 'bg-jigi-strong' : 'bg-[#B42318]']}>
                            {u.status === 'suspended' ? '정지 해제' : '이용 정지'}
                          </button>
                        </form>
                      )}
                    </div>
                    {u.id !== me.id && (u.role !== 'admin' || grantedAdmins.has(u.id)) && (
                      <form method="post" class="mt-4 space-y-2 rounded-xl border border-border bg-surface p-3.5">
                        <input type="hidden" name="user" value={u.id} />
                        <input type="hidden" name="action" value={u.role === 'admin' ? 'revoke_admin' : 'grant_admin'} />
                        <p class="text-sm font-semibold">{u.role === 'admin' ? '관리자 권한 거두기' : '관리자 권한 주기'}</p>
                        <p class="text-xs text-muted">
                          {u.role === 'admin'
                            ? '권한을 받기 전 역할(여행자 또는 온보딩 전)로 돌아가요. 기록이 남아요.'
                            : u.role === 'jigi'
                              ? '지기 계정은 관리자로 바꿀 수 없어요 (루트·예약이 끊겨요). 관리자용 계정을 따로 만들어 주세요.'
                              : '관리자는 모든 회원 정보·예약·신고·대화(신고된 것)를 볼 수 있고 회원을 정지할 수 있어요. 믿을 수 있는 운영진에게만 주세요. 기록이 남아요.'}
                        </p>
                        {!(u.role === 'jigi') && (
                          <>
                            <label class="sr-only" for={`areason-${u.id}`}>사유</label>
                            <input id={`areason-${u.id}`} name="admin_reason" type="text" maxlength="300" placeholder="사유 (예: 운영팀 합류)" class={`${input} block w-full`} />
                            <label class="flex items-center gap-2 text-sm">
                              <input type="checkbox" name="confirm" value="yes" required class="size-4" />
                              {u.role === 'admin' ? `${u.display_name || '이 회원'}님의 관리자 권한을 거둘게요.` : `${u.display_name || '이 회원'}님에게 관리자 권한을 줄게요.`}
                            </label>
                            <button type="submit" class:list={['h-10 rounded-xl px-4 text-sm font-semibold', u.role === 'admin' ? 'border border-border bg-surface text-[#B42318] hover:border-[#B42318]' : 'bg-text text-white']}>
                              {u.role === 'admin' ? '관리자 권한 거두기' : '관리자로 지정'}
                            </button>
                          </>
                        )}
                      </form>
                    )}
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      )}

      {pages > 1 && (
        <nav aria-label="페이지" class="mt-6 flex items-center justify-center gap-3 text-sm">
          {page > 1 && <a href={pageHref(page - 1)} class="rounded-full border border-border px-4 py-2 font-semibold">이전</a>}
          <span class="tabular-nums text-muted">{page} / {pages}</span>
          {page < pages && <a href={pageHref(page + 1)} class="rounded-full border border-border px-4 py-2 font-semibold">다음</a>}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>
