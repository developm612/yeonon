---
/**
 * 관리자 대시보드. 지표는 DB 함수 admin_dashboard_stats(기간) 한 번으로 읽는다 (마이그레이션 19번).
 *   맨 위: 처리 대기 신고·안전 체크 후기 (있으면 빨간색)
 *   회원: 가입 수(오늘·7일), 역할별 회원 수 / 루트: 공개 루트 수, 상태별 / 예약: 기간 안 요청·확정·완료·만료·취소·거절,
 *   수락률·평균 응답 시간('수락 후 확정' 요청 기준) / AI 추천 → 요청 전환율 / 후기 / 대기자 명단 / 지기 신청
 * 기간: ?days=0(오늘, 한국 날짜) · 7 · 30
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaNav from '../../components/account/AreaNav.astro';
import { ADMIN_NAV } from '../../data/accountNav';
import { APPLICATION_STATUS, APPLICATION_STATUSES } from '../../data/jigiStatus';
import { ROUTE_STATUS, ROUTE_STATUSES } from '../../data/routeOptions';
import { dbError } from '../../lib/forms';

export const prerender = false;

const { supabase } = Astro.locals;
if (!supabase) return Astro.redirect('/login');

const PERIODS = [
  { days: 0, label: '오늘' },
  { days: 7, label: '최근 7일' },
  { days: 30, label: '최근 30일' },
] as const;
const period = PERIODS.find((p) => String(p.days) === Astro.url.searchParams.get('days')) ?? PERIODS[1];

interface Stats {
  signups_today: number;
  signups_7d: number;
  members: { total: number; traveler: number; jigi: number; jigi_approved: number; admin: number; not_onboarded: number; suspended: number; early_member: number };
  published_routes: number;
  bookings: {
    requested: number; confirmed: number; completed: number; expired: number; cancelled: number; declined: number; late_cancels: number;
    pending_now: number; accepted_manual: number; declined_manual: number; expired_manual: number; avg_response_minutes: number | null;
  };
  open_reports: number;
  open_safety_reviews: number;
  reviews: { count: number; avg_rating: number | null };
  recommendations: { total: number; booked: number; clicked: number };
  waitlist: { total: number; invited: number; joined: number };
}

/** head: true → 행은 받지 않고 개수만 받는다 */
const count = async (table: string, column: string, value: string) => {
  const { count: n } = await supabase.from(table).select('*', { count: 'exact', head: true }).eq(column, value);
  return n ?? 0;
};
const [{ data, error }, routeCounts, appCounts, openSlots] = await Promise.all([
  supabase.rpc('admin_dashboard_stats', { p_days: period.days }),
  Promise.all(ROUTE_STATUSES.map((s) => count('routes', 'status', s))),
  Promise.all(APPLICATION_STATUSES.map((s) => count('jigi_applications', 'status', s))),
  supabase.from('slots').select('*', { count: 'exact', head: true }).eq('status', 'open').gt('starts_at', new Date().toISOString()).then((r) => r.count ?? 0),
]);
dbError(error, 'admin dashboard stats');
const st = (data ?? null) as Stats | null;

const pct = (n: number, d: number) => (d > 0 ? `${Math.round((n / d) * 100)}%` : '-');
const minutes = (m: number | null | undefined) => (m == null ? '-' : m < 60 ? `${m}분` : `${Math.floor(m / 60)}시간 ${m % 60}분`);
const b = st?.bookings;
const decided = b ? b.accepted_manual + b.declined_manual + b.expired_manual : 0;
const rec = st?.recommendations;

type Tile = { label: string; value: string | number; href?: string; hint?: string };
const memberTiles: Tile[] = st
  ? [
      { label: '오늘 가입', value: st.signups_today },
      { label: '최근 7일 가입', value: st.signups_7d },
      { label: '여행자', value: st.members.traveler, href: '/admin/users?role=traveler' },
      { label: '지기', value: st.members.jigi, href: '/admin/users?role=jigi', hint: `승인·활동 중 ${st.members.jigi_approved}` },
      { label: '관리자', value: st.members.admin, href: '/admin/users?role=admin' },
      { label: '온보딩 전', value: st.members.not_onboarded, href: '/admin/users?role=none' },
      { label: '정지', value: st.members.suspended, href: '/admin/users?status=suspended' },
      { label: '전체 회원', value: st.members.total, href: '/admin/users', hint: `얼리 멤버 ${st.members.early_member}` },
    ]
  : [];
const bookingTiles: Tile[] = b
  ? [
      { label: '요청', value: b.requested, href: '/admin/bookings?status=all' },
      { label: '확정', value: b.confirmed, href: '/admin/bookings?status=confirmed' },
      { label: '완료', value: b.completed, href: '/admin/bookings?status=completed' },
      { label: '만료', value: b.expired, href: '/admin/bookings?status=expired' },
      { label: '취소', value: b.cancelled, href: '/admin/bookings?status=cancelled', hint: b.late_cancels ? `늦은 취소 ${b.late_cancels}` : undefined },
      { label: '거절', value: b.declined, href: '/admin/bookings?status=declined' },
      { label: '지금 응답 대기', value: b.pending_now, href: '/admin/bookings?status=pending' },
      { label: '수락률', value: pct(b.accepted_manual, decided), hint: decided ? `수락 ${b.accepted_manual} · 거절 ${b.declined_manual} · 만료 ${b.expired_manual}` : '응답한 요청이 없어요' },
      { label: '평균 응답 시간', value: minutes(b.avg_response_minutes), hint: '요청 → 수락·거절' },
    ]
  : [];
const growthTiles: Tile[] = st && rec
  ? [
      { label: '공개 루트', value: st.published_routes, href: '/admin/routes?status=published', hint: `앞으로 4주 열린 시간 ${openSlots}개` },
      { label: 'AI 추천 → 요청 전환율', value: pct(rec.booked, rec.total), href: `/admin/recommendations?days=${period.days === 30 ? 30 : 7}`, hint: `추천 ${rec.total} · 클릭 ${rec.clicked} · 요청 ${rec.booked}` },
      { label: '새 후기', value: st.reviews.count, hint: st.reviews.avg_rating != null ? `평균 ★ ${Number(st.reviews.avg_rating).toFixed(1)} (여행자 → 지기)` : '여행자 → 지기 후기' },
      { label: '대기자 명단', value: st.waitlist.total, href: '/admin/waitlist', hint: `초대 표시 ${st.waitlist.invited} · 가입 연결 ${st.waitlist.joined}` },
    ]
  : [];
const alerts = st
  ? [
      { label: '처리 대기 채팅 신고', value: st.open_reports, href: '/admin/reports?status=open', action: '신고 처리하기 →' },
      { label: '안전 문제가 체크된 후기', value: st.open_safety_reviews, href: '/admin/reports?safety_status=open#safety', action: '안전 후기 확인하기 →' },
    ]
  : [];
---
<BaseLayout title="관리자 | YEONON" description="연온 관리자" lang="ko" sticky="none" noindex>
  <AreaNav items={ADMIN_NAV} label="관리자 메뉴" />
  <section class="section pt-10! md:pt-14!">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h1 class="text-3xl font-extrabold">대시보드</h1>
        <nav aria-label="기간" class="flex gap-1.5">
          {PERIODS.map((p) => (
            <a href={`?days=${p.days}`} aria-current={p.days === period.days ? 'page' : undefined}
              class:list={['inline-flex min-h-10 items-center rounded-full px-4 text-sm font-semibold', p.days === period.days ? 'bg-text text-white' : 'bg-surface text-muted shadow-card hover:text-text']}>{p.label}</a>
          ))}
        </nav>
      </div>

      {!st ? (
        <p class="mt-8 rounded-xl bg-[#FDECEC] px-4 py-3 text-sm text-[#8A1C1C]">지표를 읽지 못했어요. 마이그레이션 17~19번을 실행했는지 확인해 주세요.</p>
      ) : (
        <>
          <ul class="mt-8 grid gap-3 md:grid-cols-2">
            {alerts.map((a) => (
              <li>
                <a href={a.href} class:list={['card flex h-full items-center justify-between gap-4 p-5 transition-colors hover:border-text', a.value > 0 && 'border-[#B42318]']}>
                  <span>
                    <span class="block text-sm text-muted">{a.label}</span>
                    <span class:list={['mt-1 block text-3xl font-extrabold tabular-nums', a.value > 0 && 'text-[#B42318]']}>{a.value}</span>
                  </span>
                  <span class="text-sm font-semibold">{a.action}</span>
                </a>
              </li>
            ))}
          </ul>

          {[
            { title: '회원', note: '', tiles: memberTiles, cols: 'lg:grid-cols-4' },
            { title: '예약', note: `${period.label} · 수락률·응답 시간은 '수락 후 확정' 요청 기준`, tiles: bookingTiles, cols: 'lg:grid-cols-5' },
            { title: '루트 · 추천 · 후기', note: period.label, tiles: growthTiles, cols: 'lg:grid-cols-4' },
          ].map((group) => (
            <>
              <h2 class="mt-10 font-bold">{group.title} {group.note && <span class="font-normal text-muted">· {group.note}</span>}</h2>
              <ul class:list={['mt-3 grid grid-cols-2 gap-3 md:grid-cols-3', group.cols]}>
                {group.tiles.map((t) => (
                  <li>
                    {t.href ? (
                      <a href={t.href} class="card block h-full p-5 transition-colors hover:border-text">
                        <p class="text-sm text-muted">{t.label}</p>
                        <p class="mt-1 text-3xl font-extrabold tabular-nums">{t.value}</p>
                        {t.hint && <p class="mt-1 text-xs text-muted">{t.hint}</p>}
                      </a>
                    ) : (
                      <div class="card h-full p-5">
                        <p class="text-sm text-muted">{t.label}</p>
                        <p class="mt-1 text-3xl font-extrabold tabular-nums">{t.value}</p>
                        {t.hint && <p class="mt-1 text-xs text-muted">{t.hint}</p>}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </>
          ))}
        </>
      )}

      <h2 class="mt-10 font-bold">지기 신청</h2>
      <ul class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-5">
        {APPLICATION_STATUSES.map((s, i) => (
          <li>
            <a href={`/admin/jigi-applications?status=${s}`} class="card block p-5 transition-colors hover:border-text">
              <p class="text-sm text-muted">{APPLICATION_STATUS[s].label}</p>
              <p class="mt-1 text-3xl font-extrabold tabular-nums">{appCounts[i]}</p>
            </a>
          </li>
        ))}
      </ul>

      <h2 class="mt-10 font-bold">루트 상태</h2>
      <ul class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-5">
        {ROUTE_STATUSES.map((s, i) => (
          <li>
            <a href={`/admin/routes?status=${s}`} class="card block p-5 transition-colors hover:border-text">
              <p class="text-sm text-muted">{ROUTE_STATUS[s].label}</p>
              <p class="mt-1 text-3xl font-extrabold tabular-nums">{routeCounts[i]}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
