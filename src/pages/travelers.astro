---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StepTimeline from '../components/StepTimeline.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { SITE, travelerForm } from '../config/site';

const activities = [
  { title: 'Hidden cafés & bakeries', icon: 'coffee' },
  { title: 'Local eats', body: 'Where Seongsu actually eats', icon: 'bowl' },
  { title: 'Pop-up stores', body: '— and how to get in', icon: 'store' },
  { title: 'Fashion & design shops', icon: 'shirt' },
  { title: 'Photo walks', icon: 'camera' },
  { title: 'Workshops & craft studios', icon: 'brush' },
] as const;

const faq = [
  { q: 'Is this a tour?', a: 'No. A Jigi is a local friend who shows you their neighborhood — no big groups, no fixed script.' },
  { q: 'Do I need to speak Korean?', a: "No. We'll match you with a Jigi who speaks your language. English first." },
  { q: 'Where does it happen?', a: "We're starting in Seongsu, Seoul." },
  ...(SITE.showPrice
    ? [{ q: 'How much does it cost?', a: "We're planning around ₩120,000 for 4 hours. Pricing isn't final, and nothing is charged now." }]
    : []),
  { q: 'When can I book?', a: "We're in pre-launch. Join the early list and we'll contact you first." },
  { q: 'What happens to my information?', a: 'We only use it to contact you about YEONON. See our <a href="/privacy" class="font-semibold text-brand underline underline-offset-2">Privacy page</a>.' },
];
---
<BaseLayout
  title="Find your local friend in Seongsu | YEONON"
  description="Spend 3–4 hours with a Jigi who shares your interests — coffee, food, fashion, photography, or just wandering Seongsu like a local. Join the early list."
>
  <!-- 1. Hero -->
  <Hero
    eyebrow="For travelers · Pre-launch"
    accent="traveler"
    title="Your local friend in Seoul is waiting."
    sub="Spend 3–4 hours with a Jigi who shares your interests — coffee, food, fashion, photography, or just wandering Seongsu like a local."
    image={{
      src: 'travelers-hero.jpg', // TODO: 성수동 골목 풍경 또는 뒷모습 사진
      alt: 'A quiet alley in Seongsu with small cafés and shops',
      tone: 'traveler',
      caption: 'Seongsu-dong, Seoul',
    }}
  >
    <Fragment slot="actions">
      <Button href={travelerForm('travelers_hero_cta')} external size="lg">Join the early list</Button>
      <Button href="/app-preview" variant="secondary" size="lg">Try the app preview</Button>
    </Fragment>
  </Hero>

  <!-- 2. What you can do -->
  <section class="section bg-surface" aria-labelledby="activities">
    <div class="container-page">
      <SectionHeading id="activities" eyebrow="Ideas" title="What you can do with a Jigi" />
      <ul class="mt-10 grid grid-cols-2 gap-3 md:mt-14 md:grid-cols-3 md:gap-5">
        {activities.map((a) => (
          <li class="card flex flex-col gap-4 p-5 md:flex-row md:items-center md:p-6">
            <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-traveler-soft text-traveler-strong">
              <Icon name={a.icon} />
            </span>
            <span>
              <span class="block font-bold leading-snug">{a.title}</span>
              {'body' in a && <span class="mt-0.5 block text-sm text-muted">{a.body}</span>}
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-muted italic">Examples only. Your plan is shaped with your Jigi.</p>
    </div>
  </section>

  <!-- 3. Who it's for -->
  <section class="section" aria-labelledby="who">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <SectionHeading id="who" eyebrow="Who it's for" title="Made for travelers who'd rather connect than queue." />
      <ul class="space-y-3">
        {[
          'Couples and families who want a relaxed, personal day',
          "First-timers who don't want to spend the trip searching",
          'Repeat visitors who want something new',
        ].map((t) => (
          <li class="card flex items-start gap-4 p-5">
            <span class="mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-brand text-white">
              <Icon name="check" class="size-4" />
            </span>
            <span class="font-medium">{t}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. How it works (summary) -->
  <section class="section bg-surface" aria-labelledby="how">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <SectionHeading id="how" eyebrow="How it works" title="Three simple steps." />
        <Button href="/how-it-works" variant="ghost">See the details <Icon name="arrow" class="size-4" /></Button>
      </div>
      <div class="mt-10 md:mt-14">
        <StepTimeline
          layout="horizontal"
          tone="traveler"
          steps={[
            { title: 'Tell us your taste', body: 'Interests, dates, language, and travel style.' },
            { title: 'We hand-pick your Jigi', body: 'Our team matches you by hand during pre-launch.' },
            { title: 'Meet up and explore', body: '3–4 hours in Seongsu, at your pace.' },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- 5. Planned price (SHOW_PRICE) -->
  {SITE.showPrice && (
    <section class="section" aria-labelledby="price">
      <div class="container-page">
        <div class="card mx-auto max-w-2xl p-8 text-center md:p-12">
          <p class="eyebrow justify-center">Planned price</p>
          <h2 id="price" class="mt-3 text-3xl font-extrabold md:text-4xl">{SITE.priceLabel}</h2>
          <p class="mt-4 text-sm text-muted italic">Planned price — not final. No payment is taken now.</p>
        </div>
      </div>
    </section>
  )}

  <!-- 6. Safety -->
  <section class:list={['section', SITE.showPrice ? 'bg-surface' : '']} aria-labelledby="safety">
    <div class="container-page">
      <SectionHeading id="safety" eyebrow="Safety" title="Meeting someone new should feel safe." />
      <div class="mt-10 grid gap-4 md:mt-14 md:grid-cols-3 md:gap-6">
        <Card title="ID-checked & interviewed" icon="id">Every Jigi is ID-checked and interviewed before joining.</Card>
        <Card title="Clear guidelines" icon="book">Jigis follow our activity guidelines.</Card>
        <Card title="Public places" icon="pin">
          Meetups happen in public places.
          {/* TODO: 신고·보험 절차 확정 후 문구 추가 */}
        </Card>
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section" aria-labelledby="faq">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <SectionHeading id="faq" eyebrow="FAQ" title="Questions, answered." />
      <FAQ items={faq} />
    </div>
  </section>

  <!-- 8. Final CTA -->
  <CTASection title="Coming to Seoul soon? Tell us when.">
    <Button href={travelerForm('travelers_final_cta')} external size="lg" class="bg-white! text-brand! hover:bg-bg!">Join the early list</Button>
  </CTASection>
</BaseLayout>
