---
/**
 * 약관·개인정보처리방침 다시 동의. 회원이 동의한 시행일(profiles.terms_version·privacy_version)이
 * 지금 문서(src/config/legal.ts)와 다르면 미들웨어가 회원 영역 대신 이 화면으로 보낸다.
 * 저장은 DB 함수 accept_legal_update. 여행자는 영어, 지기는 한국어.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Notice from '../../components/account/Notice.astro';
import { LEGAL, legalDate, needsLegalConsent } from '../../config/legal';
import { dbError, field } from '../../lib/forms';
import { homeFor, isOnboarded } from '../../lib/profile';
import { safeNext } from '../../lib/supabase';

export const prerender = false;

const { profile, supabase } = Astro.locals;
if (!profile || !supabase) return Astro.redirect('/login');
const next = safeNext(Astro.url.searchParams.get('next'), homeFor(profile));
// 온보딩 전이면 온보딩에서 동의를 받는다. 이미 지금 버전에 동의했으면 돌아간다
if (!isOnboarded(profile) || profile.role === 'admin') return Astro.redirect(homeFor(profile));
if (!needsLegalConsent(profile)) return Astro.redirect(next);

const ko = profile.role === 'jigi';
let error: string | null = null;
let marketing = profile.marketing_opt_in;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  marketing = field(fd, 'marketing') === 'yes';
  if (field(fd, 'terms') !== 'yes' || field(fd, 'privacy') !== 'yes') {
    error = ko ? '필수 항목에 모두 동의해 주세요.' : 'Please check both required items.';
  } else {
    const { error: rpcError } = await supabase.rpc('accept_legal_update', {
      p_terms_version: LEGAL.termsVersion,
      p_privacy_version: LEGAL.privacyVersion,
      p_marketing: marketing,
    });
    if (!dbError(rpcError, 'accept_legal_update')) return Astro.redirect(next);
    error = ko ? '저장하지 못했어요. 다시 시도해 주세요.' : 'Something went wrong. Please try again.';
  }
}

const firstTime = !profile.terms_version;
const date = legalDate(LEGAL.termsVersion, ko ? 'ko' : 'en');
const box = 'flex cursor-pointer items-start gap-3 rounded-2xl border border-border bg-surface p-4 has-checked:border-brand has-checked:bg-brand-soft';
const checkbox = 'mt-1 size-[18px] shrink-0 cursor-pointer accent-brand';
const link = 'font-semibold underline underline-offset-2';
---
<BaseLayout title={ko ? '약관 동의 | 연온' : 'Updated terms | YEONON'} description={ko ? '연온 약관·개인정보처리방침 동의' : 'Review our updated Terms and Privacy notice.'} lang={ko ? 'ko' : 'en'} sticky="none" noindex>
  <section class="section pt-10! md:pt-16!">
    <div class="container-page max-w-xl!">
      <p class="eyebrow">{ko ? '약관 안내' : 'Terms update'}</p>
      <h1 class="mt-3 text-3xl font-extrabold">
        {ko ? (firstTime ? '이용약관과 개인정보처리방침을 확인해 주세요' : '이용약관·개인정보처리방침이 바뀌었어요')
            : (firstTime ? 'Please review our Terms and Privacy notice' : "We've updated our Terms and Privacy notice")}
      </h1>
      <p class="mt-3 text-muted">
        {ko ? `${date}부터 적용돼요. 계속 이용하려면 아래 내용을 확인하고 동의해 주세요.`
            : `They apply from ${date}. To keep using YEONON, please read them and agree below.`}
      </p>

      <form method="post" class="mt-8 space-y-3" novalidate>
        {error && <Notice tone="error">{error}</Notice>}
        <label class={box}>
          <input type="checkbox" name="terms" value="yes" class={checkbox} required />
          <span>{ko ? <>(필수) <a href="/terms" target="_blank" rel="noopener" class={link}>이용약관</a>에 동의합니다.</>
                    : <>(Required) I agree to the <a href="/terms#en" target="_blank" rel="noopener" class={link}>Terms of Service</a>.</>}</span>
        </label>
        <label class={box}>
          <input type="checkbox" name="privacy" value="yes" class={checkbox} required />
          <span>{ko ? <>(필수) <a href="/privacy" target="_blank" rel="noopener" class={link}>개인정보처리방침</a>에 따른 개인정보 수집·이용에 동의합니다.</>
                    : <>(Required) I agree to the collection and use of my personal information as described in the <a href="/privacy#en" target="_blank" rel="noopener" class={link}>Privacy notice</a>.</>}</span>
        </label>
        <label class={box}>
          <input type="checkbox" name="marketing" value="yes" class={checkbox} checked={marketing || undefined} />
          <span>{ko ? '(선택) 소식·이벤트 메일을 받을게요.' : '(Optional) Send me news and event emails.'}</span>
        </label>
        <button type="submit" class="mt-3 flex h-[56px] w-full items-center justify-center rounded-full bg-brand text-base font-semibold text-white transition-colors hover:bg-[#082D6B]">
          {ko ? '동의하고 계속하기' : 'Agree and continue'}
        </button>
        <p class="pt-2 text-center text-sm text-muted">
          {ko ? <>동의하지 않으면 <a href="/account/delete" class={link}>탈퇴</a>할 수 있어요.</>
              : <>If you don't agree, you can <a href="/account/delete" class={link}>delete your account</a>.</>}
        </p>
      </form>
    </div>
  </section>
</BaseLayout>
