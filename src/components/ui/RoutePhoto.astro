---
/**
 * 루트 사진 한 장 (대표 사진·정류장 사진). 고정 비율 상자 안에 꽉 채워 레이아웃이 흔들리지 않는다.
 * 운영(Supabase https 주소)에서는 Astro 이미지 최적화(Vercel)로 크기별 srcset을 만들고, 그 밖(로컬 가짜 DB 등)은 원본 주소 그대로.
 * 사진이 없으면 RouteThumb(루트 라인 일러스트)로 대신한다 — 그때는 stops 이름이 필요하다.
 * 첫 화면의 가장 큰 사진만 priority(바로 + 높은 우선순위), eager는 바로 불러오기만, 나머지는 lazy.
 * 형식은 Vercel이 브라우저에 맞춰 AVIF/WebP로 내려준다 (astro.config.mjs imagesConfig.formats).
 */
import { getImage } from 'astro:assets';
import RouteThumb from './RouteThumb.astro';
import { photoUrl } from '../../lib/routePhotos';

interface Props {
  path: string | null | undefined;
  alt: string;
  /** 상자 비율 (CSS aspect-ratio). 'auto'면 class로 정한다 (예: 모바일 4:5, 데스크톱 16:9) */
  ratio?: string;
  /** 화면에서 차지하는 폭 (srcset 고르기용 sizes) */
  sizes?: string;
  eager?: boolean;
  /** 첫 화면에서 가장 큰 사진 (LCP 후보): fetchpriority=high */
  priority?: boolean;
  /** srcset 폭 목록 (astro.config.mjs imagesConfig.sizes 안의 값만). 작은 썸네일은 작은 폭만 */
  widths?: number[];
  class?: string;
  /** 사진이 없을 때 그릴 정류장 이름 */
  stops?: string[];
}
const { path, alt, ratio = '4 / 3', sizes = '(min-width: 1024px) 33vw, 100vw', eager = false, priority = false, widths = [480, 800, 1200, 1600, 2000], class: className = '', stops = [] } = Astro.props;

const [rw, rh] = (ratio === 'auto' ? '16 / 9' : ratio).split('/').map((n) => Number(n.trim()));
const W = Math.min(1600, Math.max(...widths));
const H = Math.round((W * (rh || 3)) / (rw || 4));
let img: { src: string; srcset?: string } | null = null;
if (path) {
  const url = photoUrl(path);
  img = { src: url };
  if (url.startsWith('https://')) {
    try {
      const out = await getImage({ src: url, width: W, height: H, widths, sizes, quality: 75 });
      img = { src: out.src, srcset: out.srcSet.attribute || undefined };
    } catch (e) {
      console.error('[YEONON] route photo optimize failed:', (e as Error).message);
    }
  }
}
---
<div class:list={['relative overflow-hidden bg-concrete', className]} style={ratio === 'auto' ? undefined : `aspect-ratio: ${ratio}`}>
  {img ? (
    <img
      src={img.src}
      srcset={img.srcset}
      sizes={img.srcset ? sizes : undefined}
      alt={alt}
      width={W}
      height={H}
      loading={eager || priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      class="absolute inset-0 size-full object-cover"
    />
  ) : (
    <RouteThumb stops={stops} label={alt} class="absolute inset-0 size-full" />
  )}
  <slot />
</div>
