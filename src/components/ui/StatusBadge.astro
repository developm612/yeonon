---
/**
 * 예약 상태 배지: 글자 + 작은 점 (yeonon-traveler-ui-plan.md 4-4). 배경은 상태색의 10%.
 * 상태 이름은 화면 전체에서 같게 — Requested / Confirmed / Completed / Cancelled / Expired (6장).
 * 거절(declined)은 여행자에게 "Declined"로 보인다.
 */
import { TRAVELER_STATUS, type BookingStatus } from '../../data/bookingOptions';

interface Props {
  status: BookingStatus;
  class?: string;
}
const { status, class: className = '' } = Astro.props;

const TONE = {
  ok: 'bg-status-ok/10 text-status-ok',
  wait: 'bg-status-wait/10 text-status-wait',
  off: 'bg-status-off/10 text-status-off',
  done: 'bg-ink/[0.07] text-ink',
};
const s = TRAVELER_STATUS[status];
---
<span class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[0.8125rem] leading-none font-semibold whitespace-nowrap', TONE[s.tone], className]}>
  <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>{s.label}
</span>
