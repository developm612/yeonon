---
/**
 * 빈 화면: 일러스트 대신 루트 라인 한 줄 + 다음 행동 버튼 1개 (yeonon-traveler-ui-plan.md 4-4, 6장).
 * 문구는 다음 행동으로 끝낸다 — 예: "No meetups yet." + "Find a route for your days in Seoul."
 */
import UiButton from './UiButton.astro';

interface Props {
  title: string;
  body?: string;
  action?: { href: string; label: string };
  class?: string;
}
const { title, body, action, class: className = '' } = Astro.props;
---
<div class:list={['rounded-card border border-hairline bg-paper px-6 py-10 text-center md:py-14', className]}>
  <svg class="mx-auto block h-[22px] w-40" viewBox="0 0 160 22" aria-hidden="true">
    <line x1="11" x2="149" y1="11" y2="11" stroke="var(--color-hairline)" stroke-width="4" stroke-linecap="round" stroke-dasharray="2 9" />
    <circle cx="11" cy="11" r="6" fill="var(--color-paper)" stroke="var(--color-line2)" stroke-width="3.5" />
    <circle cx="80" cy="11" r="6" fill="var(--color-paper)" stroke="var(--color-hairline)" stroke-width="3.5" />
    <circle cx="149" cy="11" r="6" fill="var(--color-paper)" stroke="var(--color-hairline)" stroke-width="3.5" />
  </svg>
  <h2 class="t-heading mt-5">{title}</h2>
  {body && <p class="t-body measure mx-auto mt-2 text-stone">{body}</p>}
  {action && <UiButton href={action.href} class="mt-6">{action.label}</UiButton>}
  <slot />
</div>
