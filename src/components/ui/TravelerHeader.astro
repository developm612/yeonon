---
/**
 * 여행자 헤더 (yeonon-traveler-ui-plan.md 5-8) — 로그인한 여행자의 /app·/routes 화면.
 * 로고 + (데스크톱) 메뉴 + 메시지·알림 아이콘. 높이를 줄였고, 스크롤하면 흰 면 + 얇은 선이 생긴다.
 * 모바일 메뉴는 하단 TabBar가 맡는다 (메시지 아이콘은 탭에 있으므로 모바일 헤더에는 알림만).
 * 로그아웃은 프로필 화면 맨 아래로 옮겼다.
 */
import Logo from '../Logo.astro';
import ChatBadge from '../islands/ChatBadge';
import NotificationBell from '../islands/NotificationBell';
import { TRAVELER_NAV } from '../../data/accountNav';

interface Props {
  userId: string;
}
const { userId } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// /app(Home)은 정확히 그 주소일 때만 (루트 상세 /app/routes/… 에서 Home이 켜지지 않게)
const current = TRAVELER_NAV.map((i) => i.href).filter((h) => path === h || (h !== '/app' && path.startsWith(h + '/'))).sort((a, b) => b.length - a.length)[0];
---
<header class="t-header sticky top-0 z-40 border-b border-transparent bg-concrete/90 backdrop-blur-md transition-colors" data-t-header>
  <div class="container-page flex h-14 items-center gap-4 md:h-16">
    <Logo href="/app" size="sm" class="shrink-0" />
    <nav aria-label="Traveler menu" class="hidden min-w-0 flex-1 md:block">
      <ul class="flex items-center gap-1">
        {TRAVELER_NAV.map((i) => (
          <li>
            <a href={i.href} aria-current={i.href === current ? 'page' : undefined}
              class:list={['relative flex min-h-11 items-center px-3 text-[0.9375rem] font-semibold whitespace-nowrap transition-colors',
                i.href === current ? 'text-ink after:absolute after:inset-x-3 after:bottom-1.5 after:h-[3px] after:rounded-full after:bg-line2' : 'text-stone hover:text-ink']}>
              {i.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="ml-auto -mr-2 flex items-center">
      <span class="hidden md:contents"><ChatBadge client:load userId={userId} lang="en" href="/app/messages" /></span>
      <NotificationBell client:load userId={userId} lang="en" />
    </div>
  </div>
</header>

<script>
  // 스크롤하면 흰 면 + 얇은 선
  const h = document.querySelector<HTMLElement>('[data-t-header]');
  if (h) {
    const sync = () => h.classList.toggle('is-scrolled', window.scrollY > 4);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>

<style>
  .t-header.is-scrolled {
    background-color: var(--color-paper);
    border-bottom-color: var(--color-hairline);
  }
</style>
