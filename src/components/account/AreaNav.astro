---
/** 회원 영역(/app · /partner · /admin) 상단 탭 */
interface Props {
  items: { href: string; label: string }[];
  label: string;
}
const { items, label } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// 가장 길게 일치하는 탭을 현재 탭으로 (예: /admin/users 에서 /admin 이 아니라 /admin/users)
const current = items.map((i) => i.href).filter((h) => path === h || path.startsWith(h + '/')).sort((a, b) => b.length - a.length)[0];
---
<nav aria-label={label} class="border-b border-border bg-surface">
  <ul class="container-page flex gap-1 overflow-x-auto py-2">
    {items.map((i) => (
      <li>
        <a
          href={i.href}
          aria-current={i.href === current ? 'page' : undefined}
          class:list={[
            'flex min-h-10 items-center rounded-full px-4 text-sm font-semibold whitespace-nowrap transition-colors',
            i.href === current ? 'bg-text text-white' : 'text-muted hover:bg-text/5',
          ]}
        >{i.label}</a>
      </li>
    ))}
  </ul>
</nav>
