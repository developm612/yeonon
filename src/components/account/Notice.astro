---
/** 저장 완료·오류 안내 상자 */
interface Props {
  tone?: 'info' | 'error';
  class?: string;
}
const { tone = 'info', class: className = '' } = Astro.props;
---
<p
  role={tone === 'error' ? 'alert' : 'status'}
  class:list={[
    'rounded-xl px-4 py-3 text-sm font-medium',
    tone === 'error' ? 'bg-[#FDECEC] text-[#8A1C1C]' : 'bg-brand-soft text-brand',
    className,
  ]}
><slot /></p>
