---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'brand' | 'jigi' | 'ghost';
  size?: 'md' | 'lg';
  /** 외부 설문 링크: 새 탭 + rel=noopener */
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', external = false, class: className = '' } = Astro.props;
const styles = {
  primary: 'bg-traveler-strong text-white hover:bg-[#134FB0]',
  secondary: 'bg-surface text-text border border-border hover:border-text',
  brand: 'bg-brand text-white hover:bg-[#082D6B]',
  jigi: 'bg-jigi-strong text-white hover:bg-[#08566F]',
  ghost: 'text-brand underline-offset-4 hover:underline',
};
const sizes = { md: 'min-h-11 px-5 text-[0.9375rem]', lg: 'min-h-13 px-7 text-base' };
const pending = href === '#';
---
<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors',
    variant === 'ghost' ? 'min-h-11 text-[0.9375rem]' : sizes[size],
    styles[variant],
    className,
  ]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  {...(pending ? { 'data-pending-link': '' } : {})}
>
  <slot />
  {external && <span class="sr-only">(opens in a new tab)</span>}
</a>
