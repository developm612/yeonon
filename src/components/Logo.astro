---
// 로고: logo.webp (320×60, 표시 최대 160px의 2배) — 원본은 logo.png (990×185, 흰 배경을 투명하게 바꾸고 여백을 잘라낸 것)
// 이전 로고는 logo2.png (495×96)
interface Props { class?: string; size?: 'sm' | 'md' | 'lg'; href?: string; }
const { class: className = '', size = 'md', href = '/' } = Astro.props;
const widths = {
  sm: 'max-w-[96px]',
  md: 'max-w-[96px] md:max-w-[140px]',
  lg: 'max-w-[160px]',
};
---
<a href={href} class:list={['inline-flex min-w-0 items-center no-underline', className]} aria-label={href === '/' ? 'YEONON 연온 — home' : 'YEONON — my home'}>
  <img
    src="/images/logo.webp"
    alt="YEONON"
    width="495"
    height="93"
    class:list={['block h-auto w-full', widths[size]]}
    decoding="async"
  />
</a>
