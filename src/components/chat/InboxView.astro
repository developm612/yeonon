---
/** 메시지 목록 본문 — /chats(영문), /partner/messages(한글). 실시간 갱신은 ConversationList 아일랜드 */
import ConversationList from '../islands/ConversationList';
import { dbError } from '../../lib/forms';
import type { ConversationListItem } from '../../lib/chat';

interface Props {
  lang: 'en' | 'ko';
}
const { lang } = Astro.props;
const { supabase, user } = Astro.locals;
const ko = lang === 'ko';
let items: ConversationListItem[] = [];
if (supabase && user) {
  const { data, error } = await supabase.rpc('my_conversations');
  dbError(error, 'my_conversations');
  items = (data ?? []) as ConversationListItem[];
}
---
{ko ? (
  <section class="section pt-10! md:pt-14!">
    <div class="container-page max-w-2xl!">
      <p class="eyebrow">지기</p>
      <h1 class="mt-3 text-3xl font-extrabold">메시지</h1>
      <p class="mt-2 text-muted">예약마다 대화방이 하나씩 열려요. 확정 전에는 질문만, 확정 후에는 자유롭게 대화할 수 있어요.</p>
      <div class="mt-8">
        {user && <ConversationList client:load userId={user.id} lang={lang} base="/partner/messages" initial={items} />}
      </div>
    </div>
  </section>
) : (
  <div class="container-page max-w-3xl! pt-8 pb-16 md:pt-12 md:pb-24">
    <h1 class="t-display">Messages</h1>
    <p class="t-body measure mt-2 text-stone">Each booking has its own chat. Before it's confirmed, ask questions. Once you're matched, chat freely.</p>
    <div class="mt-8">
      {user && <ConversationList client:load userId={user.id} lang={lang} base="/chats" initial={items} />}
    </div>
  </div>
)}
