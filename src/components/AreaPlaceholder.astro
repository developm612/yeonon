---
/**
 * /app · /partner · /admin 의 임시 화면 (Phase 1).
 * 로그인 확인이 동작하는지 보여 주는 용도이고, Phase 2부터 각 영역의 실제 화면으로 바뀐다.
 */
interface Props {
  lang: 'en' | 'ko';
  title: string;
  note: string;
}
const { lang, title, note } = Astro.props;
const user = Astro.locals.user;
const name = (user?.user_metadata?.full_name as string | undefined) ?? user?.email;
---
<section class="section pt-12! md:pt-20!">
  <div class="container-page max-w-2xl!">
    <div class="card p-6 md:p-10">
      <p class="eyebrow">{title}</p>
      <h1 class="mt-3 text-3xl font-extrabold">
        {lang === 'ko' ? `${name}님, 안녕하세요` : `Hi, ${name}`}
      </h1>
      <p class="mt-2 text-muted">{user?.email}</p>
      <p class="mt-6 rounded-xl bg-brand-soft px-4 py-3 text-sm">{note}</p>
      <form method="post" action="/auth/signout" class="mt-8">
        <button type="submit" class="min-h-11 rounded-full border border-border bg-surface px-5 font-semibold transition-colors hover:border-text">
          {lang === 'ko' ? '로그아웃' : 'Sign out'}
        </button>
      </form>
    </div>
  </div>
</section>
