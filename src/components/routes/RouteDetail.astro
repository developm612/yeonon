---
/**
 * 루트 상세 본문 — 공개 /routes/[id]와 여행자 /app/routes/[id]가 같이 쓴다.
 * 코스 타임라인, 만나는 곳, 지기 공개 프로필(이름 일부만)·평점·최근 후기(여행자 이름은 첫 글자만), 앞으로 4주 가능 시간 칩(KST).
 * 요청 버튼 자리는 slot="cta"로 각 페이지가 채운다.
 * 대표 사진(없으면 루트 라인 썸네일)과 세로 루트 라인(정류장 사진 포함)은 components/ui (성수 라인). 나머지 화면 재구성은 D4.
 * pickForm을 주면 시간 칩이 그 폼(id)의 라디오 버튼(slot_id)이 된다 — 여행자 요청 화면.
 */
import Icon from '../Icon.astro';
import RouteLine from '../ui/RouteLine.astro';
import RoutePhoto from '../ui/RoutePhoto.astro';
import { stopKind } from '../../data/stopKinds';
import { interestNames } from '../../data/interests';
import { WALK_MIN, areaName, languageName, vibeName } from '../../data/routeOptions';
import { courseMinutes, fmtDuration } from '../../lib/course';
import { kstDate, kstDay, kstTime, won, type PublicJigi, type RouteRow, type SlotRow, type StopRow } from '../../lib/routes';
import type { PublicReview } from '../../lib/reviews';

interface Props {
  route: RouteRow;
  stops: StopRow[];
  host: PublicJigi | null;
  slots: SlotRow[];
  backHref: string;
  backLabel: string;
  /** 시간 칩을 고를 수 있게 할 폼의 id */
  pickForm?: string;
  /** 가격 칸 문구 (할인 적용 예: "₩45,000 → ₩0 · Early member"). 없으면 정가 */
  priceLabel?: string;
  /** 이 지기의 최근 공개 후기 (lib/reviews.ts loadPublicReviews) */
  reviews?: PublicReview[];
}
const { route, stops, host, slots, backHref, backLabel, pickForm, priceLabel, reviews = [] } = Astro.props;
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const monthYear = (iso: string) => new Date(iso).toLocaleDateString('en-US', { timeZone: 'Asia/Seoul', month: 'short', year: 'numeric' });

const lineStops = stops.map((s) => ({
  name: s.place_name, kind: stopKind(s.tags), minutes: s.stay_minutes, area: areaName(s.area, 'en'), activity: s.activity, tip: s.tip, photo: s.photo,
}));
const byDay = new Map<string, SlotRow[]>();
for (const s of slots) byDay.set(kstDay(s.starts_at), [...(byDay.get(kstDay(s.starts_at)) ?? []), s]);
const hostInitial = host?.display_name?.slice(0, 1) ?? '';
---
<div class="container-page pt-6 md:pt-8">
  <a href={backHref} class="t-small inline-flex min-h-11 items-center gap-1 text-stone hover:text-ink"><Icon name="chevron-left" class="size-4" />{backLabel}</a>
  <RoutePhoto path={route.cover_photo} alt={route.title} ratio="auto" eager stops={stops.map((s) => s.place_name)}
    sizes="(min-width: 1120px) 1056px, 100vw" class="mt-2 aspect-[4/5] rounded-media sm:aspect-video" />
  <h1 class="t-display mt-6 md:mt-8">{route.title}</h1>
  <p class="t-body measure mt-3 text-stone">{route.summary}</p>
  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Interests">
    {interestNames(route.tags, 'en').map((name) => <li class="rounded-full border border-hairline bg-paper px-3 py-1 text-[0.875rem] font-semibold">{name}</li>)}
  </ul>
</div>

<section class="section pt-10! md:pt-12!">
  <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
    <div class="min-w-0 space-y-10">
      <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {[
          ['Duration', fmtDuration(route.duration_minutes, 'en')],
          ['Group size', `Up to ${route.max_party_size}`],
          ['Vibe', vibeName(route.vibe, 'en')],
          ['Languages', route.languages.map((l) => languageName(l, 'en')).join(', ')],
          ['Area', areaName(route.area, 'en')],
          ['Price', priceLabel ?? won(route.list_price)],
        ].map(([k, v]) => (
          <div class="rounded-xl bg-surface p-4 shadow-card"><dt class="text-xs font-semibold text-muted">{k}</dt><dd class="mt-1 font-bold">{v}</dd></div>
        ))}
      </dl>

      <div>
        <h2 class="text-xl font-extrabold">The route</h2>
        <p class="mt-1 text-sm text-muted">About {fmtDuration(courseMinutes(stops.map((s) => s.stay_minutes), WALK_MIN), 'en')} including short walks between stops.</p>
        <RouteLine variant="vertical" stops={lineStops} walk={WALK_MIN} class="mt-6" />
      </div>

      <div>
        <h2 class="text-xl font-extrabold">Where you'll meet</h2>
        <p class="mt-2">{areaName(route.area, 'en')} · {route.meeting_point_note}</p>
        <p class="mt-1 text-sm text-muted">Always a public place. Your jigi will share the exact spot once you're matched.</p>
      </div>

      <div id="reviews">
        <h2 class="text-xl font-extrabold">
          Reviews
          {host && host.rating_count > 0 && host.rating_avg !== null && (
            <span class="ml-1 text-base font-semibold text-muted">★ {Number(host.rating_avg).toFixed(1)} · {host.rating_count} {host.rating_count === 1 ? 'review' : 'reviews'}</span>
          )}
        </h2>
        {reviews.length === 0 ? (
          <p class="mt-2 text-sm text-muted">No reviews yet — this jigi is new to YEONON.</p>
        ) : (
          <ul class="mt-4 space-y-3">
            {reviews.map((r) => (
              <li class="rounded-xl bg-surface p-4 shadow-card">
                <p class="flex flex-wrap items-center gap-x-2 text-sm">
                  <span class="tracking-wide text-[#B7791F]" aria-label={`${r.rating} out of 5 stars`}>{stars(r.rating)}</span>
                  <span class="font-semibold">{r.author_initial}.</span>
                  <span class="text-muted">· {monthYear(r.created_at)}{r.route_id !== route.id && r.route_title ? ` · ${r.route_title}` : ''}</span>
                </p>
                {r.comment && <p class="mt-1.5">{r.comment}</p>}
              </li>
            ))}
          </ul>
        )}
        <p class="mt-2 text-xs text-muted">Reviews come from travelers who met this jigi through YEONON. Names show the first initial only.</p>
      </div>
    </div>

    <aside class="space-y-5 lg:sticky lg:top-24">
      <div class="card p-5">
        <p class="text-xs font-semibold text-muted">Your local friend</p>
        <p class="mt-1 flex items-center gap-2 text-lg font-bold">
          <span class="inline-flex size-[36px] items-center justify-center rounded-full bg-jigi-soft text-base text-jigi-strong" aria-hidden="true">
            {hostInitial || <Icon name="user" class="size-[18px]" />}
          </span>
          {host?.display_name ?? 'Jigi'}
        </p>
        {host?.headline && <p class="mt-2 font-semibold">{host.headline}</p>}
        {host?.bio && <p class="mt-1 text-sm text-muted">{host.bio}</p>}
        {host && host.languages.length > 0 && <p class="mt-2 text-sm text-muted">Speaks {host.languages.map((l) => languageName(l, 'en')).join(', ')}</p>}
        {host && host.rating_count > 0 && host.rating_avg !== null && (
          <p class="mt-1 text-sm font-semibold">★ {Number(host.rating_avg).toFixed(1)} <a href="#reviews" class="font-normal text-muted underline underline-offset-2">({host.rating_count} {host.rating_count === 1 ? 'review' : 'reviews'})</a></p>
        )}
        <p class="mt-3 text-xs text-muted">Contact details stay private. You'll chat in YEONON once matched.</p>
      </div>

      <div class="card p-5">
        <h2 class="font-bold" id="times-heading">{pickForm ? 'Pick a time' : 'Available times'} <span class="font-normal text-muted">(KST)</span></h2>
        {byDay.size === 0 ? (
          <p class="mt-2 text-sm text-muted">No open times in the next 4 weeks yet.</p>
        ) : pickForm ? (
          <fieldset class="mt-3 max-h-[320px] space-y-3 overflow-y-auto pr-1" aria-labelledby="times-heading" data-slot-picker>
            {[...byDay].map(([, list]) => (
              <div>
                <p class="text-sm font-semibold">{kstDate(list[0].starts_at, 'en-US', { weekday: 'short', month: 'short', day: 'numeric' })}</p>
                <div class="mt-1.5 flex flex-wrap gap-1.5">
                  {list.map((s) => (
                    <label class="cursor-pointer rounded-full border border-border px-3 py-1.5 text-sm font-semibold tabular-nums transition-colors hover:border-traveler-strong has-checked:border-traveler-strong has-checked:bg-traveler-strong has-checked:text-white has-disabled:cursor-not-allowed has-disabled:border-border has-disabled:bg-text/5 has-disabled:text-muted has-disabled:line-through has-focus-visible:ring-2 has-focus-visible:ring-traveler-strong/40">
                      <input type="radio" name="slot_id" value={s.id} form={pickForm} required class="sr-only"
                        data-label={`${kstDate(s.starts_at, 'en-US', { weekday: 'short', month: 'short', day: 'numeric' })} · ${kstTime(s.starts_at)}`} />
                      {kstTime(s.starts_at)}
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </fieldset>
        ) : (
          <ul class="mt-3 max-h-[320px] space-y-3 overflow-y-auto pr-1">
            {[...byDay].map(([, list]) => (
              <li>
                <p class="text-sm font-semibold">{kstDate(list[0].starts_at, 'en-US', { weekday: 'short', month: 'short', day: 'numeric' })}</p>
                <ul class="mt-1.5 flex flex-wrap gap-1.5">
                  {list.map((s) => <li class="rounded-full border border-border px-3 py-1 text-sm font-semibold tabular-nums">{kstTime(s.starts_at)}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        )}
        <slot name="cta" />
      </div>
    </aside>
  </div>
</section>
