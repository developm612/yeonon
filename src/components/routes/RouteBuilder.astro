---
/**
 * 루트 빌더: 기본 정보 → 코스 정류장 → 미리보기 → 저장/검수 요청.
 * 앱 미리보기(/app-preview-jigi)의 '코스 만들기' 화면을 실제 입력용으로 넓혔다 — 정류장 카드(번호·위로·빼기),
 * 시작 시간 선택, 여행자에게 보이는 코스 카드(CourseCard)를 그대로 쓴다. 동작은 scripts/routeBuilder.ts.
 * 서버가 같은 검증(lib/routeValidation.ts)을 다시 하고 DB 함수 save_route로 저장한다.
 */
import CourseCard from './CourseCard.astro';
import StopFields from './StopFields.astro';
import { INTERESTS } from '../../data/interests';
import { START_TIMES } from '../../data/jigiPreview';
import {
  DURATIONS, LIMITS, PARTY_MAX, PRICE_MAX, ROUTE_AREAS, ROUTE_LANGUAGES, ROUTE_TAG_MAX, ROUTE_TAG_MIN, STOP_MAX, STOP_MIN,
  VIBES, WALK_MIN,
} from '../../data/routeOptions';
import { fmtDuration } from '../../lib/course';
import type { RouteError, RouteForm, StopDraft } from '../../lib/routeValidation';

interface Props {
  values: RouteForm;
  error?: RouteError;
  /** 고칠 수 없는 상태(검수 중)면 true */
  locked?: boolean;
}
const { values, error, locked = false } = Astro.props;
const r = values.route;
const blank: StopDraft = { place_name: '', area: '', stay_minutes: NaN, activity: '', tip: '', tags: [] };
const bad = (name: string) => (error && error.field === name && error.index === undefined ? 'true' : undefined);

const input = 'mt-2 block h-[52px] w-full rounded-[14px] border border-border bg-surface px-4 focus:border-jigi-strong focus:outline-none focus:ring-3 focus:ring-jigi/20 aria-invalid:border-[#B42318]';
const pill = 'flex min-h-11 cursor-pointer items-center gap-2 rounded-[12px] border border-border bg-surface px-3.5 text-[0.9375rem] has-checked:border-jigi-strong has-checked:bg-jigi-soft has-disabled:cursor-not-allowed has-disabled:opacity-50';
const check = 'size-[18px] shrink-0 cursor-pointer accent-jigi-strong';
const h2 = 'text-xl font-extrabold';
const step = 'text-sm font-bold text-jigi-strong';
---
<form method="post" novalidate class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start" data-route-builder data-walk={WALK_MIN}>
  <fieldset disabled={locked || undefined} class="min-w-0 space-y-12">
    <!-- 1. 기본 정보 -->
    <section aria-labelledby="rb-basic" class="space-y-6">
      <div>
        <p class={step}>1 / 3</p>
        <h2 id="rb-basic" class={h2}>기본 정보</h2>
        <p class="mt-1 text-sm text-muted">여행자에게 보이는 내용이에요. 외국인 여행자가 읽을 수 있게 영어로 쓰는 것을 권해요.</p>
      </div>

      <div>
        <label for="rb-title" class="font-semibold">루트 이름</label>
        <input id="rb-title" name="title" type="text" maxlength={LIMITS.title[1]} value={r.title} placeholder="예: Hidden cafés & design shops" class={input} aria-invalid={bad('title')} data-rb-title />
      </div>
      <div>
        <label for="rb-summary" class="font-semibold">한 줄 소개</label>
        <input id="rb-summary" name="summary" type="text" maxlength={LIMITS.summary[1]} value={r.summary} placeholder="예: A slow afternoon through Seongsu's quiet coffee bars." class={input} aria-invalid={bad('summary')} />
      </div>

      <fieldset aria-invalid={bad('tags')}>
        <legend class="font-semibold">테마 태그 <span class="font-normal text-muted">({ROUTE_TAG_MIN}~{ROUTE_TAG_MAX}개)</span></legend>
        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3" data-rb-tags data-max={ROUTE_TAG_MAX}>
          {INTERESTS.map((it) => (
            <label class={pill}><input type="checkbox" name="tags" value={it.id} class={check} checked={r.tags.includes(it.id) || undefined} /><span aria-hidden="true">{it.emoji}</span>{it.ko}</label>
          ))}
        </div>
      </fieldset>

      <div class="grid gap-6 sm:grid-cols-2">
        <fieldset>
          <legend class="font-semibold">분위기</legend>
          <div class="mt-2 grid grid-cols-2 gap-2">
            {VIBES.map((v) => <label class={pill}><input type="radio" name="vibe" value={v.id} class={check} checked={r.vibe === v.id || undefined} />{v.ko}</label>)}
          </div>
        </fieldset>
        <div>
          <label for="rb-duration" class="font-semibold">소요 시간</label>
          <select id="rb-duration" name="duration_minutes" class={input} aria-invalid={bad('duration_minutes')} data-rb-duration>
            <option value="">선택</option>
            {DURATIONS.map((d) => <option value={d} selected={d === r.duration_minutes || undefined}>{fmtDuration(d)}</option>)}
          </select>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-[200px_1fr]">
        <div>
          <label for="rb-area" class="font-semibold">만나는 구역</label>
          <select id="rb-area" name="area" class={input} aria-invalid={bad('area')}>
            <option value="">선택</option>
            {ROUTE_AREAS.map((a) => <option value={a.id} selected={a.id === r.area || undefined}>{a.ko}</option>)}
          </select>
        </div>
        <div>
          <label for="rb-meeting" class="font-semibold">만나는 곳 <span class="font-normal text-muted">(공개 장소, 대략적인 위치)</span></label>
          <input id="rb-meeting" name="meeting_point_note" type="text" maxlength={LIMITS.meeting[1]} value={r.meeting_point_note} placeholder="예: Seongsu Station exit 3" class={input} aria-invalid={bad('meeting_point_note')} />
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="rb-party" class="font-semibold">최대 인원</label>
          <select id="rb-party" name="max_party_size" class={input} aria-invalid={bad('max_party_size')}>
            <option value="">선택</option>
            {Array.from({ length: PARTY_MAX }, (_, i) => i + 1).map((n) => <option value={n} selected={n === r.max_party_size || undefined}>{n}명</option>)}
          </select>
        </div>
        <div>
          <label for="rb-price" class="font-semibold">정가 <span class="font-normal text-muted">(원, 1,000원 단위)</span></label>
          <input id="rb-price" name="list_price" type="text" inputmode="numeric" maxlength="9" value={Number.isNaN(r.list_price) ? '' : String(r.list_price)} placeholder="예: 50000" class={input} aria-invalid={bad('list_price')} aria-describedby="rb-price-help" />
          <p id="rb-price-help" class="mt-1.5 text-xs text-muted">얼리 멤버에게는 할인되어 보여요. 실제로 받을 계획이 있는 가격을 적어 주세요. 최대 {PRICE_MAX.toLocaleString('ko-KR')}원</p>
        </div>
      </div>

      <fieldset aria-invalid={bad('languages')}>
        <legend class="font-semibold">진행 언어</legend>
        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
          {ROUTE_LANGUAGES.map((l) => <label class={pill}><input type="checkbox" name="languages" value={l.id} class={check} checked={r.languages.includes(l.id) || undefined} />{l.ko}</label>)}
        </div>
      </fieldset>
    </section>

    <!-- 2. 코스 정류장 -->
    <section aria-labelledby="rb-stops" class="space-y-4">
      <div>
        <p class={step}>2 / 3</p>
        <h2 id="rb-stops" class={h2}>코스 만들기</h2>
        <p class="mt-1 text-sm text-muted">장소를 {STOP_MIN}~{STOP_MAX}곳 담고 순서를 정해 주세요. 장소 사이 이동은 {WALK_MIN}분으로 계산해요.</p>
      </div>
      <ol class="space-y-3" aria-label="코스 순서" data-stops>
        {(values.stops.length ? values.stops : [blank, blank]).map((s, i) => (
          <StopFields no={i + 1} stop={s} invalid={error?.index === i ? error.field : undefined} />
        ))}
      </ol>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="min-h-11 rounded-full border-2 border-dashed border-jigi-strong px-5 font-semibold text-jigi-strong disabled:opacity-40" data-add-stop>+ 장소 추가</button>
        <p class="text-sm font-medium text-muted" data-stops-summary aria-live="polite"></p>
      </div>
    </section>
  </fieldset>

  <!-- 3. 미리보기 + 저장 -->
  <aside class="space-y-4 lg:sticky lg:top-24" aria-labelledby="rb-preview">
    <div>
      <p class={step}>3 / 3</p>
      <h2 id="rb-preview" class={h2}>여행자에게 이렇게 보여요</h2>
    </div>
    <div>
      <p class="text-[13px] font-bold" id="rb-start-label">미리보기 시작 시간</p>
      <div class="mt-1.5 grid grid-cols-3 gap-1.5 rounded-[12px] bg-bg p-1" role="radiogroup" aria-labelledby="rb-start-label">
        {START_TIMES.map((t, i) => (
          <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-start={t.value}
            class="h-[38px] rounded-[9px] text-[14px] font-semibold text-muted aria-checked:bg-white aria-checked:text-jigi-strong aria-checked:shadow-card">{t.label}</button>
        ))}
      </div>
      <p class="mt-1.5 text-xs text-muted">실제 시작 시각은 가능 시간에 맞춰 자동으로 만들어져요.</p>
    </div>
    <CourseCard />

    <p role="alert" class:list={['rounded-xl bg-[#FDECEC] px-4 py-3 text-sm font-medium text-[#8A1C1C]', !error && 'hidden']} data-rb-error>{error?.message}</p>
    {!locked && (
      <div class="grid gap-2">
        <button type="submit" name="intent" value="review" class="flex h-[52px] items-center justify-center rounded-full bg-jigi-strong font-semibold text-white hover:bg-[#08566F]">저장하고 검수 요청</button>
        <button type="submit" name="intent" value="save" class="flex h-[52px] items-center justify-center rounded-full border border-border bg-surface font-semibold hover:border-text">저장만 하기</button>
      </div>
    )}
  </aside>
</form>

<!-- '장소 추가' 때 복제할 빈 정류장 -->
<template data-stop-template>
  <StopFields no={0} stop={blank} />
</template>
