---
/**
 * 루트 상세의 가격 (예약 패널 / 모바일 하단 바). 할인이 있으면 정가에 줄을 긋고 할인 이름을 보여 준다.
 * 캐시된 공개 화면에서는 정가로 그리고, 로그인한 여행자면 브라우저가 /fragments/route-cta/[id]의 값으로 바꾼다.
 */
interface Props {
  variant: 'panel' | 'bar';
  price: { list: number; final: number; promo: string | null };
  /** bar: 열린 시간 수 */
  slotCount?: number;
}
const { variant, price, slotCount = 0 } = Astro.props;
const discounted = price.final < price.list;
const wonText = (n: number) => `₩${n.toLocaleString('en-US')}`;
---
{variant === 'panel' ? (
  <>
    <span class="t-num text-[1.75rem] leading-none">{wonText(price.final)}</span>
    {discounted && <span class="t-small font-normal text-stone line-through">{wonText(price.list)}</span>}
    {discounted && price.promo && <span class="rounded-full bg-line2/10 px-2.5 py-1 text-[0.8125rem] leading-none font-semibold text-line2-text">{price.promo}</span>}
  </>
) : (
  <>
    <span class="t-num block text-[1.375rem] leading-tight">{wonText(price.final)}
      {discounted && <span class="t-small ml-1 font-normal text-stone line-through">{wonText(price.list)}</span>}</span>
    <span class="t-caption block truncate font-normal text-stone">{discounted && price.promo ? `${price.promo} · ` : ''}{slotCount ? `${slotCount} open ${slotCount === 1 ? 'time' : 'times'}` : 'No open times yet'}</span>
  </>
)}
