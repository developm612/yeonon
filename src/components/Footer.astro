---
import Logo from './Logo.astro';
import { SITE, isTodo } from '../config/site';
const email = SITE.contactEmail;
---
<footer class="border-t border-border bg-surface">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr] md:py-16">
    <div class="max-w-sm">
      <Logo size="lg" />
      <p lang="en" class="mt-4 text-[0.9375rem] text-muted">{SITE.taglineEn}</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-sm font-semibold">Explore</h2>
      <ul class="mt-3 space-y-2 text-[0.9375rem] text-muted">
        <li><a lang="en" class="hover:text-text" href="/how-it-works">How it works</a></li>
        <li><a lang="en" class="hover:text-text" href="/travelers">For Travelers</a></li>
        <li><a lang="ko" class="hover:text-text" href="/jigi">지기 지원</a></li>
        <li><a lang="en" class="hover:text-text" href="/privacy">Privacy</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold">Contact</h2>
      <ul class="mt-3 space-y-2 text-[0.9375rem] text-muted">
        <li>
          {isTodo(email) ? <span>{email}</span> : <a class="hover:text-text" href={`mailto:${email}`}>{email}</a>}
        </li>
        <li lang="ko">운영: {SITE.operator}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-page flex flex-col gap-2 py-6 text-[0.8125rem] text-muted md:flex-row md:items-center md:justify-between">
      <p>
        <span lang="en">YEONON is in pre-launch. Matching and booking are not yet open.</span>
        <span lang="ko" class="block md:ml-1 md:inline">연온은 현재 사전 등록 단계입니다.</span>
      </p>
      <p>© 2026 YEONON</p>
    </div>
  </div>
</footer>
