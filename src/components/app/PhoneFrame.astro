---
/**
 * CSS로만 그린 아이폰 모양 프레임 (Apple 로고·상표 없음).
 * 앱 화면은 393×852 기준으로 <slot/>에 넣고, 실제 화면 크기에 맞게 scale 된다. (scripts/appPreview.ts)
 */
---
<div class="phone" data-phone>
  <span aria-hidden="true" class="phone-btn phone-btn--l1"></span>
  <span aria-hidden="true" class="phone-btn phone-btn--l2"></span>
  <span aria-hidden="true" class="phone-btn phone-btn--r1"></span>

  <div class="phone-body">
    <div class="phone-screen" data-phone-screen>
      <div class="phone-viewport" data-phone-viewport>
        <!-- 상태 표시줄 -->
        <div aria-hidden="true" class="absolute inset-x-0 top-0 z-30 flex h-[54px] items-center justify-between px-[34px] pt-1 text-text">
          <span class="w-[56px] text-center text-[18px] font-bold tabular-nums">9:41</span>
          <span class="flex items-center gap-[6px]">
            <svg width="18" height="12" viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5.5" width="3" height="6.5" rx="1"/><rect x="10" y="3" width="3" height="9" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1"/></svg>
            <svg width="16" height="12" viewBox="0 0 16 12" fill="currentColor"><path d="M8 2.6c2.3 0 4.4.9 6 2.4l1.2-1.3A10.3 10.3 0 0 0 8 .8C5.2.8 2.7 1.9.8 3.7L2 5c1.6-1.5 3.7-2.4 6-2.4Z"/><path d="M8 6.1c1.4 0 2.6.5 3.6 1.4l1.2-1.3A7 7 0 0 0 8 4.3a7 7 0 0 0-4.8 1.9l1.2 1.3c1-.9 2.2-1.4 3.6-1.4Z"/><path d="M8 9.6c.5 0 .9.2 1.2.5L8 11.4 6.8 10.1c.3-.3.7-.5 1.2-.5Z"/></svg>
            <svg width="27" height="13" viewBox="0 0 27 13" fill="none"><rect x=".5" y=".5" width="23" height="12" rx="3.8" stroke="currentColor" opacity=".4"/><rect x="2" y="2" width="20" height="9" rx="2.5" fill="currentColor"/><path d="M25 4.5v4c.8-.3 1.3-1.1 1.3-2s-.5-1.7-1.3-2Z" fill="currentColor" opacity=".45"/></svg>
          </span>
        </div>
        <!-- 다이내믹 아일랜드 -->
        <div aria-hidden="true" class="absolute top-[11px] left-1/2 z-30 h-[37px] w-[126px] -translate-x-1/2 rounded-full bg-black"></div>

        <slot />

        <!-- 홈 인디케이터 -->
        <div aria-hidden="true" class="pointer-events-none absolute bottom-[8px] left-1/2 z-30 h-[5px] w-[134px] -translate-x-1/2 rounded-full bg-text"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .phone {
    position: relative;
    container-type: inline-size;
  }
  .phone-body {
    position: relative;
    padding: 3.4cqw;
    border-radius: 14cqw;
    background: #1b1f27;
    box-shadow:
      inset 0 0 0 0.5cqw #2c323d,
      inset 0 0 0 0.8cqw #12151b,
      0 2px 4px rgb(15 30 58 / 0.08),
      0 30px 60px -20px rgb(15 30 58 / 0.35);
  }
  .phone-screen {
    position: relative;
    aspect-ratio: 393 / 852;
    overflow: hidden;
    border-radius: 10.8cqw;
    background: #fff;
    isolation: isolate;
  }
  .phone-viewport {
    position: absolute;
    top: 0;
    left: 0;
    width: 393px;
    height: 852px;
    transform-origin: top left;
    transform: scale(var(--app-scale, 1));
    overflow: hidden;
  }
  .phone-btn {
    position: absolute;
    width: 0.9cqw;
    background: #2a2f39;
    border-radius: 0.5cqw;
  }
  .phone-btn--l1 { left: -0.7cqw; top: 22%; height: 7%; }
  .phone-btn--l2 { left: -0.7cqw; top: 31%; height: 7%; }
  .phone-btn--r1 { right: -0.7cqw; top: 26%; height: 11%; }
</style>
