---
/**
 * /app-preview 하단 대기자 등록 폼.
 * 제출 데이터는 SITE.waitlistEndpoint로 POST 된다 (사이트 자체에는 저장하지 않음). 동작은 scripts/waitlist.ts.
 */
import Icon from '../Icon.astro';
import { SITE, isTodo } from '../../config/site';

const methods = [
  { value: 'email', label: 'Email' },
  { value: 'whatsapp', label: 'WhatsApp' },
  { value: 'instagram', label: 'Instagram' },
];
const countries = [
  'United States', 'United Kingdom', 'Canada', 'Australia', 'New Zealand', 'Ireland',
  'Japan', 'China', 'Taiwan', 'Hong Kong', 'Singapore', 'Malaysia', 'Thailand', 'Vietnam',
  'Philippines', 'Indonesia', 'India', 'Germany', 'France', 'Spain', 'Italy', 'Netherlands',
  'Sweden', 'Norway', 'Denmark', 'Finland', 'Switzerland', 'Austria', 'Belgium', 'Poland',
  'Portugal', 'Mexico', 'Brazil', 'Argentina', 'Chile', 'United Arab Emirates', 'Saudi Arabia',
  'Türkiye', 'Israel', 'South Africa',
].sort();
const sources = [
  'Instagram', 'TikTok', 'YouTube', 'Google search', 'Reddit or travel community',
  'Friend or family', 'A Jigi told me', 'Other',
];
const email = SITE.contactEmail;
const retention = isTodo(SITE.retentionPeriod)
  ? 'Only for the pre-launch period. You can ask us to delete it at any time.'
  : SITE.retentionPeriod;

const field = 'mt-2 block h-[52px] w-full rounded-[14px] border border-border bg-surface px-4 text-[0.9375rem] text-text transition-colors placeholder:text-muted/80 hover:border-muted/60 focus:border-traveler-strong focus:outline-none focus:ring-3 focus:ring-traveler/20 disabled:cursor-not-allowed disabled:bg-bg';
const select = `${field} appearance-none pr-11`;
const label = 'block text-[0.9375rem] font-semibold';
---
<section id="waitlist" class="scroll-mt-20 bg-gradient-to-b from-white via-white to-traveler-soft pb-20 md:pb-28" aria-labelledby="waitlist-title">
  <div class="container-page pt-16 text-center md:pt-20">
    <p class="text-[0.8125rem] font-bold tracking-[0.14em] text-traveler-strong uppercase">Waitlist</p>
    <h2 id="waitlist-title" class="mt-2 text-[2rem] leading-tight font-extrabold md:text-[2.75rem]">Be the first to meet your Jigi</h2>
    <p class="mx-auto mt-3 max-w-md text-[0.9375rem] text-muted md:text-base">
      Tell us how to reach you and we'll let you know the day YEONON launches in Seongsu.
    </p>
    <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-traveler/30 bg-surface px-4 py-1.5 text-[0.8125rem] font-semibold text-traveler-strong">
      <span class="size-1.5 rounded-full bg-traveler" aria-hidden="true"></span>
      Free to join · No payment, no booking
    </p>
  </div>

  <div class="container-page mt-8 md:mt-10">
    <div class="mx-auto max-w-[520px] rounded-[24px] border border-border bg-surface p-6 text-left shadow-card md:p-8" data-waitlist-card>
      <form class="space-y-6" novalidate data-waitlist-form>
        <input type="hidden" name="interests" data-wl-interests />
        <input type="hidden" name="source_page" value="app-preview" />
        <!-- 스팸 봇 차단용: 사람에게는 보이지 않는 칸 (채워지면 전송하지 않음) -->
        <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
          <label for="wl-company">Company</label>
          <input id="wl-company" name="company" type="text" tabindex="-1" autocomplete="off" data-wl-hp />
        </div>

        <div>
          <label for="wl-method" class={label}>How can we reach you?</label>
          <div class="relative">
            <select id="wl-method" name="contact_method" class={select} required data-wl-method>
              <option value="" selected disabled>Choose a contact method</option>
              {methods.map((m) => <option value={m.value}>{m.label}</option>)}
            </select>
            <svg aria-hidden="true" class="pointer-events-none absolute top-1/2 right-4 mt-1 size-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </div>

        <div>
          <label for="wl-contact" class={label}>Contact</label>
          <input id="wl-contact" name="contact" type="text" class={field} placeholder="Select a method above first" disabled required autocomplete="off" autocapitalize="off" spellcheck="false" data-wl-contact />
        </div>

        <div>
          <label for="wl-nationality" class={label}>Nationality</label>
          <div class="relative">
            <select id="wl-nationality" name="nationality" class={select} required>
              <option value="" selected disabled>Select your nationality</option>
              {countries.map((c) => <option>{c}</option>)}
              <option>Other</option>
            </select>
            <svg aria-hidden="true" class="pointer-events-none absolute top-1/2 right-4 mt-1 size-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </div>

        <div>
          <label for="wl-source" class={label}>How did you hear about us?</label>
          <div class="relative">
            <select id="wl-source" name="heard_from" class={select} required>
              <option value="" selected disabled>Choose one</option>
              {sources.map((s) => <option>{s}</option>)}
            </select>
            <svg aria-hidden="true" class="pointer-events-none absolute top-1/2 right-4 mt-1 size-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </div>

        <div>
          <label for="wl-ref" class={label}>Who referred you? <span class="font-normal text-muted">(optional)</span></label>
          <input id="wl-ref" name="referred_by" type="text" maxlength="60" autocomplete="off" class={field} placeholder="If a friend or a Jigi referred you, enter their name" />
        </div>

        <div class="app-notice max-h-[188px] overflow-y-auto rounded-[14px] bg-bg p-4 text-[0.8125rem] leading-relaxed text-muted" tabindex="0" role="region" aria-label="Data collection notice">
          <p class="font-semibold text-text">Data collection notice</p>
          <p class="mt-0.5">A short summary of how we'll use your information.</p>
          <p class="mt-3 font-semibold text-text">1. Purpose</p>
          <p>· Letting you know when YEONON launches in Seongsu<br />· Early-access invitations, and occasionally a short interview request</p>
          <p class="mt-3 font-semibold text-text">2. Data collected</p>
          <p>· Your chosen contact (email, WhatsApp, or Instagram), nationality, how you found us<br />· Optional: the name of the person who referred you<br />· The interests you picked in this app preview, if any</p>
          <p class="mt-3 font-semibold text-text">3. How long we keep it</p>
          <p>· {retention}</p>
          <p class="mt-3 font-semibold text-text">4. Your choice</p>
          <p>· You can ask us to delete your information at any time{isTodo(email) ? '.' : <> by emailing <a class="font-semibold text-traveler-strong underline" href={`mailto:${email}`}>{email}</a>.</>} See our <a class="font-semibold text-traveler-strong underline" href="/privacy">Privacy page</a>.</p>
        </div>

        <label class="flex cursor-pointer items-start gap-3 text-[0.9375rem]">
          <input type="checkbox" name="consent" value="yes" required class="mt-1 size-[18px] shrink-0 cursor-pointer accent-traveler-strong" data-wl-consent />
          <span>I've read the notice above and agree to YEONON collecting and using my information.</span>
        </label>

        <p class="hidden rounded-[12px] bg-traveler-soft px-4 py-3 text-[0.875rem] font-medium text-[#0E3E8A]" role="alert" data-wl-error></p>

        <button type="submit" class="flex h-[56px] w-full items-center justify-center gap-2 rounded-full bg-traveler-strong text-base font-semibold text-white transition-colors hover:bg-[#134FB0] disabled:cursor-wait disabled:opacity-70" data-wl-submit>
          Join the waitlist
        </button>
      </form>

      <div class="hidden py-6 text-center" data-wl-success tabindex="-1">
        <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-traveler-strong text-white" aria-hidden="true">
          <Icon name="check" class="size-8" />
        </span>
        <h3 class="mt-5 text-2xl font-extrabold">You're on the list!</h3>
        <p class="mt-2 text-[0.9375rem] text-muted" data-wl-success-msg>We'll reach out the day YEONON launches.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .app-notice { scrollbar-width: thin; }
</style>
