---
interface Props {
  label: string;
  value: string;
  unit?: string;
  note?: string;
  footnote: number;
}
const { label, value, unit, note, footnote } = Astro.props;
---
<article class="card flex flex-col p-6 md:p-7">
  <p class="text-[0.9375rem] font-medium text-muted">{label}</p>
  <p class="mt-3 text-[2.5rem] leading-none font-extrabold tracking-tight text-jigi-strong md:text-5xl">
    {value}<span class="ml-1 text-xl font-bold text-text md:text-2xl">{unit}</span>
  </p>
  {note && <p class="mt-3 text-[0.9375rem] font-semibold text-brand">{note}</p>}
  <p class="mt-auto pt-5 text-xs text-muted">
    <a href={`#source-${footnote}`} class="underline underline-offset-2 hover:text-text" aria-label={`출처 ${footnote} 보기`}>
      출처 [{footnote}]
    </a>
  </p>
</article>
