---
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { isAuthConfigured } from '../lib/supabase';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/how-it-works', label: 'How it works', lang: 'en' },
  { href: '/travelers', label: 'For Travelers', lang: 'en' },
  { href: '/jigi', label: '지기 지원하기', lang: 'ko' },
];
// 로그인 상태: 서버 렌더링 페이지는 세션으로, 정적 페이지는 브라우저의 세션 쿠키 유무로 표시만 바꾼다 (아래 스크립트)
// Supabase 키가 없으면 로그인 링크를 아예 그리지 않아 기존 화면과 같다
const signedIn = Boolean(Astro.locals.user);
---
<header class="sticky top-0 z-40 border-b border-border/70 bg-bg/90 backdrop-blur-md">
  <!-- 모바일: [로고 | 여행자·지기 전환 | 메뉴] 3열, 가운데 열이 화면 정중앙 / 데스크톱: 로고 + 내비 -->
  <div class="container-page grid h-16 grid-cols-[1fr_auto_1fr] items-center gap-2 md:flex md:h-[72px] md:justify-between md:gap-4">
    <Logo class="justify-self-start" />

    <nav aria-label="Choose your path" class="md:hidden">
      <ul class="flex rounded-full border border-border bg-surface p-1 shadow-card">
        <li>
          <a
            href="/travelers"
            lang="en"
            aria-current={path === '/travelers' ? 'page' : undefined}
            class:list={[
              'flex h-9 items-center rounded-full px-3.5 text-[0.8125rem] font-semibold transition-colors',
              path === '/travelers' ? 'bg-traveler-strong text-white' : 'text-traveler-strong hover:bg-traveler-soft',
            ]}
          >Traveler</a>
        </li>
        <li>
          <a
            href="/jigi"
            lang="ko"
            aria-current={path === '/jigi' ? 'page' : undefined}
            class:list={[
              'flex h-9 items-center rounded-full px-4 text-[0.8125rem] font-semibold transition-colors',
              path === '/jigi' ? 'bg-jigi-strong text-white' : 'text-jigi-strong hover:bg-jigi-soft',
            ]}
          >지기</a>
        </li>
      </ul>
    </nav>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {links.map((l) => (
        <a
          href={l.href}
          lang={l.lang}
          aria-current={path === l.href ? 'page' : undefined}
          class:list={[
            'rounded-full px-2.5 py-2 text-sm font-medium whitespace-nowrap transition-colors hover:bg-text/5 lg:px-3.5 lg:text-[0.9375rem]',
            l.href === '/jigi' ? 'text-jigi-strong' : path === l.href ? 'text-text' : 'text-muted',
            path === l.href && 'bg-text/5',
          ]}
        >
          {l.label}
        </a>
      ))}
      {isAuthConfigured && (
        <>
          <a href="/login" data-auth="out" hidden={signedIn} lang="en" class="rounded-full px-2.5 py-2 text-sm font-medium whitespace-nowrap text-muted transition-colors hover:bg-text/5 lg:px-3.5 lg:text-[0.9375rem]">Sign in</a>
          <a href="/account" data-auth="in" hidden={!signedIn} lang="en" class="rounded-full px-2.5 py-2 text-sm font-medium whitespace-nowrap text-text transition-colors hover:bg-text/5 lg:px-3.5 lg:text-[0.9375rem]">My page</a>
          <form method="post" action="/auth/signout" data-auth="in" hidden={!signedIn}>
            <button type="submit" lang="en" class="rounded-full px-2.5 py-2 text-sm font-medium whitespace-nowrap text-muted transition-colors hover:bg-text/5 lg:px-3.5 lg:text-[0.9375rem]">Sign out</button>
          </form>
        </>
      )}
      <!-- 앱 미리보기 페이지 안에서는 다시 불러오지 않고 하단 대기자 폼으로 이동 -->
      <Button href={path === '/app-preview' ? '#waitlist' : '/app-preview'} class="ml-2 whitespace-nowrap">
        <span lang="en">Join the early list</span>
      </Button>
    </nav>

    <button
      type="button"
      class="-mr-2 inline-flex size-11 justify-self-end items-center justify-center rounded-full hover:bg-text/5 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <span data-icon-open><Icon name="menu" /></span>
      <span data-icon-close class="hidden"><Icon name="x" /></span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-border bg-bg md:hidden" aria-label="Main mobile" data-menu>
    <ul class="container-page flex flex-col py-2">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            lang={l.lang}
            aria-current={path === l.href ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between border-b border-border/60 py-4 text-lg font-semibold',
              l.href === '/jigi' && 'text-jigi-strong',
            ]}
          >
            {l.label}
            <Icon name="arrow" class="size-5 text-muted" />
          </a>
        </li>
      ))}
      {isAuthConfigured && (
        <li>
          <a href="/login" data-auth="out" hidden={signedIn} lang="en" class="flex items-center justify-between border-b border-border/60 py-4 text-lg font-semibold">
            Sign in
            <Icon name="arrow" class="size-5 text-muted" />
          </a>
          <a href="/account" data-auth="in" hidden={!signedIn} lang="en" class="flex items-center justify-between border-b border-border/60 py-4 text-lg font-semibold">
            My page
            <Icon name="arrow" class="size-5 text-muted" />
          </a>
          <form method="post" action="/auth/signout" data-auth="in" hidden={!signedIn}>
            <button type="submit" lang="en" class="flex w-full items-center border-b border-border/60 py-4 text-left text-lg font-semibold text-muted">Sign out</button>
          </form>
        </li>
      )}
      <li>
        <a lang="en" href="/privacy" class="flex items-center justify-between py-4 text-base text-muted">Privacy</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    toggle?.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
    toggle?.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // 정적 페이지: Supabase 세션 쿠키(sb-<프로젝트>-auth-token)가 있으면 'My page'로 바꿔 보여 준다.
  // 표시만 바꾸는 것이고, 실제 접근 권한은 서버(src/middleware.ts)가 확인한다.
  // 로그아웃 후 뒤로 가기로 캐시된 페이지가 다시 보일 때(bfcache)도 쿠키 기준으로 다시 맞춘다.
  const syncAuthLinks = () => {
    const signedIn = /(?:^|;\s*)sb-[^=]+-auth-token(?:\.0)?=/.test(document.cookie);
    document.querySelectorAll<HTMLElement>('[data-auth]').forEach((el) => (el.hidden = el.dataset.auth !== (signedIn ? 'in' : 'out')));
  };
  syncAuthLinks();
  window.addEventListener('pageshow', (e) => e.persisted && syncAuthLinks());

  // 설문 링크가 아직 TODO인 경우 이동을 막는다
  document.querySelectorAll('[data-pending-link]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      console.warn('[YEONON] Form link is not set yet — see src/config/site.ts');
    }),
  );
</script>
