---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import TravelerHeader from '../components/ui/TravelerHeader.astro';
import TabBar from '../components/ui/TabBar.astro';
import { isOnboarded } from '../lib/profile';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ko';
  /** 모바일 하단 고정 CTA 종류 ('none'이면 표시하지 않음) */
  sticky?: 'traveler' | 'jigi' | 'none';
  /** 로그인·회원 전용 페이지: 검색 노출 제외 */
  noindex?: boolean;
  /** 여행자 모바일 하단 탭바 (대화·루트 상세처럼 아래에 고정 입력창·예약 바가 있는 화면은 false) */
  tabBar?: boolean;
  /** 모바일 하단 고정 바(루트 상세 예약 바)가 있는 화면: 그 높이만큼 아래 여백 */
  bottomBar?: boolean;
}

const { title, description, lang = 'en', sticky = 'traveler', noindex = false, tabBar = true, bottomBar = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 공유 미리보기 이미지 1200×630 (public/images/og-image.png). 주소는 astro.config.mjs의 site 기준
const ogImage = new URL('/images/og-image.png', Astro.site);
// 여행자 영역(/app, /routes)과 디자인 확인 페이지(/dev/ui)는 새 디자인 시스템 "성수 라인"을 쓴다 (global.css .ui-traveler).
// /app-preview(랜딩의 앱 미리보기)는 여행자 영역이 아니다.
const travelerUi = /^\/(app|routes|dev\/ui)(\/|$)/.test(Astro.url.pathname);
// 로그인한 여행자의 /app·/routes: 여행자 헤더(데스크톱 메뉴) + 모바일 하단 탭바 (yeonon-traveler-ui-plan.md 5-8)
const me = Astro.locals.profile;
const travelerMember = travelerUi && !Astro.url.pathname.startsWith('/dev/') && me?.role === 'traveler' && me.status === 'active' && isOnboarded(me);
const showTabs = travelerMember && tabBar;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 안전장치: Supabase가 로그인 code를 /auth/callback이 아닌 페이지(주로 정적 홈)로 보냈을 때 콜백으로 넘긴다 -->
    <script is:inline>
      (function () {
        var code = new URLSearchParams(location.search).get('code');
        if (code && location.pathname !== '/auth/callback') location.replace('/auth/callback?code=' + encodeURIComponent(code));
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={travelerUi ? '#F1F3F2' : '#F5F8FD'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YEONON 연온" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="YEONON — Meet a local friend in Seoul who shares your taste." />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {travelerUi ? (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..700&display=swap"
      />
    ) : (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      />
    )}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body class:list={['min-h-dvh', travelerUi && 'ui-traveler', sticky !== 'none' && 'pb-[76px] md:pb-0', showTabs && 'pb-[calc(4rem+env(safe-area-inset-bottom))] md:pb-0', bottomBar && 'pb-[calc(5.5rem+env(safe-area-inset-bottom))] lg:pb-0']}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-surface focus:px-4 focus:py-2 focus:shadow"
    >
      {lang === 'ko' ? '본문으로 건너뛰기' : 'Skip to content'}
    </a>
    {travelerMember ? <TravelerHeader userId={me!.id} /> : <Header />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    {sticky !== 'none' && <StickyCTA variant={sticky} />}
    {showTabs && <TabBar />}
  </body>
</html>
