---
import '../styles/global.css';
import AppTopBar from '../components/ui/AppTopBar.astro';
import TabBar from '../components/ui/TabBar.astro';
import { inArea } from '../lib/profile';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ko';
  /** 로그인·회원 전용 페이지: 검색 노출 제외 */
  noindex?: boolean;
  /** 모바일 하단 탭바 (대화·루트 상세처럼 아래에 고정 입력창·예약 바가 있는 화면은 false) */
  tabBar?: boolean;
  /** 모바일 하단 고정 바(루트 상세 예약 바)가 있는 화면: 그 높이만큼 아래 여백 */
  bottomBar?: boolean;
}

const { title, description, lang = 'en', noindex = false, tabBar = true, bottomBar = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 공유 미리보기 이미지 1200×630 (public/images/og-image.png). 주소는 astro.config.mjs의 site 기준
const ogImage = new URL('/images/og-image.png', Astro.site);
// 여행자 화면(피드 /, 루트 상세, For you, 예약, 채팅, 내 정보)과 디자인 확인 페이지(/dev/ui)는 디자인 시스템 "성수 라인"을 쓴다 (global.css .ui-traveler).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const travelerUi = path === '/' || /^\/(routes|for-you|bookings|chats|me|dev\/ui)(\/|$)/.test(path);
// 모바일 하단 탭바 (yeonon-app-first-plan.md 5장): 여행자 화면은 누구에게나, 지기 화면(/partner/*)은 지기 계정에게만 (비로그인 시작 화면엔 없음)
const me = Astro.locals.profile;
const tabVariant = travelerUi && !path.startsWith('/dev/') ? 'traveler' : inArea(path, '/partner') && me?.role === 'jigi' ? 'jigi' : null;
const showTabs = Boolean(tabVariant) && tabBar;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 안전장치: Supabase가 로그인 code를 /auth/callback이 아닌 페이지(주로 정적 홈)로 보냈을 때 콜백으로 넘긴다 -->
    <script is:inline>
      (function () {
        var code = new URLSearchParams(location.search).get('code');
        if (code && location.pathname !== '/auth/callback') location.replace('/auth/callback?code=' + encodeURIComponent(code));
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={travelerUi ? '#F1F3F2' : '#F5F8FD'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YEONON 연온" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="YEONON — Meet a local friend in Seoul who shares your taste." />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {travelerUi ? (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..700&display=swap"
      />
    ) : (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      />
    )}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body class:list={['min-h-dvh', travelerUi && 'ui-traveler', showTabs && (tabVariant === 'jigi' ? 'pb-[calc(4rem+env(safe-area-inset-bottom))] md:pb-0' : 'pb-[calc(4rem+env(safe-area-inset-bottom))] lg:pb-0'), bottomBar && 'pb-[calc(5.5rem+env(safe-area-inset-bottom))] lg:pb-0']}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-surface focus:px-4 focus:py-2 focus:shadow"
    >
      {lang === 'ko' ? '본문으로 건너뛰기' : 'Skip to content'}
    </a>
    <AppTopBar />
    <main id="main">
      <slot />
    </main>
    {showTabs && <TabBar variant={tabVariant!} />}
  </body>
</html>
